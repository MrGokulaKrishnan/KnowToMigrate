{
  "hosting": {
    "public": "apps/website/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      {
        "source": "/download/KnowToMigrate-1.0.0-x64.msi",
        "destination": "https://github.com/MrGokulaKrishnan/KnowToMigrate/releases/download/v1.0.0/KnowToMigrate-1.0.0-x64.msi",
        "type": 302
      },
      {
        "source": "/download/KnowToMigrate-1.0.0-x64.exe",
        "destination": "https://github.com/MrGokulaKrishnan/KnowToMigrate/releases/download/v1.0.0/KnowToMigrate-1.0.0-x64.exe",
        "type": 302
      },
      {
        "source": "/download/KnowToMigrate-1.0.0.apk",
        "destination": "https://github.com/MrGokulaKrishnan/KnowToMigrate/releases/download/v1.0.0/KnowToMigrate-1.0.0.apk",
        "type": 302
      }
    ],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      {
        "source": "**/*.@(js|css|woff2|woff|ttf)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|svg|webp|ico|gif)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
      },
      {
        "source": "**",
        "headers": [
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
        ]
      }
    ]
  }
}
