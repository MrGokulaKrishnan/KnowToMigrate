{
  "hosting": {
    "public": "apps/website/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/download/KnowToMigrate-Setup.exe",
        "destination": "/download/KnowToMigrate-Setup.exe.bin"
      },
      {
        "source": "/download/KnowToMigrate-1.0.5-x64.msi",
        "destination": "/download/KnowToMigrate-1.0.5-x64.msi.bin"
      },
      {
        "source": "/download/KnowToMigrate-1.0.5-x64.exe",
        "destination": "/download/KnowToMigrate-1.0.5-x64.exe.bin"
      },
      {
        "source": "/download/KnowToMigrate-1.0.5.apk",
        "destination": "/download/KnowToMigrate-1.0.5.apk.bin"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|woff2|woff|ttf)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|svg|webp|ico|gif)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      },
      {
        "source": "/download/KnowToMigrate-Setup.exe*",
        "headers": [
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"KnowToMigrate-Setup.exe\""
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/download/KnowToMigrate-1.0.5-x64.msi*",
        "headers": [
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"KnowToMigrate-1.0.5-x64.msi\""
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/download/KnowToMigrate-1.0.5-x64.exe*",
        "headers": [
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"KnowToMigrate-1.0.5-x64.exe\""
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/download/KnowToMigrate-1.0.5.apk*",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/vnd.android.package-archive"
          },
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"KnowToMigrate-1.0.5.apk\""
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/update-manifest.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/updates/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
