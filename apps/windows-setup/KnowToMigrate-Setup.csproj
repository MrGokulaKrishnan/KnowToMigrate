<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KnowToMigrate.Setup</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <NoWarn>$(NoWarn);CA1416;CS8618</NoWarn>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>..\windows-wpf\Assets\KnowToMigrate.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>KnowToMigrate-Setup</AssemblyName>
    <Product>KnowToMigrate Setup</Product>
    <Company>KnowTheTech</Company>
    <Description>KnowToMigrate Setup Installer</Description>
    <AssemblyTitle>KnowToMigrate Setup</AssemblyTitle>
    <AssemblyProduct>KnowToMigrate</AssemblyProduct>
    <AssemblyCompany>KnowTheTech</AssemblyCompany>
    <AssemblyDescription>KnowToMigrate Windows Installer</AssemblyDescription>
    <AssemblyVersion>1.0.5.0</AssemblyVersion>
    <FileVersion>1.0.5.0</FileVersion>
    <InformationalVersion>1.0.5</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="App.xaml.cs;MainWindow.xaml.cs" />
    <ApplicationDefinition Remove="App.xaml" />
    <Page Remove="MainWindow.xaml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\windows-wpf\Assets\KnowToMigrate.ico" LogicalName="Assets.KnowToMigrate.ico" />
    <EmbeddedResource Include="..\windows-wpf\Assets\logo.jpg" LogicalName="Assets.logo.jpg" />
    <EmbeddedResource Include="..\..\releases\windows\publish\KnowToMigrate.exe" LogicalName="Payload.KnowToMigrate.exe" />
  </ItemGroup>

</Project>
