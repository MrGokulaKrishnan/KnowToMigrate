<Window x:Class="KnowToMigrate.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KnowToMigrate Setup"
        Height="480" Width="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="0" CornerRadius="16" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Background="#0C0C0C" BorderBrush="#33FF5A00" BorderThickness="1.5" CornerRadius="16" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#FF5A00" BlurRadius="28" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="#111111" CornerRadius="15,15,0,0" BorderBrush="#1C1C1C" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Border CornerRadius="4" Width="18" Height="18" Background="#FF5A00" Margin="0,0,8,0">
                            <Path Data="M13,2 L3,14 L12,14 L11,22 L21,10 L12,10 Z" Fill="#FFFFFF" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="KnowToMigrate Setup" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="1" Click="BtnClose_Click" WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="42" Height="41" Background="Transparent" BorderThickness="0" Foreground="#888888" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="#888888" StrokeThickness="1.2" Width="9" Height="9" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E81123" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1" Margin="28,20,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header: Logo + App Name + Tagline -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="64" Height="64" CornerRadius="14" Background="#000000" BorderBrush="#FF5A00" BorderThickness="1.5" Margin="0,0,16,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#FF5A00" BlurRadius="16" ShadowDepth="0" Opacity="0.4"/>
                        </Border.Effect>
                        <Path Data="M13,2 L3,14 L12,14 L11,22 L21,10 L12,10 Z" Fill="#FF8A00" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="KnowToMigrate" Foreground="#FFFFFF" FontWeight="ExtraBold" FontSize="22" />
                        <TextBlock Text="Move Anything. Anywhere. Seamlessly." Foreground="#FF8A00" FontWeight="SemiBold" FontSize="12" Margin="0,2,0,0" />
                        <TextBlock Text="Production Release · Version 1.0.0 (x64)" Foreground="#777777" FontSize="11" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Installation Folder -->
                <Border Grid.Row="1" Background="#141414" BorderBrush="#222222" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Installation Destination" Foreground="#888888" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="C:\Program Files\KnowToMigrate" Foreground="#DDDDDD" FontSize="13" FontWeight="Bold" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <!-- Shortcut Options -->
                <StackPanel Grid.Row="2" Margin="0,0,0,16">
                    <CheckBox x:Name="ChkStartMenu" Content="Add shortcut to Start Menu (KnowToMigrate)" Foreground="#FFFFFF" FontSize="12" IsChecked="True" IsEnabled="False" Margin="0,0,0,8" />
                    <CheckBox x:Name="ChkDesktop" Content="Create Desktop shortcut" Foreground="#FFFFFF" FontSize="12" IsChecked="True" Margin="0,0,0,8" />
                    <CheckBox x:Name="ChkLaunch" Content="Launch KnowToMigrate after installation" Foreground="#FFFFFF" FontSize="12" IsChecked="True" />
                </StackPanel>

                <!-- Progress and Status -->
                <StackPanel Grid.Row="3" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatus" Text="Ready to install" Foreground="#888888" FontSize="12" Margin="0,0,0,6" />
                    <Border CornerRadius="3" ClipToBounds="True" Height="6" Background="#1C1C1C">
                        <ProgressBar x:Name="ProgressBarInstall" Minimum="0" Maximum="100" Value="0" Background="#1C1C1C" Foreground="#FF5A00" BorderThickness="0" />
                    </Border>
                </StackPanel>

                <!-- Action Buttons -->
                <Grid Grid.Row="4" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtResult" Grid.Column="0" VerticalAlignment="Center" Foreground="#22C55E" FontWeight="Bold" FontSize="12" Visibility="Collapsed" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="BtnCancel" Content="Cancel" Click="BtnCancel_Click" Width="90" Height="36" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" Foreground="#CCCCCC" FontSize="12" Margin="0,0,10,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="BtnInstall" Content="Install Now" Click="BtnInstall_Click" Width="120" Height="36" Background="#FF5A00" BorderThickness="0" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
