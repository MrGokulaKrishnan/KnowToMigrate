<Window x:Class="KnowToMigrate.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KnowToMigrate Setup &amp; Management"
        Height="500" Width="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="0" CornerRadius="16" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Background="#0C0C0C" BorderBrush="#334ADE80" BorderThickness="1.5" CornerRadius="16" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#4ADE80" BlurRadius="24" ShadowDepth="0" Opacity="0.25"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="#111111" CornerRadius="15,15,0,0" BorderBrush="#1C1C1C" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Border CornerRadius="5" Width="20" Height="20" Background="#4ADE80" Margin="0,0,8,0">
                            <Path Data="M13,2 L3,14 L12,14 L11,22 L21,10 L12,10 Z" Fill="#000000" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="KnowToMigrate" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text=" · Setup &amp; Management" Foreground="#4ADE80" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1" Click="BtnClose_Click" WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="42" Height="41" Background="Transparent" BorderThickness="0" Foreground="#888888" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="#888888" StrokeThickness="1.2" Width="9" Height="9" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E81123" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1" Margin="28,20,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header: Logo + App Name + Tagline -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="60" Height="60" CornerRadius="14" Background="#141414" BorderBrush="#4ADE80" BorderThickness="1.5" Margin="0,0,16,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#4ADE80" BlurRadius="16" ShadowDepth="0" Opacity="0.3"/>
                        </Border.Effect>
                        <Path Data="M13,2 L3,14 L12,14 L11,22 L21,10 L12,10 Z" Fill="#4ADE80" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtHeaderTitle" Text="KnowToMigrate" Foreground="#FFFFFF" FontWeight="ExtraBold" FontSize="20" />
                        <TextBlock x:Name="TxtHeaderSubtitle" Text="Move Anything. Anywhere. Seamlessly." Foreground="#4ADE80" FontWeight="SemiBold" FontSize="12" Margin="0,2,0,0" />
                        <TextBlock Text="Production Release · v1.0.6 (x64)" Foreground="#777777" FontSize="11" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Center Content Area: Switched by State -->
                <Grid Grid.Row="1">
                    <!-- 1. Normal Setup Mode -->
                    <StackPanel x:Name="PnlSetupMode" Visibility="Visible">
                        <!-- Installation Folder -->
                        <Border Background="#141414" BorderBrush="#222222" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Installation Destination" Foreground="#888888" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="C:\Program Files\KnowToMigrate" Foreground="#DDDDDD" FontSize="13" FontWeight="Bold" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Shortcut Options -->
                        <Border Background="#121214" BorderBrush="#1F1F24" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Preferences &amp; Shortcuts" Foreground="#888888" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <CheckBox x:Name="ChkStartMenu" Content="Add shortcut to Start Menu" Foreground="#FFFFFF" FontSize="12" IsChecked="True" Margin="0,0,0,8" />
                                <CheckBox x:Name="ChkDesktop" Content="Create Desktop shortcut" Foreground="#FFFFFF" FontSize="12" IsChecked="True" Margin="0,0,0,8" />
                                <CheckBox x:Name="ChkLaunch" Content="Launch KnowToMigrate after installation" Foreground="#FFFFFF" FontSize="12" IsChecked="True" />
                            </StackPanel>
                        </Border>

                        <!-- Progress Section -->
                        <StackPanel x:Name="PnlProgress" Margin="0,4,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="TxtStatus" Text="Ready to install" Foreground="#A1A1AA" FontSize="12" Margin="0,0,0,6" />
                            <Border CornerRadius="4" ClipToBounds="True" Height="7" Background="#1C1C1C">
                                <ProgressBar x:Name="ProgressBarInstall" Minimum="0" Maximum="100" Value="0" Background="#1C1C1C" Foreground="#4ADE80" BorderThickness="0" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- 2. Installation Complete Screen (NEVER CLOSES ABRUPTLY) -->
                    <Border x:Name="PnlFinish" Background="#141416" BorderBrush="#27272A" BorderThickness="1" CornerRadius="14" Padding="18,16" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center">
                            <Grid HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Border Width="48" Height="48" CornerRadius="24" Background="#1A3324" BorderBrush="#4ADE80" BorderThickness="1.5">
                                    <Path Data="M4,10 L8,14 L16,5" Stroke="#4ADE80" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <TextBlock Text="Installation Completed Successfully!" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" />
                            <TextBlock Text="KnowToMigrate is installed and ready to use on this computer." Foreground="#9CA3AF" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,16" />

                            <Border Background="#1C1C20" BorderBrush="#2C2C32" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                <StackPanel>
                                    <CheckBox x:Name="ChkRunNow" Content="Run KnowToMigrate now" Foreground="#4ADE80" FontWeight="Bold" FontSize="12" IsChecked="True" Margin="0,0,0,8" />
                                    <CheckBox x:Name="ChkEnsureDesktop" Content="Ensure Desktop shortcut is created" Foreground="#E4E4E7" FontSize="12" IsChecked="True" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 3. Uninstallation Screen -->
                    <Border x:Name="PnlUninstall" Background="#141416" BorderBrush="#3B1C1C" BorderThickness="1" CornerRadius="14" Padding="18,16" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center">
                            <Grid HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Border Width="48" Height="48" CornerRadius="24" Background="#331A1A" BorderBrush="#EF4444" BorderThickness="1.5">
                                    <TextBlock Text="!" Foreground="#EF4444" FontWeight="Bold" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <TextBlock Text="Uninstall KnowToMigrate" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" />
                            <TextBlock Text="Are you sure you want to completely remove KnowToMigrate from your computer?" Foreground="#9CA3AF" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,16" TextAlignment="Center" TextWrapping="Wrap" />

                            <Border Background="#1C1C20" BorderBrush="#2C2C32" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                <StackPanel>
                                    <CheckBox x:Name="ChkRemoveConfig" Content="Remove local transfer caches and configuration" Foreground="#E4E4E7" FontSize="12" IsChecked="True" Margin="0,0,0,6" />
                                    <CheckBox x:Name="ChkRemoveAllShortcuts" Content="Remove all Desktop and Start Menu shortcuts" Foreground="#E4E4E7" FontSize="12" IsChecked="True" IsEnabled="False" />
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="PnlUninstallProgress" Margin="0,14,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="TxtUninstallStatus" Text="Removing files..." Foreground="#A1A1AA" FontSize="12" Margin="0,0,0,6" />
                                <Border CornerRadius="4" ClipToBounds="True" Height="7" Background="#1C1C1C">
                                    <ProgressBar x:Name="ProgressBarUninstall" Minimum="0" Maximum="100" Value="0" Background="#1C1C1C" Foreground="#EF4444" BorderThickness="0" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Action Buttons -->
                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnSwitchUninstall" Content="Uninstall Application" Click="BtnSwitchUninstall_Click" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="#EF4444" FontSize="11" Cursor="Hand" HorizontalAlignment="Left" Visibility="Collapsed">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#F87171" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="BtnCancel" Content="Cancel" Click="BtnCancel_Click" Width="90" Height="36" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" Foreground="#CCCCCC" FontSize="12" Margin="0,0,10,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="BtnInstall" Content="Install Now" Click="BtnInstall_Click" Width="130" Height="36" Background="#4ADE80" BorderThickness="0" Foreground="#000000" FontWeight="Bold" FontSize="12" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
