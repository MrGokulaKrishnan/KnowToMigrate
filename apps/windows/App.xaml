<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="KnowToMigrate.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="KmBlack" Color="#000000" />
            <SolidColorBrush x:Key="KmOrange" Color="#FF5A00" />
            <SolidColorBrush x:Key="KmSurface" Color="#0C0C0C" />
            <SolidColorBrush x:Key="KmBorder" Color="#1A1A1A" />
            <SolidColorBrush x:Key="KmTextPrimary" Color="#FFFFFF" />
            <SolidColorBrush x:Key="KmTextSecondary" Color="#D4D4D4" />
            <SolidColorBrush x:Key="KmTextMuted" Color="#8A8A8A" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
