<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KnowToMigrate.Views.MigrationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#000000">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32" Spacing="28">

            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="PC Migration Wizard"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#FFFFFF" />
                <TextBlock Text="Transfer your data to a new PC in a few steps"
                           FontSize="14"
                           Foreground="#8A8A8A" />
            </StackPanel>

            <!-- Step indicator -->
            <Border CornerRadius="14"
                    Background="#0C0C0C"
                    BorderBrush="#1A1A1A"
                    BorderThickness="1"
                    Padding="24,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StepLabel"
                                   Text="Step 1 of 4 — Select Categories"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF" />
                        <TextBlock x:Name="StepCounterText"
                                   Grid.Column="1"
                                   Text="1 / 4"
                                   Foreground="#8A8A8A"
                                   FontSize="14" />
                    </Grid>

                    <!-- Progress bar -->
                    <Grid Height="6" Margin="0,10,0,0">
                        <Rectangle Fill="#1A1A1A" RadiusX="3" RadiusY="3" />
                        <Rectangle x:Name="StepFill"
                                   Fill="#FF5A00"
                                   RadiusX="3" RadiusY="3"
                                   HorizontalAlignment="Left"
                                   Width="0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Step 1: Categories -->
            <StackPanel x:Name="StepCategories" Spacing="16">
                <TextBlock Text="What do you want to migrate?"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFF" />

                <Border CornerRadius="14"
                        Background="#0C0C0C"
                        BorderBrush="#1A1A1A"
                        BorderThickness="1"
                        Padding="20">
                    <StackPanel Spacing="14">
                        <CheckBox x:Name="ChkPhotos"   Content="📷  Photos"    IsChecked="True"  Foreground="#FFFFFF" FontSize="14" />
                        <CheckBox x:Name="ChkVideos"   Content="🎬  Videos"    IsChecked="True"  Foreground="#FFFFFF" FontSize="14" />
                        <CheckBox x:Name="ChkDocuments" Content="📄  Documents" IsChecked="True"  Foreground="#FFFFFF" FontSize="14" />
                        <CheckBox x:Name="ChkMusic"    Content="🎵  Music"     IsChecked="False" Foreground="#FFFFFF" FontSize="14" />
                        <CheckBox x:Name="ChkDownloads" Content="⬇  Downloads" IsChecked="False" Foreground="#FFFFFF" FontSize="14" />
                        <CheckBox x:Name="ChkDesktop"  Content="🖥  Desktop"   IsChecked="True"  Foreground="#FFFFFF" FontSize="14" />
                        <CheckBox x:Name="ChkBrowser"  Content="🌐  Browser Bookmarks &amp; Passwords" IsChecked="True" Foreground="#FFFFFF" FontSize="14" />
                        <CheckBox x:Name="ChkApps"     Content="📦  Installed App List"               IsChecked="False" Foreground="#FFFFFF" FontSize="14" />
                        <CheckBox x:Name="ChkNetwork"  Content="📡  Network Profiles &amp; Printers"  IsChecked="False" Foreground="#FFFFFF" FontSize="14" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Storage preflight -->
            <Border x:Name="StoragePreflight"
                    CornerRadius="14"
                    Background="#0D1A0D"
                    BorderBrush="#4CAF50"
                    BorderThickness="1"
                    Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE9F5;" FontSize="28" Foreground="#4CAF50" Margin="0,0,16,0" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="Storage Check"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   FontSize="14" />
                        <TextBlock x:Name="StorageText"
                                   Text="Scanning selected categories…"
                                   Foreground="#D4D4D4"
                                   FontSize="13" />
                        <ProgressBar x:Name="ScanProgress"
                                     IsIndeterminate="True"
                                     Foreground="#4CAF50"
                                     Height="4"
                                     Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Warning card for low space -->
            <Border x:Name="SpaceWarning"
                    CornerRadius="14"
                    Background="#2A1200"
                    BorderBrush="#FF8C00"
                    BorderThickness="1"
                    Padding="20"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE7BA;" FontSize="22" Foreground="#FF8C00" />
                    <TextBlock Text="Target device may not have enough free space. Check available storage before proceeding."
                               Foreground="#FFB347"
                               FontSize="13"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Start button -->
            <Button x:Name="BtnStartMigration"
                    Content="Start Migration →"
                    Click="BtnStartMigration_Click"
                    HorizontalAlignment="Stretch"
                    CornerRadius="14"
                    Background="#FF5A00"
                    Foreground="White"
                    BorderThickness="0"
                    Padding="0,18"
                    FontSize="16"
                    FontWeight="SemiBold" />

        </StackPanel>
    </ScrollViewer>
</Page>
