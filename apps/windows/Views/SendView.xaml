<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KnowToMigrate.Views.SendView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#000000">

    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Spacing="4">
            <TextBlock Text="Send Files"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#FFFFFF" />
            <TextBlock Text="Choose a device and confirm files to send"
                       FontSize="14"
                       Foreground="#8A8A8A" />
        </StackPanel>

        <!-- Content area: two columns -->
        <Grid Grid.Row="1" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Device selector -->
            <StackPanel Spacing="12">
                <TextBlock Text="Target Device"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#D4D4D4" />

                <ListView x:Name="DeviceSelector"
                          ItemsSource="{x:Bind Devices}"
                          SelectionMode="Single"
                          SelectionChanged="DeviceSelector_SelectionChanged"
                          Background="Transparent"
                          MaxHeight="340">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12"
                                    Background="#0C0C0C"
                                    BorderBrush="#1A1A1A"
                                    BorderThickness="1"
                                    Padding="14,12"
                                    Margin="0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36"
                                            CornerRadius="9"
                                            Background="#1A1A1A"
                                            Margin="0,0,12,0">
                                        <FontIcon Glyph="&#xE770;" FontSize="18" Foreground="#FF5A00" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFFFFF"
                                                   FontSize="13" />
                                        <TextBlock Text="{Binding Ip}"
                                                   Foreground="#8A8A8A"
                                                   FontSize="11" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="NoDeviceWarning"
                           Text="⚠  No device selected."
                           Foreground="#FF8C00"
                           FontSize="13"
                           Visibility="Collapsed" />
            </StackPanel>

            <!-- Right: File list -->
            <StackPanel Grid.Column="2" Spacing="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Files to Send"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#D4D4D4"
                               VerticalAlignment="Center" />
                    <Button x:Name="BtnAddMore"
                            Grid.Column="1"
                            Content="+ Add"
                            Click="BtnAddMore_Click"
                            CornerRadius="8"
                            Background="Transparent"
                            Foreground="#FF5A00"
                            BorderBrush="#FF5A00"
                            BorderThickness="1"
                            Padding="12,5" />
                </Grid>

                <ListView x:Name="FileList"
                          ItemsSource="{x:Bind SelectedPaths}"
                          SelectionMode="None"
                          Background="Transparent"
                          MaxHeight="300">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10"
                                    Background="#0C0C0C"
                                    BorderBrush="#1A1A1A"
                                    BorderThickness="1"
                                    Padding="14,10"
                                    Margin="0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8A5;"
                                              FontSize="16"
                                              Foreground="#8A8A8A"
                                              Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding}"
                                               Foreground="#D4D4D4"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="TotalSizeText"
                           Text="Total: calculating…"
                           Foreground="#8A8A8A"
                           FontSize="12" />
            </StackPanel>
        </Grid>

        <!-- Footer: Send button -->
        <Border Grid.Row="2"
                Background="#0A0A0A"
                CornerRadius="14"
                Padding="20,16"
                Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SendSummary"
                               Text="Ready to send"
                               Foreground="#D4D4D4"
                               FontSize="14"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="SendSubtitle"
                               Text="Select a device to proceed"
                               Foreground="#8A8A8A"
                               FontSize="12" />
                </StackPanel>

                <Button x:Name="BtnSend"
                        Grid.Column="1"
                        Content="Send Now →"
                        Click="BtnSend_Click"
                        IsEnabled="False"
                        CornerRadius="12"
                        Background="#FF5A00"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="28,14"
                        FontWeight="SemiBold"
                        FontSize="15" />
            </Grid>
        </Border>
    </Grid>
</Page>
