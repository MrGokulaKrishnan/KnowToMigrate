<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KnowToMigrate.Views.TransferView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#000000">

    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Spacing="4">
            <TextBlock Text="Transfer in Progress"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#FFFFFF" />
            <TextBlock x:Name="DeviceNameText"
                       Text="Sending to …"
                       FontSize="14"
                       Foreground="#8A8A8A" />
        </StackPanel>

        <!-- Central progress card -->
        <Border Grid.Row="1"
                CornerRadius="20"
                Background="#0C0C0C"
                BorderBrush="#1A1A1A"
                BorderThickness="1"
                Padding="36"
                Margin="0,32">
            <StackPanel Spacing="28" VerticalAlignment="Center">

                <!-- File name -->
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE8A5;"
                              FontSize="40"
                              Foreground="#FF5A00" />
                    <TextBlock x:Name="CurrentFileName"
                               Text="Preparing…"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center"
                               MaxWidth="480" />
                </StackPanel>

                <!-- Progress bar -->
                <StackPanel Spacing="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ProgressLabel"
                                   Text="0 %"
                                   Foreground="#D4D4D4"
                                   FontWeight="SemiBold"
                                   FontSize="14" />
                        <TextBlock x:Name="SentBytesLabel"
                                   Grid.Column="1"
                                   Text="0 B / 0 B"
                                   Foreground="#8A8A8A"
                                   FontSize="13" />
                    </Grid>

                    <!-- Custom orange progress bar -->
                    <Grid Height="10">
                        <Rectangle Fill="#1A1A1A" RadiusX="5" RadiusY="5" />
                        <Rectangle x:Name="ProgressFill"
                                   Fill="#FF5A00"
                                   RadiusX="5" RadiusY="5"
                                   HorizontalAlignment="Left"
                                   Width="0" />
                    </Grid>
                </StackPanel>

                <!-- Stats row -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="40">
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <TextBlock x:Name="SpeedText"
                                   Text="— MB/s"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#FF5A00"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Speed"
                                   FontSize="12"
                                   Foreground="#8A8A8A"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <TextBlock x:Name="EtaText"
                                   Text="—:——"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="ETA"
                                   FontSize="12"
                                   Foreground="#8A8A8A"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <TextBlock x:Name="FilesCountText"
                                   Text="0 / 0"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Files"
                                   FontSize="12"
                                   Foreground="#8A8A8A"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Status badge -->
                <Border x:Name="StatusBadge"
                        CornerRadius="10"
                        Padding="16,8"
                        HorizontalAlignment="Center"
                        Background="#1A2F1A">
                    <TextBlock x:Name="StatusText"
                               Text="Connecting…"
                               Foreground="#4CAF50"
                               FontWeight="SemiBold"
                               FontSize="13" />
                </Border>

            </StackPanel>
        </Border>

        <!-- Footer: Pause / Cancel -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="16">
            <Button x:Name="BtnPause"
                    Content="⏸  Pause"
                    Click="BtnPause_Click"
                    CornerRadius="12"
                    Background="#1A1A1A"
                    Foreground="#D4D4D4"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    Padding="32,14"
                    FontSize="14" />
            <Button x:Name="BtnCancel"
                    Content="✕  Cancel"
                    Click="BtnCancel_Click"
                    CornerRadius="12"
                    Background="#2A0000"
                    Foreground="#FF4444"
                    BorderBrush="#FF4444"
                    BorderThickness="1"
                    Padding="32,14"
                    FontSize="14" />
        </StackPanel>
    </Grid>
</Page>
