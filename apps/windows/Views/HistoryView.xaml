<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KnowToMigrate.Views.HistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#000000">

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Margin="0,0,0,24">
            <TextBlock Text="Transfer History" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Transfer List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="TransferList" Spacing="8">
                <!-- Items populated from code-behind -->
                <Border Background="#0A0A0A" CornerRadius="14" Padding="16" BorderBrush="#1A1A1A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Direction Icon -->
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12" Background="#26FF5A00">
                            <TextBlock Text="↑" FontSize="18" FontWeight="Bold" Foreground="#FF5A00" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <!-- Info -->
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Project_Assets.zip" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            <TextBlock Text="Krish's Laptop · 4.2 GB" FontSize="12" Foreground="#8A8A8A" />
                            <TextBlock Text="Today, 14:32" FontSize="11" Foreground="#555555" />
                        </StackPanel>
                        <!-- Status -->
                        <Border Grid.Column="2" CornerRadius="8" Padding="8,4" Background="#1F22C55E" VerticalAlignment="Center">
                            <TextBlock Text="Complete" FontSize="11" FontWeight="SemiBold" Foreground="#22C55E" />
                        </Border>
                    </Grid>
                </Border>

                <Border Background="#0A0A0A" CornerRadius="14" Padding="16" BorderBrush="#1A1A1A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12" Background="#26FF5A00">
                            <TextBlock Text="↓" FontSize="18" FontWeight="Bold" Foreground="#FF5A00" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="DCIM Photos" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            <TextBlock Text="Krish's Phone · 1.8 GB" FontSize="12" Foreground="#8A8A8A" />
                            <TextBlock Text="Today, 11:15" FontSize="11" Foreground="#555555" />
                        </StackPanel>
                        <Border Grid.Column="2" CornerRadius="8" Padding="8,4" Background="#1F22C55E" VerticalAlignment="Center">
                            <TextBlock Text="Complete" FontSize="11" FontWeight="SemiBold" Foreground="#22C55E" />
                        </Border>
                    </Grid>
                </Border>

                <Border Background="#0A0A0A" CornerRadius="14" Padding="16" BorderBrush="#1A1A1A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12" Background="#1FEF4444">
                            <TextBlock Text="↑" FontSize="18" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Video_4K.mp4" FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            <TextBlock Text="Home PC · 12.4 GB" FontSize="12" Foreground="#8A8A8A" />
                            <TextBlock Text="Yesterday, 09:12" FontSize="11" Foreground="#555555" />
                        </StackPanel>
                        <Border Grid.Column="2" CornerRadius="8" Padding="8,4" Background="#1FEF4444" VerticalAlignment="Center">
                            <TextBlock Text="Failed" FontSize="11" FontWeight="SemiBold" Foreground="#EF4444" />
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
