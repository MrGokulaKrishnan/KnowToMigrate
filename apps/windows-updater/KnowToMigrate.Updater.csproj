<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ApplicationIcon>..\windows-wpf\Assets\KnowToMigrate.ico</ApplicationIcon>
    <AssemblyName>KnowToMigrate.Updater</AssemblyName>
    <Product>KnowToMigrate Updater</Product>
    <Company>KnowToMigrate</Company>
    <Description>KnowToMigrate Standalone Secure Updater</Description>
    <AssemblyTitle>KnowToMigrate Updater</AssemblyTitle>
    <AssemblyProduct>KnowToMigrate</AssemblyProduct>
    <AssemblyCompany>KnowToMigrate</AssemblyCompany>
    <AssemblyDescription>KnowToMigrate Standalone Secure Updater</AssemblyDescription>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\windows-wpf\Assets\KnowToMigrate.ico" />
    <Resource Include="..\windows-wpf\Assets\logo.jpg" />
  </ItemGroup>

</Project>
