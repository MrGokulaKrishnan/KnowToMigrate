<Application x:Class="KnowToMigrate.Updater.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="Application_Startup">
    <Application.Resources>
        <SolidColorBrush x:Key="KmBlack" Color="#000000" />
        <SolidColorBrush x:Key="KmOrange" Color="#FF5A00" />
        <SolidColorBrush x:Key="KmOrangeLight" Color="#FF8A00" />
        <SolidColorBrush x:Key="KmTextPrimary" Color="#FFFFFF" />
        <SolidColorBrush x:Key="KmTextSecondary" Color="#D4D4D4" />
        <SolidColorBrush x:Key="KmTextMuted" Color="#8A8A8A" />
    </Application.Resources>
</Application>
