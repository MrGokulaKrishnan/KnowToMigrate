<Window x:Class="KnowToMigrate.Views.IncomingTransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KnowToMigrate — Incoming Transfer"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Topmost="False"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <!-- Outermost container with drop shadow & smooth scale/fade transform -->
    <Grid Margin="32">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="WindowScale" ScaleX="0.96" ScaleY="0.96" CenterX="230" CenterY="270" />
            </TransformGroup>
        </Grid.RenderTransform>

        <!-- Centered Glass Card (15% Corner Radius = 24 on 460px width) -->
        <Border Width="460" Background="#0C0C0C" BorderBrush="#FF5A00" BorderThickness="1.5" CornerRadius="24" Padding="28" SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect Color="#FF5A00" BlurRadius="42" ShadowDepth="0" Opacity="0.45"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Top Brand Header, Queue Indicator & Close Button -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Approved KnowToMigrate Logo in 15% Corner Radius Container -->
                        <Border CornerRadius="5" Width="24" Height="24" Background="#000000" BorderBrush="#FF5A00" BorderThickness="1" Margin="0,0,8,0" SnapsToDevicePixels="True" ClipToBounds="True">
                            <Image x:Name="ImgHeaderLogo" Source="/Assets/logo.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="KnowToMigrate" Foreground="#FF8A00" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                        
                        <!-- Queue Badge (visible when multiple requests pending) -->
                        <Border x:Name="BadgeQueue" Visibility="Collapsed" Background="#1A0D00" BorderBrush="#FF5A00" BorderThickness="1" CornerRadius="8" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtQueueCount" Text="2 Pending" Foreground="#FF8A00" FontSize="10" FontWeight="Bold" />
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="1" Click="BtnDecline_Click" Style="{StaticResource KmGlassButton}" Width="30" Height="30" Padding="0" ToolTip="Decline">
                        <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" Fill="#888888" Width="12" Height="12" Stretch="Uniform" />
                    </Button>
                </Grid>

                <!-- Row 1: Title -->
                <TextBlock Grid.Row="1" Text="Incoming Transfer" Foreground="#FFFFFF" FontWeight="ExtraBold" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,18" />

                <!-- Row 2: Device Icon & Identification -->
                <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,18">
                    <Border Width="72" Height="72" CornerRadius="36" Background="#1A0D00" BorderBrush="#FF5A00" BorderThickness="2" HorizontalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="#FF5A00" BlurRadius="22" ShadowDepth="0" Opacity="0.5"/>
                        </Border.Effect>
                        <Path x:Name="PathDeviceIcon" Data="M17 1H7c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-2-2-2zm0 18H7V5h10v14z" Fill="#FF8A00" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="TxtDeviceName" Text="Galaxy S24 Ultra" Foreground="#FFFFFF" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Margin="0,12,0,4" />
                    <Border Background="#141414" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="6" Padding="8,2" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtPlatform" Text="Android" Foreground="#888888" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock Text="Wants to send files to this PC" Foreground="#AAAAAA" FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>

                <!-- Row 3: Connection & Transport Details -->
                <Border Grid.Row="3" Background="#111111" BorderBrush="#222222" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="8" Height="8" Fill="#22C55E" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtTransport" Grid.Column="1" Text="● Wi-Fi LAN · Verified Connection" Foreground="#DDDDDD" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Row 4: Security Code (Authentication PIN) -->
                <Border Grid.Row="4" Background="#140A00" BorderBrush="#FF5A00" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,24">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="SECURITY CODE" Foreground="#888888" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4" />
                        <TextBlock x:Name="TxtPin" Text="437 254" Foreground="#FF8A00" FontSize="24" FontWeight="ExtraBold" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Row 5: Action Buttons (Decline / Accept Transfer) -->
                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.4*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Decline" Click="BtnDecline_Click" Style="{StaticResource KmGlassButton}" MinHeight="44" Padding="16,10" Margin="0,0,8,0" Foreground="#FF5555" BorderBrush="#442222" FontSize="13" />
                    <Button Grid.Column="1" Content="Accept Transfer" Click="BtnAccept_Click" Style="{StaticResource KmPrimaryButton}" MinHeight="44" Padding="20,10" Margin="8,0,0,0" FontSize="13" FontWeight="Bold" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
