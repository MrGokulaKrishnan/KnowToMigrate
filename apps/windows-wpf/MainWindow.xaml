<Window x:Class="KnowToMigrate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KnowToMigrate"
        Icon="Assets/KnowToMigrate.ico"
        Width="1040" Height="660"
        MinWidth="960" MinHeight="580"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#000000"
        Foreground="#F5F5F5"
        StateChanged="MainWindow_StateChanged">

    <!-- Native Windows 11 Chrome with full hardware acceleration -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Storyboard for animated pulsing radar rings on Receive screen -->
        <Storyboard x:Key="RadarPulseAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="RadarRing1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.25" To="1.0" Duration="0:0:2.6" />
            <DoubleAnimation Storyboard.TargetName="RadarRing1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.25" To="1.0" Duration="0:0:2.6" />
            <DoubleAnimation Storyboard.TargetName="RadarRing1" Storyboard.TargetProperty="Opacity" From="0.9" To="0.0" Duration="0:0:2.6" />

            <DoubleAnimation Storyboard.TargetName="RadarRing2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.25" To="1.0" Duration="0:0:2.6" BeginTime="0:0:0.87" />
            <DoubleAnimation Storyboard.TargetName="RadarRing2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.25" To="1.0" Duration="0:0:2.6" BeginTime="0:0:0.87" />
            <DoubleAnimation Storyboard.TargetName="RadarRing2" Storyboard.TargetProperty="Opacity" From="0.9" To="0.0" Duration="0:0:2.6" BeginTime="0:0:0.87" />

            <DoubleAnimation Storyboard.TargetName="RadarRing3" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.25" To="1.0" Duration="0:0:2.6" BeginTime="0:0:1.73" />
            <DoubleAnimation Storyboard.TargetName="RadarRing3" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.25" To="1.0" Duration="0:0:2.6" BeginTime="0:0:1.73" />
            <DoubleAnimation Storyboard.TargetName="RadarRing3" Storyboard.TargetProperty="Opacity" From="0.9" To="0.0" Duration="0:0:2.6" BeginTime="0:0:1.73" />
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource RadarPulseAnimation}" />
        </EventTrigger>
    </Window.Triggers>

    <!-- Window Shell with dark AMOLED gradient background and border -->
    <Border x:Name="RootBorder" BorderBrush="#1E1E1E" BorderThickness="1" SnapsToDevicePixels="True" CornerRadius="20">
        <Border.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#0D0D0D" Offset="0"/>
                <GradientStop Color="#040404" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ── Top Title Bar ──────────────────────────────────────── -->
            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="KnowToMigrate" Foreground="#8C8C8C" FontSize="12"
                               VerticalAlignment="Center" Margin="16,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True" />

                    <!-- Center Drag Zone -->
                    <Grid Grid.Column="1" Background="Transparent" />

                    <!-- Window Control Buttons (Minimize, Maximize/Restore, Close) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="BtnMinimize" Click="BtnMinimize_Click" Style="{StaticResource KmTitleBarButton}" ToolTip="Minimize">
                            <Path Data="M0,0 L10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="10" Height="2" Stretch="None" />
                        </Button>
                        <Button x:Name="BtnMaximize" Click="BtnMaximize_Click" Style="{StaticResource KmTitleBarButton}" ToolTip="Maximize">
                            <Path x:Name="MaximizePath" Data="M0,0 H10 V10 H0 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Fill="Transparent" Width="10" Height="10" Stretch="None" />
                        </Button>
                        <Button x:Name="BtnClose" Click="BtnClose_Click" Style="{StaticResource KmTitleBarCloseButton}" ToolTip="Close">
                            <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Width="9" Height="9" Stretch="None" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── App Body ──────────────────────────────────────────── -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Floating Glass Navigation Rail (Expandable on hover or pin) -->
                <Border x:Name="NavRailBorder" Grid.Column="0" Width="72" Margin="12,6,12,14" CornerRadius="24"
                        Background="#09FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                        VerticalAlignment="Stretch"
                        MouseEnter="NavRail_MouseEnter" MouseLeave="NavRail_MouseLeave">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="8" Opacity="0.5" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Top Monogram / Pin Toggle -->
                        <Border Grid.Row="0" Margin="0,14,0,10" HorizontalAlignment="Center">
                            <Button x:Name="BtnToggleRail" Click="BtnToggleRail_Click" Style="{StaticResource KmRailButton}" Width="48" Height="44" Margin="0" ToolTip="Toggle expanded rail">
                                <Border Width="34" Height="32" CornerRadius="10" Background="#14FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1">
                                    <TextBlock Text="KM" FontWeight="ExtraBold" FontSize="13" Foreground="#FF8A00" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Button>
                        </Border>

                        <!-- Nav Buttons -->
                        <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center">
                            <Button x:Name="BtnNavHome" Tag="Home" Click="Nav_Click" Style="{StaticResource KmRailButton}" ToolTip="Home"
                                    Background="{StaticResource KmBrandGradient}">
                                <Button.Effect>
                                    <DropShadowEffect Color="#FF5A00" BlurRadius="16" ShadowDepth="0" Opacity="0.45"/>
                                </Button.Effect>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="PathNavHome" Data="{StaticResource KmIconHome}" Stroke="#0A0A0A" StrokeThickness="2" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtNavHome" Text="Home" FontSize="13" FontWeight="SemiBold" Foreground="#0A0A0A" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnNavSend" Tag="Send" Click="Nav_Click" Style="{StaticResource KmRailButton}" ToolTip="Send">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="PathNavSend" Data="{StaticResource KmIconSend}" Stroke="#8C8C8C" StrokeThickness="2" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtNavSend" Text="Send" FontSize="13" FontWeight="SemiBold" Foreground="#8C8C8C" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnNavReceive" Tag="Receive" Click="Nav_Click" Style="{StaticResource KmRailButton}" ToolTip="Receive">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="PathNavReceive" Data="{StaticResource KmIconReceive}" Stroke="#8C8C8C" StrokeThickness="2" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtNavReceive" Text="Receive" FontSize="13" FontWeight="SemiBold" Foreground="#8C8C8C" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnNavMigration" Tag="Migration" Click="Nav_Click" Style="{StaticResource KmRailButton}" ToolTip="Move device">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="PathNavMigration" Data="{StaticResource KmIconMigrate}" Stroke="#8C8C8C" StrokeThickness="2" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtNavMigration" Text="Move device" FontSize="13" FontWeight="SemiBold" Foreground="#8C8C8C" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnNavHistory" Tag="History" Click="Nav_Click" Style="{StaticResource KmRailButton}" ToolTip="History">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="PathNavHistory" Data="{StaticResource KmIconHistory}" Stroke="#8C8C8C" StrokeThickness="2" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtNavHistory" Text="History" FontSize="13" FontWeight="SemiBold" Foreground="#8C8C8C" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnNavSettings" Tag="Settings" Click="Nav_Click" Style="{StaticResource KmRailButton}" ToolTip="Settings">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="PathNavSettings" Data="{StaticResource KmIconSettings}" Stroke="#8C8C8C" StrokeThickness="2" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtNavSettings" Text="Settings" FontSize="13" FontWeight="SemiBold" Foreground="#8C8C8C" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Hidden elements needed for background services compatibility -->
                <Grid Visibility="Collapsed">
                    <Button x:Name="BtnNavWebShare" Tag="WebShare" Click="Nav_Click" />
                    <Button x:Name="BtnNavSecurity" Tag="Security" Click="Nav_Click" />
                    <TextBlock x:Name="TxtSidebarVersion" />
                    <TextBlock x:Name="TxtSidebarFooterVersion" />
                    <TextBlock x:Name="TxtUpdatedOn" />
                    <TextBlock x:Name="TxtCoreStatus" />
                    <TextBlock x:Name="TxtLocalInfo" />
                    <TextBlock x:Name="TxtCurrentVersionBadge" />
                    <TextBlock x:Name="TxtAboutVersion" />
                    <TextBlock x:Name="TxtAboutDateUpdated" />
                    <TextBlock x:Name="TxtAvailableVersionTitle" />
                    <TextBlock x:Name="TxtAvailableVersionSize" />
                    <TextBlock x:Name="TxtReleaseNotes" />
                    <TextBlock x:Name="TxtDownloadProgressTitle" />
                    <TextBlock x:Name="TxtDownloadSpeedEta" />
                    <TextBlock x:Name="TxtDownloadBytesCount" />
                    <TextBlock x:Name="TxtUpdateStatusSummary" />
                    <TextBlock x:Name="TxtElapsed" />
                    <TextBlock x:Name="TxtEta" />
                    <TextBlock x:Name="TxtTransferredSize" />
                    <TextBlock x:Name="TxtActiveTransport" />
                    <TextBlock x:Name="TxtBestTransportBadge" />
                    <TextBlock x:Name="TxtDirection" />
                    <TextBlock x:Name="TxtDiagSpeed" />
                    <TextBlock x:Name="TxtDiagLatency" />
                    <TextBlock x:Name="TxtDiagMemory" />
                    <TextBlock x:Name="TxtDiagChunk" />
                    <TextBlock x:Name="TxtDiagTransport" />
                    <TextBlock x:Name="TxtWebShareFilesCount" />
                    <TextBlock x:Name="TxtWebShareStatusBadge" />
                    <TextBlock x:Name="TxtWebShareUrl" />
                    <TextBlock x:Name="TxtCopyFeedback" />
                    <TextBlock x:Name="TxtIncomingDeviceName" />
                    <TextBlock x:Name="TxtIncomingPlatform" />
                    <TextBlock x:Name="TxtIncomingTransport" />
                    <TextBlock x:Name="TxtReceivedFileName" />
                    <TextBlock x:Name="TxtReceivedFileSize" />
                    <TextBlock x:Name="TxtReceivedSender" />
                    <TextBlock x:Name="TxtReceivedSavedTo" />
                    <TextBlock x:Name="TxtMigrationScanCount" />
                    <TextBlock x:Name="TxtMigrationScanTitle" />
                    <Image x:Name="ImgTitleBarLogo" />
                    <Image x:Name="ImgWebShareQr" />
                    <ImageBrush x:Name="LogoHeaderBrush" />
                    <ImageBrush x:Name="LogoMigrationBrush" />
                    <ProgressBar x:Name="ProgressBarDownload" />
                    <CheckBox x:Name="ChkAutoCheckUpdates" />
                    <CheckBox x:Name="ChkRequirePin" />
                    <CheckBox x:Name="ChkMinimizeToTray" />
                    <CheckBox x:Name="ChkShellContextMenu" />
                    <CheckBox x:Name="ChkTemporaryReceive" />
                    <CheckBox x:Name="ChkPictures" />
                    <CheckBox x:Name="ChkVideos" />
                    <CheckBox x:Name="ChkDocs" />
                    <CheckBox x:Name="ChkMusic" />
                    <CheckBox x:Name="ChkDownloads" />
                    <CheckBox x:Name="ChkDesktop" />
                    <ComboBox x:Name="CmbMigrationTarget" />
                    <ListBox x:Name="ListWebShareFiles" />
                    <Button x:Name="BtnPauseTransfer" />
                    <Button x:Name="BtnCheckUpdates" />
                    <Button x:Name="BtnSkipUpdate" />
                    <Button x:Name="BtnUpdateNow" />
                    <Button x:Name="BtnUpdateAfterTransfer" />
                    <Button x:Name="BtnCancelDownload" />
                    <Button x:Name="BtnTransportAuto" />
                    <Button x:Name="BtnTransportWifi" />
                    <Button x:Name="BtnTransportDirect" />
                    <Button x:Name="BtnTransportBt" />
                    <Ellipse x:Name="DotDiscoveryStatus" />
                    <Border x:Name="PanelMigrationScan" />
                    <Border x:Name="PanelCopyFeedback" />
                    <Border x:Name="PanelUpdateAvailable" />
                    <Border x:Name="PanelUpdateProgress" />
                    <Border x:Name="PanelActiveTransferWarning" />
                    <Path x:Name="IconReceivedFile" />
                    <Path x:Name="IconNotificationType" />
                    <Grid x:Name="ViewWebShare" />
                    <Grid x:Name="ViewSecurity" />
                </Grid>

                <!-- ── Main Content Area ──────────────────────────────── -->
                <ScrollViewer Grid.Column="1" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,6,22,20">
                    <Grid>

                        <!-- ══ VIEW 1: HOME ════════════════════════════════════ -->
                        <Grid x:Name="ViewHome" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Home" FontSize="22" FontWeight="Bold" Foreground="#F5F5F5" Margin="4,4,0,14" />

                            <!-- Top 2-Column Section (1.3fr : 1fr) -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: Dashed Dropzone -->
                                <Border Grid.Column="0" Background="#09FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16" Padding="12">
                                    <Border x:Name="HomeDropZone" Cursor="Hand" Height="190" CornerRadius="14" BorderBrush="#72FF8A00" BorderThickness="1.5"
                                            AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop" MouseLeftButtonUp="HomeDropZone_Click">
                                        <Border.Background>
                                            <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.6" RadiusY="0.6">
                                                <GradientStop Color="#24FF5A00" Offset="0"/>
                                                <GradientStop Color="Transparent" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Border.Background>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Path Data="{StaticResource KmIconFile}" Stroke="#FF8A00" StrokeThickness="2" Width="30" Height="30" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                            <TextBlock Text="Drop files or folders here" FontSize="15" FontWeight="SemiBold" Foreground="#F5F5F5" HorizontalAlignment="Center" />
                                            <TextBlock Text="or click to choose what to send" FontSize="12" Foreground="#8C8C8C" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Border>

                                <!-- Right: Nearby Devices -->
                                <Border Grid.Column="2" Background="#09FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16" Padding="18">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <TextBlock Text="Nearby" FontSize="14" FontWeight="SemiBold" Foreground="#F5F5F5" VerticalAlignment="Center" />
                                            <TextBlock x:Name="TxtDiscoveryStatus" Text="Scanning LAN..." FontSize="11" Foreground="#8C8C8C" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Static mockup rows matching prototype -->
                                        <Border Background="#05FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="12" Padding="10,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="0" Data="{StaticResource KmIconDevice}" Stroke="#F5F5F5" StrokeThickness="1.8" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Android phone" FontSize="13" Foreground="#F5F5F5" FontWeight="Medium" />
                                                    <TextBlock Text="Wi-Fi LAN · Trusted" FontSize="11" Foreground="#8C8C8C" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Background="#264ADE80" CornerRadius="999" Padding="8,2" VerticalAlignment="Center">
                                                    <TextBlock Text="Online" Foreground="#4ADE80" FontSize="11" FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Border Background="#05FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="12" Padding="10,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="0" Data="{StaticResource KmIconDevice}" Stroke="#8C8C8C" StrokeThickness="1.8" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Work laptop" FontSize="13" Foreground="#F5F5F5" FontWeight="Medium" />
                                                    <TextBlock Text="Wi-Fi LAN" FontSize="11" Foreground="#8C8C8C" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Background="#0FFFFFFF" CornerRadius="999" Padding="8,2" VerticalAlignment="Center">
                                                    <TextBlock Text="Idle" Foreground="#8C8C8C" FontSize="11" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Dynamic discovered devices list -->
                                        <ListBox x:Name="ListDevices" Background="Transparent" BorderThickness="0" MaxHeight="100" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#05FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="12" Padding="8,6" Margin="0,2">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Path Grid.Column="0" Data="{StaticResource KmIconDevice}" Stroke="#FF5A00" StrokeThickness="1.8" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                            <TextBlock Grid.Column="1" Text="{Binding DeviceName}" FontSize="12" Foreground="#F5F5F5" VerticalAlignment="Center" />
                                                            <Border Grid.Column="2" Background="#264ADE80" CornerRadius="999" Padding="6,2" VerticalAlignment="Center">
                                                                <TextBlock Text="Ready" Foreground="#4ADE80" FontSize="10" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Bottom: Recent Transfers Table -->
                            <Border Grid.Row="2" Background="#09FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Recent transfers" FontSize="14" FontWeight="SemiBold" Foreground="#F5F5F5" Margin="0,0,0,12" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.5*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1.5*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Photos_March.zip" FontSize="13" Foreground="#F5F5F5" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="To Android phone" FontSize="13" Foreground="#8C8C8C" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="1.2 GB" FontSize="13" Foreground="#8C8C8C" VerticalAlignment="Center" />
                                        <Border Grid.Column="3" Background="#264ADE80" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="SHA-256 verified" Foreground="#4ADE80" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                    <Border Height="1" Background="#0FFFFFFF" Margin="0,4,0,8" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.5*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1.5*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Resume_2026.pdf" FontSize="13" Foreground="#F5F5F5" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="From Android phone" FontSize="13" Foreground="#8C8C8C" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="0.4 MB" FontSize="13" Foreground="#8C8C8C" VerticalAlignment="Center" />
                                        <Border Grid.Column="3" Background="#264ADE80" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="SHA-256 verified" Foreground="#4ADE80" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                    <Border Height="1" Background="#0FFFFFFF" Margin="0,4,0,8" />
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.5*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1.5*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Lecture_notes/" FontSize="13" Foreground="#F5F5F5" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="To Work laptop" FontSize="13" Foreground="#8C8C8C" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="320 MB" FontSize="13" Foreground="#8C8C8C" VerticalAlignment="Center" />
                                        <Border Grid.Column="3" Background="#264ADE80" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="SHA-256 verified" Foreground="#4ADE80" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ══ VIEW 2: SEND ════════════════════════════════════ -->
                        <Grid x:Name="ViewSend" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Send" FontSize="22" FontWeight="Bold" Foreground="#F5F5F5" Margin="4,4,0,14" />

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: File Selection List -->
                                <Border Grid.Column="0" Background="#09FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16" Padding="14">
                                    <DockPanel>
                                        <!-- Action Buttons at Top -->
                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                            <TextBlock Text="Staged Items" FontSize="13" FontWeight="SemiBold" Foreground="#8C8C8C" VerticalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="+ Files" Click="ChooseFiles_Click" Style="{StaticResource KmGlassButton}" MinHeight="32" Padding="12,4" Margin="0,0,6,0" FontSize="12" />
                                                <Button Content="+ Folder" Click="ChooseFolder_Click" Style="{StaticResource KmGlassButton}" MinHeight="32" Padding="12,4" Margin="0,0,6,0" FontSize="12" />
                                                <Button Content="Clear" Click="ClearSelectedFiles_Click" Style="{StaticResource KmGlassButton}" MinHeight="32" Padding="12,4" FontSize="12" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Prototype File Rows -->
                                        <StackPanel DockPanel.Dock="Top">
                                            <Border Background="#05FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="Photos_March.zip" FontSize="13" Foreground="#F5F5F5" FontWeight="Medium" />
                                                        <TextBlock Text="1.2 GB" FontSize="11" Foreground="#8C8C8C" Margin="0,1,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border Background="#05FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="Lecture_notes/" FontSize="13" Foreground="#F5F5F5" FontWeight="Medium" />
                                                        <TextBlock Text="320 MB · folder" FontSize="11" Foreground="#8C8C8C" Margin="0,1,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border Background="#05FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="Resume_2026.pdf" FontSize="13" Foreground="#F5F5F5" FontWeight="Medium" />
                                                        <TextBlock Text="0.4 MB" FontSize="11" Foreground="#8C8C8C" Margin="0,1,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Border Background="#05FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="False" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="Videos_2025/" FontSize="13" Foreground="#F5F5F5" FontWeight="Medium" />
                                                        <TextBlock Text="4.8 GB · folder" FontSize="11" Foreground="#8C8C8C" Margin="0,1,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>

                                <!-- Right: Send To & Progress Pane -->
                                <StackPanel Grid.Column="2">
                                    <Border Background="#09FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16" Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="Send to" FontSize="12" Foreground="#8C8C8C" />
                                            <TextBlock x:Name="TxtSendTargetName" Text="Android phone" FontSize="16" FontWeight="Bold" Foreground="#F5F5F5" Margin="0,4,0,8" />
                                            <TextBlock x:Name="TxtFileInfo" Text="Selected: 3 items · 1.5 GB" FontSize="12" Foreground="#8C8C8C" Margin="0,0,0,14" />
                                            <Button x:Name="BtnTransfer" Click="TransferNow_Click" Style="{StaticResource KmPrimaryButton}" Content="Start transfer" MinHeight="44" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Real-time Progress Pane -->
                                    <Border x:Name="PanelProgress" Background="#09FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,14,0,0" Visibility="Visible">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock x:Name="TxtProgressTitle" Text="Photos_March.zip" FontWeight="Bold" FontSize="13" Foreground="#F5F5F5" VerticalAlignment="Center" />
                                                <TextBlock x:Name="TxtPercentage" Text="0%" FontSize="13" Foreground="#8C8C8C" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                            <ProgressBar x:Name="ProgressBarTransfer" Style="{StaticResource KmGradientProgressBar}" Height="10" Margin="0,12,0,12" Value="0" />
                                            <TextBlock x:Name="TxtSpeed" Text="Ready to transfer" FontSize="12" Foreground="#8C8C8C" />
                                            <TextBlock x:Name="TxtStatus" Text="Pluto Engine Standby" FontSize="11" Foreground="#555555" Margin="0,2,0,0" />
                                            <Button x:Name="BtnCancelTransfer" Click="CancelTransfer_Click" Style="{StaticResource KmGlassButton}" Content="Cancel" Margin="0,12,0,0" MinHeight="36" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- ══ VIEW 3: RECEIVE ═════════════════════════════════ -->
                        <Grid x:Name="ViewReceive" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Receive" FontSize="22" FontWeight="Bold" Foreground="#F5F5F5" Margin="4,4,0,14" />

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: Radar Listening Zone -->
                                <Border Grid.Column="0" Background="#09FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16" Padding="30">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <!-- Concentric Pulsing Radar -->
                                        <Grid Width="120" Height="120" HorizontalAlignment="Center" Margin="0,0,0,20">
                                            <Ellipse x:Name="RadarRing1" Width="120" Height="120" Stroke="#72FF5A00" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform>
                                                    <ScaleTransform ScaleX="0.25" ScaleY="0.25"/>
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                            <Ellipse x:Name="RadarRing2" Width="120" Height="120" Stroke="#72FF5A00" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform>
                                                    <ScaleTransform ScaleX="0.25" ScaleY="0.25"/>
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                            <Ellipse x:Name="RadarRing3" Width="120" Height="120" Stroke="#72FF5A00" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform>
                                                    <ScaleTransform ScaleX="0.25" ScaleY="0.25"/>
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                            <Ellipse Width="14" Height="14" Fill="#FF5A00" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect Color="#FF5A00" BlurRadius="16" ShadowDepth="0" Opacity="0.9"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                        </Grid>

                                        <TextBlock Text="Listening on Wi-Fi LAN" FontSize="16" FontWeight="SemiBold" Foreground="#F5F5F5" HorizontalAlignment="Center" />
                                        <TextBlock Text="Visible to nearby devices as This PC" FontSize="12" Foreground="#8C8C8C" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Right: Pairing PIN -->
                                <Border Grid.Column="2" Background="#09FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16" Padding="24">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Pairing PIN" FontSize="12" Foreground="#8C8C8C" />
                                        <TextBlock x:Name="TxtIncomingPin" Text="482 915" FontSize="34" FontWeight="Bold" Foreground="#F5F5F5" Margin="0,8,0,8" />
                                        <TextBlock Text="Confirm the same PIN on the sending device before you accept." FontSize="12" Foreground="#8C8C8C" TextWrapping="Wrap" Margin="0,0,0,20" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="Reject" Click="DismissNotification_Click" Style="{StaticResource KmGlassButton}" MinHeight="42" />
                                            <Button Grid.Column="2" Content="Accept" Click="DismissNotification_Click" Style="{StaticResource KmPrimaryButton}" MinHeight="42" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- ══ VIEW 4: DEVICE MIGRATION ════════════════════════ -->
                        <Grid x:Name="ViewMigration" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Device migration" FontSize="22" FontWeight="Bold" Foreground="#F5F5F5" Margin="4,4,0,4" />
                            <TextBlock Grid.Row="1" x:Name="TxtMigrationStepLabel" Text="Step 2 of 10 · Photos" FontSize="12" Foreground="#8C8C8C" Margin="4,0,0,14" />

                            <!-- 10 Step Pills -->
                            <WrapPanel Grid.Row="2" x:Name="PanelMigrationSteps" Margin="0,0,0,16">
                                <!-- Populated dynamically by UpdateMigrationStepUI in MainWindow.xaml.cs -->
                            </WrapPanel>

                            <!-- Pre-flight Storage Check Glass Card -->
                            <Border Grid.Row="3" Background="#09FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16" Padding="20">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Pre-flight storage check" FontSize="14" FontWeight="Bold" Foreground="#F5F5F5" VerticalAlignment="Center" />
                                        <TextBlock Text="18.2 GB needed · 64 GB free" FontSize="12" Foreground="#8C8C8C" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <ProgressBar x:Name="ProgressBarMigrationScan" Style="{StaticResource KmGradientProgressBar}" Height="10" Value="28" Margin="0,14,0,14" />
                                    <TextBlock Text="Scan first, then choose what to move." FontSize="12" Foreground="#8C8C8C" />
                                </StackPanel>
                            </Border>

                            <!-- Navigation Buttons -->
                            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,16,0,0" Width="380" HorizontalAlignment="Left">
                                <Button Content="Back" Click="BtnMigrationBack_Click" Style="{StaticResource KmGlassButton}" Width="180" Margin="0,0,10,0" />
                                <Button Content="Next" Click="BtnMigrationNext_Click" Style="{StaticResource KmPrimaryButton}" Width="180" />
                            </StackPanel>
                        </Grid>

                        <!-- ══ VIEW 5: HISTORY ═════════════════════════════════ -->
                        <Grid x:Name="ViewHistory" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="History" FontSize="22" FontWeight="Bold" Foreground="#F5F5F5" Margin="4,4,0,14" />

                            <Border Grid.Row="1" Background="#09FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16" Padding="18">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.5*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Photos_March.zip" FontSize="13" Foreground="#F5F5F5" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="1.2 GB" FontSize="13" Foreground="#8C8C8C" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="20 MB/s" FontSize="13" Foreground="#8C8C8C" VerticalAlignment="Center" />
                                        <Border Grid.Column="3" Background="#264ADE80" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="Verified" Foreground="#4ADE80" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                    <Border Height="1" Background="#0FFFFFFF" Margin="0,4,0,12" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.5*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Resume_2026.pdf" FontSize="13" Foreground="#F5F5F5" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="0.4 MB" FontSize="13" Foreground="#8C8C8C" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="Yesterday" FontSize="13" Foreground="#8C8C8C" VerticalAlignment="Center" />
                                        <Border Grid.Column="3" Background="#264ADE80" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="Verified" Foreground="#4ADE80" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                    <Border Height="1" Background="#0FFFFFFF" Margin="0,4,0,12" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.5*" />
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Lecture_notes/" FontSize="13" Foreground="#F5F5F5" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="320 MB" FontSize="13" Foreground="#8C8C8C" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="Oct 19" FontSize="13" Foreground="#8C8C8C" VerticalAlignment="Center" />
                                        <Border Grid.Column="3" Background="#264ADE80" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="Verified" Foreground="#4ADE80" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>

                                    <!-- Dynamic Ledger Items -->
                                    <ListBox x:Name="ListHistory" Background="Transparent" BorderThickness="0" MaxHeight="220" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2.5*" />
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="2*" />
                                                        <ColumnDefinition Width="1*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding FileName}" FontSize="12" Foreground="#F5F5F5" />
                                                    <TextBlock Grid.Column="1" Text="{Binding FormattedSize}" FontSize="12" Foreground="#8C8C8C" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}" FontSize="12" Foreground="#8C8C8C" />
                                                    <Border Grid.Column="3" Background="#264ADE80" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left">
                                                        <TextBlock Text="Verified" Foreground="#4ADE80" FontSize="10" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel x:Name="PanelLedgerEmpty" Visibility="Collapsed">
                                        <TextBlock Text="No past transfers" Foreground="#555555" FontSize="12" Margin="0,8,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ══ VIEW 6: SETTINGS ════════════════════════════════ -->
                        <Grid x:Name="ViewSettings" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Settings" FontSize="22" FontWeight="Bold" Foreground="#F5F5F5" Margin="4,4,0,14" />

                            <Border Grid.Row="1" Background="#09FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16" Padding="20">
                                <StackPanel>
                                    <!-- Setting Row 1: Auto Accept -->
                                    <Grid Margin="0,4,0,14">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Auto-accept trusted devices" FontSize="13" Foreground="#F5F5F5" FontWeight="Medium" />
                                            <TextBlock Text="Still asks for PIN confirmation" FontSize="11" Foreground="#8C8C8C" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox x:Name="ChkAutoAcceptTrusted" Style="{StaticResource KmToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <Border Height="1" Background="#0FFFFFFF" Margin="0,0,0,14" />

                                    <!-- Setting Row 2: Duplicate Handling -->
                                    <Grid Margin="0,0,0,14">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Keep both files on duplicate" FontSize="13" Foreground="#F5F5F5" FontWeight="Medium" />
                                            <TextBlock Text="Otherwise replace the existing file" FontSize="11" Foreground="#8C8C8C" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox x:Name="ChkSmartDuplicates" Style="{StaticResource KmToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <Border Height="1" Background="#0FFFFFFF" Margin="0,0,0,14" />

                                    <!-- Setting Row 3: Notifications -->
                                    <Grid Margin="0,0,0,14">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Notify when a transfer arrives" FontSize="13" Foreground="#F5F5F5" FontWeight="Medium" />
                                            <TextBlock Text="Flashes the taskbar icon" FontSize="11" Foreground="#8C8C8C" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox x:Name="ChkSoundEffects" Style="{StaticResource KmToggleSwitch}" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <Border Height="1" Background="#0FFFFFFF" Margin="0,0,0,14" />

                                    <!-- Download Directory Setting -->
                                    <Grid Margin="0,0,0,4">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Default download folder" FontSize="13" Foreground="#F5F5F5" FontWeight="Medium" />
                                            <TextBlock x:Name="TxtSettingsReceiveFolder" Text="C:\Users\Downloads" FontSize="11" Foreground="#8C8C8C" Margin="0,2,0,0" />
                                            <TextBlock x:Name="TxtDownloadDir" Visibility="Collapsed" />
                                            <TextBox x:Name="TxtSettingsDeviceName" Visibility="Collapsed" />
                                            <TextBox x:Name="TxtManualIp" Visibility="Collapsed" />
                                        </StackPanel>
                                        <Button Content="Change" Click="ChangeDownloadFolder_Click" Style="{StaticResource KmGlassButton}" MinHeight="34" Padding="14,4" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Notification Banner -->
                        <Border x:Name="PanelNotificationBanner" Background="#140900" BorderBrush="#FF5A00" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,14" Visibility="Collapsed" VerticalAlignment="Top">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="TxtNotificationTitle" FontWeight="Bold" FontSize="13" Foreground="#FF8A00" />
                                    <TextBlock x:Name="TxtNotificationBody" FontSize="12" Foreground="#8C8C8C" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="✕" Click="DismissNotification_Click" Style="{StaticResource KmGlassButton}" MinHeight="26" Width="26" Padding="0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Modals Container (Kept for compatibility) -->
                        <Grid x:Name="ModalIncomingTransfer" Visibility="Collapsed" />
                        <Grid x:Name="ModalReceiveCompletion" Visibility="Collapsed" />

                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>