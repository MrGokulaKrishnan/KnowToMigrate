<Window x:Class="KnowToMigrate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KnowToMigrate — Move Anything. Anywhere. Seamlessly."
        Icon="Assets/KnowToMigrate.ico"
        Width="1280" Height="820"
        MinWidth="1000" MinHeight="650"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#000000"
        Foreground="#FFFFFF"
        StateChanged="MainWindow_StateChanged">

    <!-- Native Windows 11 Chrome with full hardware acceleration, taskbar awareness, and native resize borders -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- Window Shell -->
    <Border x:Name="RootBorder" Background="#040404" BorderBrush="#222222" BorderThickness="1" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Windows 11 Custom Title Bar -->
            <Border Grid.Row="0" Background="#070707" BorderBrush="#141414" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Title Bar Brand Icon and Text -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border CornerRadius="4.5" Width="22" Height="22" BorderBrush="#FF5A00" BorderThickness="1" Background="#000000" SnapsToDevicePixels="True" ClipToBounds="True">
                            <Image x:Name="ImgTitleBarLogo" Source="Assets/logo.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="KnowToMigrate" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="·" Foreground="#444444" FontSize="13" Margin="6,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Move Anything. Anywhere. Seamlessly." Foreground="#777777" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Center Drag Zone (handled by WindowChrome) -->
                    <Grid Grid.Column="1" Background="Transparent" />

                    <!-- Window Control Buttons (Minimize, Maximize/Restore, Close) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="BtnMinimize" Click="BtnMinimize_Click" Style="{StaticResource KmTitleBarButton}" ToolTip="Minimize">
                            <Path Data="M0,0 L10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="10" Height="2" Stretch="None" />
                        </Button>
                        <Button x:Name="BtnMaximize" Click="BtnMaximize_Click" Style="{StaticResource KmTitleBarButton}" ToolTip="Maximize">
                            <Path x:Name="MaximizePath" Data="M0,0 H10 V10 H0 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Fill="Transparent" Width="10" Height="10" Stretch="None" />
                        </Button>
                        <Button x:Name="BtnClose" Click="BtnClose_Click" Style="{StaticResource KmTitleBarCloseButton}" ToolTip="Close">
                            <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Width="9" Height="9" Stretch="None" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main App Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar (Liquid Glass AMOLED Surface) -->
                <Border Grid.Column="0" Background="#060606" BorderBrush="#141414" BorderThickness="0,0,1,0" CornerRadius="0,0,0,18">
                    <DockPanel Margin="18,20,18,18">
                        <!-- Top Brand with 15% Corner Radius Logo Badge -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Master Logo Badge: 48x48 with 15% Corner Radius = 7.2 -->
                                <Border CornerRadius="7.2" Width="48" Height="48" BorderBrush="#FF5A00" BorderThickness="1.5" Background="#000000" SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#FF5A00" BlurRadius="14" ShadowDepth="0" Opacity="0.45"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Border CornerRadius="7.2">
                                            <Border.Background>
                                                <ImageBrush x:Name="LogoHeaderBrush" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                        <!-- Liquid Glossy Sheen Overlay -->
                                        <Border CornerRadius="6.2,6.2,0,0" Height="22" VerticalAlignment="Top" Background="{StaticResource GlossySheenBrush}" Opacity="0.5"/>
                                    </Grid>
                                </Border>
                                
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="KnowToMigrate" Foreground="#FFFFFF" FontWeight="ExtraBold" FontSize="16" />
                                    <TextBlock Text="Standalone v1.0.0" Foreground="#888888" FontSize="11" Margin="0,1,0,0" />
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Engine Status Pill (8px Radius) -->
                            <Border Margin="0,16,0,0" Background="#140900" BorderBrush="#FF5A00" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                <TextBlock x:Name="TxtCoreStatus" Text="Pluto Engine Active (Port 54124)" Foreground="#FF8A00" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <!-- Footer Security Info (10px Radius) -->
                        <StackPanel DockPanel.Dock="Bottom">
                            <Border Background="#0C0C0C" BorderBrush="#181818" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="KnowToMigrate · v1.0.0" Foreground="#DDDDDD" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TxtUpdatedOn" Text="Updated On: 01 October 2026" Foreground="#FF8A00" FontSize="10" Margin="0,2,0,0" />
                                    <TextBlock Text="Transfer Engine: Pluto Engine" Foreground="#777777" FontSize="10" Margin="0,2,0,0" />
                                    <TextBlock Text="AES-256-GCM · X25519 · SHA-256" Foreground="#555555" FontSize="10" Margin="0,2,0,0" />
                                    <TextBlock x:Name="TxtLocalInfo" Text="Device: Windows PC" Foreground="#555555" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Navigation Buttons (Zero Emojis, 10px Radius) -->
                        <StackPanel DockPanel.Dock="Top">
                            <Button x:Name="BtnNavHome" Content="Home" Click="Nav_Click" Tag="Home" Style="{StaticResource KmNavButton}" Background="#1C0E00" Foreground="#FF8A00" BorderBrush="#FF5A00" FontWeight="Bold" />
                            <Button x:Name="BtnNavReceive" Content="Landing" Click="Nav_Click" Tag="Receive" Style="{StaticResource KmNavButton}" />
                            <Button x:Name="BtnNavWebShare" Content="Web Share" Click="Nav_Click" Tag="WebShare" Style="{StaticResource KmNavButton}" />
                            <Button x:Name="BtnNavMigration" Content="Migration Wizard" Click="Nav_Click" Tag="Migration" Style="{StaticResource KmNavButton}" />
                            <Button x:Name="BtnNavHistory" Content="Migration Ledger" Click="Nav_Click" Tag="History" Style="{StaticResource KmNavButton}" />
                            <Button x:Name="BtnNavSettings" Content="Settings" Click="Nav_Click" Tag="Settings" Style="{StaticResource KmNavButton}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Main Content Area (Responsive Scrollable Container) -->
                <ScrollViewer Grid.Column="1" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24,28,24">
                    <Grid>
                        <!-- TAB 1: Send Files (Send & Devices) -->
                    <Grid x:Name="ViewHome" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="2*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,18">
                            <TextBlock Text="Move Anything. Anywhere. Seamlessly." FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" />
                            <TextBlock Text="High-speed encrypted local transfer over Wi-Fi without internet or cloud." FontSize="13" Foreground="#888888" Margin="0,3,0,0" />
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <!-- Drag & Drop Zone (Glass Surface, 16px Radius) -->
                            <Border Grid.Column="0" Margin="0,0,16,0" AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver"
                                    Background="#080808" BorderBrush="#222222" BorderThickness="1.5" CornerRadius="16" Padding="20">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="60" Height="60" CornerRadius="30" Background="#1A0D00" BorderBrush="#FF5A00" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,14">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#FF5A00" BlurRadius="16" ShadowDepth="0" Opacity="0.4"/>
                                        </Border.Effect>
                                        <Path Data="M13,2 L3,14 L12,14 L11,22 L21,10 L12,10 Z" Fill="#FF8A00" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Drag and drop files or folders" Foreground="#FFFFFF" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="Streaming 256 KB chunks · SHA-256 verification · Resumable" Foreground="#666666" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,18" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Choose Files" Click="ChooseFiles_Click" Style="{StaticResource KmPrimaryButton}" Margin="0,0,10,0" />
                                        <Button Content="Choose Folder" Click="ChooseFolder_Click" Style="{StaticResource KmGlassButton}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Migration Targets Discovery Panel (Glass Card, 16px Radius) -->
                            <Border Grid.Column="1" Background="#080808" BorderBrush="#1C1C1C" BorderThickness="1" CornerRadius="16" Padding="16">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Migration Targets" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="DotDiscoveryStatus" Width="7" Height="7" Fill="#FF5A00" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="TxtDiscoveryStatus" Text="Scanning" Foreground="#FF8A00" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    
                                    <!-- Direct Connect Bar -->
                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                        <TextBlock Text="Or Connect directly by IP:" Foreground="#777777" FontSize="11" Margin="0,0,0,5" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" CornerRadius="12" Background="#141414" BorderBrush="#262626" BorderThickness="1">
                                                <TextBox x:Name="TxtManualIp" Text="192.168." Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" Padding="10,8" FontSize="12" />
                                            </Border>
                                            <Button Grid.Column="1" Content="Add" Click="AddManualDevice_Click" Style="{StaticResource KmGlassButton}" Height="36" Padding="14,0" Margin="8,0,0,0" />
                                        </Grid>
                                    </StackPanel>

                                    <!-- Devices ListBox -->
                                    <ListBox x:Name="ListDevices" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ListDevices_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <!-- Device Card (12px Radius) -->
                                                <Border Margin="0,0,0,6" Background="#111111" BorderBrush="#222222" BorderThickness="1" CornerRadius="12" Padding="12,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                                            <Path Data="M17 1H7c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-2-2-2zm0 18H7V5h10v14z" Fill="#888888" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DeviceName}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" />
                                                            <TextBlock Text="{Binding IpAddress}" Foreground="#888888" FontSize="11" />
                                                            <!-- Transport Capability Badges -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                <Border Background="#1A1108" BorderBrush="#FF5A00" BorderThickness="1" CornerRadius="5" Padding="5,1" Margin="0,0,4,0">
                                                                    <TextBlock Text="Wi-Fi [Best]" Foreground="#FF8A00" FontSize="9" FontWeight="SemiBold" />
                                                                </Border>
                                                                <Border Background="#0C171F" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="5" Padding="5,1" Margin="0,0,4,0">
                                                                    <TextBlock Text="Direct" Foreground="#38BDF8" FontSize="9" />
                                                                </Border>
                                                                <Border Background="#0F172A" BorderBrush="#60A5FA" BorderThickness="1" CornerRadius="5" Padding="5,1">
                                                                    <TextBlock Text="Bluetooth" Foreground="#60A5FA" FontSize="9" />
                                                                </Border>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <!-- Platform Badge (8px Radius) -->
                                                        <Border Grid.Column="2" Background="#140D00" BorderBrush="#FF5A00" BorderThickness="1" CornerRadius="8" Padding="8,4" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Platform}" Foreground="#FF5A00" FontSize="10" FontWeight="SemiBold" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- Multi-Transport Capability & Selection Pipeline (16px Radius) -->
                        <Border Grid.Row="2" Margin="0,14,0,0" Background="#0C0C0C" BorderBrush="#222222" BorderThickness="1" CornerRadius="16" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Transport Capability Check" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" />
                                        <Border Background="#1C1000" BorderBrush="#FF5A00" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="10,0,0,0">
                                            <TextBlock x:Name="TxtBestTransportBadge" Text="Best: Wi-Fi LAN (50–120+ MB/s)" Foreground="#FF8A00" FontSize="10" FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Pipeline: Migration Target ➔ Capability Check ➔ Select Route (Wi-Fi / Direct / Bluetooth) ➔ Authenticate (PIN) ➔ Transfer" Foreground="#777777" FontSize="11" Margin="0,3,0,0" />
                                </StackPanel>

                                <!-- Compact Transport Cards / Selector Buttons -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnTransportAuto" Content="Adaptive Route" Click="TransportSelect_Click" Tag="AUTO" Style="{StaticResource KmPrimaryButton}" MinHeight="36" Padding="14,6" FontSize="11" Margin="0,0,6,0" />
                                    <Button x:Name="BtnTransportWifi" Content="Wi-Fi" Click="TransportSelect_Click" Tag="WIFI_LAN" Style="{StaticResource KmGlassButton}" MinHeight="36" Padding="14,6" FontSize="11" Margin="0,0,6,0" />
                                    <Button x:Name="BtnTransportDirect" Content="Direct" Click="TransportSelect_Click" Tag="WIFI_DIRECT" Style="{StaticResource KmGlassButton}" MinHeight="36" Padding="14,6" FontSize="11" Margin="0,0,6,0" />
                                    <Button x:Name="BtnTransportBt" Click="TransportSelect_Click" Tag="BLUETOOTH" Style="{StaticResource KmGlassButton}" MinHeight="36" Padding="12,6" FontSize="11">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="16" Height="16" CornerRadius="4" Background="#0F172A" BorderBrush="#60A5FA" BorderThickness="1" Margin="0,0,6,0">
                                                <Path Data="M17.71,7.71L12,2h-1v7.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L11,14.41V22h1l5.71-5.71L13.41,12L17.71,7.71z M13,5.83l1.88,1.88L13,9.59V5.83z M13,18.17v-3.76l1.88,1.88L13,18.17z" Fill="#60A5FA" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Bluetooth" Foreground="#60A5FA" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Non-Blocking Completion Notification Banner -->
                        <Border x:Name="PanelNotificationBanner" Grid.Row="3" Margin="0,14,0,0" Background="#071C0F" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="14" Padding="16,12" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#14381F" BorderBrush="#22C55E" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Path x:Name="IconNotificationType" Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" Fill="#22C55E" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtNotificationTitle" Text="Transfer Complete" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" />
                                    <TextBlock x:Name="TxtNotificationBody" Text="Project.mp4 · 2.80 GB · Sent to Windows PC" Foreground="#BBBBBB" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Close" Click="DismissNotification_Click" Style="{StaticResource KmGlassButton}" Height="30" Padding="12,0" FontSize="11" />
                            </Grid>
                        </Border>

                        <!-- Active Progress Panel (16px Radius, Orange Glow) (Part 1, Section 7 format) -->
                        <Border x:Name="PanelProgress" Grid.Row="3" Margin="0,16,0,0" Background="#0C0C0C" BorderBrush="#FF5A00" BorderThickness="1.5" CornerRadius="16" Padding="18" Visibility="Collapsed">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF5A00" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Header: Title + Cancel Button -->
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="TxtProgressTitle" Text="Project.mp4" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <Border Background="#1C1000" BorderBrush="#FF5A00" BorderThickness="1" CornerRadius="5" Padding="6,1" Margin="0,0,6,0">
                                                <TextBlock x:Name="TxtActiveTransport" Text="Wi-Fi (LAN)" Foreground="#FF8A00" FontSize="10" FontWeight="Bold" />
                                            </Border>
                                            <Border Background="#141414" BorderBrush="#333333" BorderThickness="1" CornerRadius="5" Padding="6,1">
                                                <TextBlock x:Name="TxtDirection" Text="Sending" Foreground="#CCCCCC" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button x:Name="BtnCancelTransfer" Grid.Column="1" Content="Cancel" Click="CancelTransfer_Click" Style="{StaticResource KmGlassButton}" Height="34" Padding="14,0" Foreground="#FF5555" BorderBrush="#552222" />
                                </Grid>

                                <!-- Transferred Size Row -->
                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtTransferredSize" Grid.Column="0" Text="1.24 GB / 2.80 GB" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock x:Name="TxtPercentage" Grid.Column="1" Text="44%" Foreground="#FF8A00" FontWeight="ExtraBold" FontSize="16" />
                                </Grid>

                                <!-- Orange Gradient Progress Bar -->
                                <ProgressBar x:Name="ProgressBarTransfer" Grid.Row="2" Height="10" Minimum="0" Maximum="100" Value="0" Background="#1A1A1A" Foreground="#FF5A00" BorderThickness="0" Margin="0,0,0,12" />

                                <!-- Stats Footer: Speed, ETA, Elapsed -->
                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Speed" Foreground="#777777" FontSize="10" />
                                        <TextBlock x:Name="TxtSpeed" Text="48.6 MB/s" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="ETA" Foreground="#777777" FontSize="10" />
                                        <TextBlock x:Name="TxtEta" Text="ETA 00:32" Foreground="#FF8A00" FontWeight="Bold" FontSize="12" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <TextBlock Text="Elapsed" Foreground="#777777" FontSize="10" />
                                        <TextBlock x:Name="TxtElapsed" Text="00:38" Foreground="#CCCCCC" FontWeight="Bold" FontSize="12" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Action Bar (16px Radius) -->
                        <Border Grid.Row="4" Margin="0,16,0,0" Background="#0A0A0A" BorderBrush="#1C1C1C" BorderThickness="1" CornerRadius="16" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtStatus" Text="Ready to transfer · UDP Discovery Active (Port 54123)" Foreground="#FF8A00" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock x:Name="TxtFileInfo" Text="0 files staged (0 B) · Select a device on the right" Foreground="#777777" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button x:Name="BtnTransfer" Grid.Column="1" Content="Transfer Files" Click="TransferNow_Click" Style="{StaticResource KmPrimaryButton}" MinHeight="46" Padding="26,10" FontSize="14" />
                            </Grid>
