<Window x:Class="KnowToMigrate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KnowToMigrate — Move Anything. Anywhere. Seamlessly."
        Icon="Assets/KnowToMigrate.ico"
        Height="800" Width="1160"
        MinHeight="680" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <!-- Window Outer Shell with Windows 11 Rounded Geometry (20px Radius) -->
    <Border CornerRadius="20" Background="#040404" BorderBrush="#242424" BorderThickness="1.5" SnapsToDevicePixels="True" Margin="8">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.85"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Windows 11 Custom Title Bar -->
            <Border Grid.Row="0" Background="#070707" BorderBrush="#141414" BorderThickness="0,0,0,1"
                    CornerRadius="18,18,0,0" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Title Bar Brand Icon and Text -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Border CornerRadius="4.5" Width="22" Height="22" BorderBrush="#FF5A00" BorderThickness="1" Background="#000000">
                            <Path Data="M13,2 L3,14 L12,14 L11,22 L21,10 L12,10 Z" Fill="#FF8A00" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="KnowToMigrate" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="·" Foreground="#444444" FontSize="13" Margin="6,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Move Anything. Anywhere. Seamlessly." Foreground="#777777" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Center Drag Zone -->
                    <Rectangle Grid.Column="1" Fill="Transparent" />

                    <!-- Window Control Buttons (Minimize, Maximize, Close) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button Click="BtnMinimize_Click" Style="{StaticResource KmTitleBarButton}" ToolTip="Minimize">
                            <Path Data="M0,0 L10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="10" Height="2" Stretch="None" />
                        </Button>
                        <Button Click="BtnMaximize_Click" Style="{StaticResource KmTitleBarButton}" ToolTip="Maximize">
                            <Path Data="M0,0 H10 V10 H0 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Fill="Transparent" Width="10" Height="10" Stretch="None" />
                        </Button>
                        <Button Click="BtnClose_Click" Style="{StaticResource KmTitleBarCloseButton}" ToolTip="Close">
                            <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Width="9" Height="9" Stretch="None" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main App Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar (Liquid Glass AMOLED Surface) -->
                <Border Grid.Column="0" Background="#060606" BorderBrush="#141414" BorderThickness="0,0,1,0" CornerRadius="0,0,0,18">
                    <DockPanel Margin="18,20,18,18">
                        <!-- Top Brand with 15% Corner Radius Logo Badge -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Master Logo Badge: 48x48 with 15% Corner Radius = 7.2 -->
                                <Border CornerRadius="7.2" Width="48" Height="48" BorderBrush="#FF5A00" BorderThickness="1.5" Background="#000000" SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#FF5A00" BlurRadius="14" ShadowDepth="0" Opacity="0.45"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Border CornerRadius="7.2">
                                            <Border.Background>
                                                <ImageBrush x:Name="LogoHeaderBrush" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                        <!-- Liquid Glossy Sheen Overlay -->
                                        <Border CornerRadius="6.2,6.2,0,0" Height="22" VerticalAlignment="Top" Background="{StaticResource GlossySheenBrush}" Opacity="0.5"/>
                                    </Grid>
                                </Border>
                                
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="KnowToMigrate" Foreground="#FFFFFF" FontWeight="ExtraBold" FontSize="16" />
                                    <TextBlock Text="Standalone v1.0.0" Foreground="#888888" FontSize="11" Margin="0,1,0,0" />
                                </StackPanel>
                            </StackPanel>
                            
                            <!-- Engine Status Pill (8px Radius) -->
                            <Border Margin="0,16,0,0" Background="#140900" BorderBrush="#FF5A00" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                <TextBlock x:Name="TxtCoreStatus" Text="Engine Active (Port 54124)" Foreground="#FF8A00" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <!-- Footer Security Info (10px Radius) -->
                        <StackPanel DockPanel.Dock="Bottom">
                            <Border Background="#0C0C0C" BorderBrush="#181818" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="AES-256-GCM · SHA-256 Verified" Foreground="#777777" FontSize="11" />
                                    <TextBlock Text="Local Offline P2P Transfer" Foreground="#777777" FontSize="11" Margin="0,2,0,0" />
                                    <TextBlock x:Name="TxtLocalInfo" Text="Device: Windows PC" Foreground="#555555" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Navigation Buttons (Zero Emojis, 10px Radius) -->
                        <StackPanel DockPanel.Dock="Top">
                            <Button x:Name="BtnNavHome" Content="Quick Share" Click="Nav_Click" Tag="Home" Style="{StaticResource KmNavButton}" Background="#1C0E00" Foreground="#FF8A00" BorderBrush="#FF5A00" FontWeight="Bold" />
                            <Button x:Name="BtnNavReceive" Content="Receive Files" Click="Nav_Click" Tag="Receive" Style="{StaticResource KmNavButton}" />
                            <Button x:Name="BtnNavMigration" Content="Migration Wizard" Click="Nav_Click" Tag="Migration" Style="{StaticResource KmNavButton}" />
                            <Button x:Name="BtnNavHistory" Content="Transfer History" Click="Nav_Click" Tag="History" Style="{StaticResource KmNavButton}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Main Content Area -->
                <Grid Grid.Column="1" Margin="28,24,28,24">
                    <!-- TAB 1: Quick Share (Send & Devices) -->
                    <Grid x:Name="ViewHome" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="2*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,18">
                            <TextBlock Text="Move Anything. Anywhere. Seamlessly." FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" />
                            <TextBlock Text="High-speed encrypted local transfer over Wi-Fi without internet or cloud." FontSize="13" Foreground="#888888" Margin="0,3,0,0" />
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <!-- Drag & Drop Zone (Glass Surface, 16px Radius) -->
                            <Border Grid.Column="0" Margin="0,0,16,0" AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver"
                                    Background="#080808" BorderBrush="#222222" BorderThickness="1.5" CornerRadius="16" Padding="20">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="60" Height="60" CornerRadius="30" Background="#1A0D00" BorderBrush="#FF5A00" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,14">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#FF5A00" BlurRadius="16" ShadowDepth="0" Opacity="0.4"/>
                                        </Border.Effect>
                                        <Path Data="M13,2 L3,14 L12,14 L11,22 L21,10 L12,10 Z" Fill="#FF8A00" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Drag and drop files or folders" Foreground="#FFFFFF" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="Streaming 256 KB chunks · SHA-256 verification · Resumable" Foreground="#666666" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,18" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Choose Files" Click="ChooseFiles_Click" Style="{StaticResource KmPrimaryButton}" Margin="0,0,10,0" />
                                        <Button Content="Choose Folder" Click="ChooseFolder_Click" Style="{StaticResource KmGlassButton}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Nearby Devices Discovery Panel (Glass Card, 16px Radius) -->
                            <Border Grid.Column="1" Background="#080808" BorderBrush="#1C1C1C" BorderThickness="1" CornerRadius="16" Padding="16">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Nearby Discovered Devices" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />
                                    
                                    <!-- Direct Connect Bar -->
                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                        <TextBlock Text="Or Connect directly by IP:" Foreground="#777777" FontSize="11" Margin="0,0,0,5" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" CornerRadius="12" Background="#141414" BorderBrush="#262626" BorderThickness="1">
                                                <TextBox x:Name="TxtManualIp" Text="192.168." Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" Padding="10,8" FontSize="12" />
                                            </Border>
                                            <Button Grid.Column="1" Content="Add" Click="AddManualDevice_Click" Style="{StaticResource KmGlassButton}" Height="36" Padding="14,0" Margin="8,0,0,0" />
                                        </Grid>
                                    </StackPanel>

                                    <!-- Devices ListBox -->
                                    <ListBox x:Name="ListDevices" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ListDevices_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <!-- Device Card (12px Radius) -->
                                                <Border Margin="0,0,0,6" Background="#111111" BorderBrush="#222222" BorderThickness="1" CornerRadius="12" Padding="12,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                                            <Path Data="M17 1H7c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-2-2-2zm0 18H7V5h10v14z" Fill="#888888" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DeviceName}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" />
                                                            <TextBlock Text="{Binding IpAddress}" Foreground="#888888" FontSize="11" />
                                                            <!-- Transport Capability Badges -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                <Border Background="#1A1108" BorderBrush="#FF5A00" BorderThickness="1" CornerRadius="5" Padding="5,1" Margin="0,0,4,0">
                                                                    <TextBlock Text="Wi-Fi [Best]" Foreground="#FF8A00" FontSize="9" FontWeight="SemiBold" />
                                                                </Border>
                                                                <Border Background="#0C171F" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="5" Padding="5,1" Margin="0,0,4,0">
                                                                    <TextBlock Text="Direct" Foreground="#38BDF8" FontSize="9" />
                                                                </Border>
                                                                <Border Background="#0F172A" BorderBrush="#60A5FA" BorderThickness="1" CornerRadius="5" Padding="5,1">
                                                                    <TextBlock Text="BT" Foreground="#60A5FA" FontSize="9" />
                                                                </Border>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <!-- Platform Badge (8px Radius) -->
                                                        <Border Grid.Column="2" Background="#140D00" BorderBrush="#FF5A00" BorderThickness="1" CornerRadius="8" Padding="8,4" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Platform}" Foreground="#FF8A00" FontSize="10" FontWeight="SemiBold" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- Multi-Transport Capability & Selection Pipeline (16px Radius) -->
                        <Border Grid.Row="2" Margin="0,14,0,0" Background="#0C0C0C" BorderBrush="#222222" BorderThickness="1" CornerRadius="16" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Transport Capability Check" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" />
                                        <Border Background="#1C1000" BorderBrush="#FF5A00" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="10,0,0,0">
                                            <TextBlock x:Name="TxtBestTransportBadge" Text="Best: Wi-Fi LAN (50–120+ MB/s)" Foreground="#FF8A00" FontSize="10" FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Pipeline: Nearby Device ➔ Capability Check ➔ Select Best (Wi-Fi / Direct / BT) ➔ Authenticate (PIN) ➔ Transfer" Foreground="#777777" FontSize="11" Margin="0,3,0,0" />
                                </StackPanel>

                                <!-- Transport Selector Buttons (Auto Best, Wi-Fi LAN, Wi-Fi Direct, Bluetooth) -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnTransportAuto" Content="Auto (Best)" Click="TransportSelect_Click" Tag="AUTO" Style="{StaticResource KmPrimaryButton}" Height="30" Padding="12,0" FontSize="11" Margin="0,0,6,0" />
                                    <Button x:Name="BtnTransportWifi" Content="Wi-Fi LAN" Click="TransportSelect_Click" Tag="WIFI_LAN" Style="{StaticResource KmGlassButton}" Height="30" Padding="10,0" FontSize="11" Margin="0,0,6,0" />
                                    <Button x:Name="BtnTransportDirect" Content="Direct" Click="TransportSelect_Click" Tag="WIFI_DIRECT" Style="{StaticResource KmGlassButton}" Height="30" Padding="10,0" FontSize="11" Margin="0,0,6,0" />
                                    <Button x:Name="BtnTransportBt" Content="Bluetooth" Click="TransportSelect_Click" Tag="BLUETOOTH" Style="{StaticResource KmGlassButton}" Height="30" Padding="10,0" FontSize="11" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Active Progress Panel (16px Radius, Orange Glow) -->
                        <Border x:Name="PanelProgress" Grid.Row="3" Margin="0,16,0,0" Background="#0C0C0C" BorderBrush="#FF5A00" BorderThickness="1.5" CornerRadius="16" Padding="16" Visibility="Collapsed">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF5A00" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="TxtProgressTitle" Text="Transferring..." Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" />
                                        <TextBlock x:Name="TxtActiveTransport" Text="Active Transport: Wi-Fi LAN [Best Verified]" Foreground="#FF8A00" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,2" />
                                        <TextBlock x:Name="TxtProgressDetail" Text="0 MB / 0 MB (0%) · 0.0 MB/s" Foreground="#AAAAAA" FontSize="12" Margin="0,2,0,8" />
                                    </StackPanel>
                                    <Button x:Name="BtnCancelTransfer" Grid.Column="1" Content="Cancel" Click="CancelTransfer_Click" Style="{StaticResource KmGlassButton}" Height="34" Padding="14,0" Foreground="#FF5555" BorderBrush="#552222" />
                                </Grid>
                                <ProgressBar x:Name="ProgressBarTransfer" Grid.Row="1" Height="10" Minimum="0" Maximum="100" Value="0" Background="#1A1A1A" Foreground="#FF5A00" BorderThickness="0" />
                            </Grid>
                        </Border>

                        <!-- Action Bar (16px Radius) -->
                        <Border Grid.Row="4" Margin="0,16,0,0" Background="#0A0A0A" BorderBrush="#1C1C1C" BorderThickness="1" CornerRadius="16" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtStatus" Text="Ready to transfer · UDP Discovery Active (Port 54123)" Foreground="#FF8A00" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock x:Name="TxtFileInfo" Text="0 files staged (0 B) · Select a device on the right" Foreground="#777777" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button x:Name="BtnTransfer" Grid.Column="1" Content="Transfer Files" Click="TransferNow_Click" Style="{StaticResource KmPrimaryButton}" Height="46" Padding="26,0" FontSize="14" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- TAB 2: Receive View (20px Radius) -->
                    <Grid x:Name="ViewReceive" Visibility="Collapsed">
                        <Border Background="#080808" BorderBrush="#1C1C1C" BorderThickness="1" CornerRadius="20" Padding="28">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="540">
                                <Border Width="68" Height="68" CornerRadius="34" Background="#140D00" BorderBrush="#FF5A00" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,18">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#FF5A00" BlurRadius="18" ShadowDepth="0" Opacity="0.4"/>
                                    </Border.Effect>
                                    <Path Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" Fill="#FF8A00" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Receive Mode Active" Foreground="#FFFFFF" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" />
                                <TextBlock Text="Listening for incoming P2P transfers on TCP port 54124" Foreground="#888888" FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,22" />
                                
                                <Border Background="#111111" BorderBrush="#222222" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="Download Directory:" Foreground="#AAAAAA" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock x:Name="TxtDownloadDir" Text="C:\Users\...\Downloads\KnowToMigrate" Foreground="#FF8A00" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,12" />
                                        <Button Content="Change Folder" Click="ChangeDownloadFolder_Click" Style="{StaticResource KmGlassButton}" Height="34" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#140D00" BorderBrush="#FF5A00" BorderThickness="1" CornerRadius="12" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Transfer Security Guarantee" Foreground="#FF8A00" FontWeight="Bold" FontSize="13" />
                                        <TextBlock Text="• Anti-path traversal sanitization enabled&#x0a;• Pre-allocation and free disk space pre-check&#x0a;• SHA-256 hash verified before finalization&#x0a;• Resumable chunked streaming via .part files" Foreground="#CCCCCC" FontSize="12" Margin="0,6,0,0" LineHeight="18" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- TAB 3: Migration Wizard (20px Radius, 15% Master Logo Badge) -->
                    <Grid x:Name="ViewMigration" Visibility="Collapsed">
                        <Border Background="#080808" BorderBrush="#1C1C1C" BorderThickness="1" CornerRadius="20" Padding="28">
                            <DockPanel>
                                <!-- Top Header with 80x80 Logo Badge (15% Corner Radius = 12) -->
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Master KM Logo with 15% Corner Radius in Windows -->
                                    <Border Grid.Column="0" CornerRadius="12" Width="80" Height="80" BorderBrush="#FF5A00" BorderThickness="2" Background="#000000" SnapsToDevicePixels="True" Margin="0,0,20,0">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#FF5A00" BlurRadius="22" ShadowDepth="0" Opacity="0.45"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Border CornerRadius="12">
                                                <Border.Background>
                                                    <ImageBrush x:Name="LogoMigrationBrush" Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                            <Border CornerRadius="11,11,0,0" Height="36" VerticalAlignment="Top" Background="{StaticResource GlossySheenBrush}" Opacity="0.6"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="PC Migration Wizard" Foreground="#FFFFFF" FontWeight="Bold" FontSize="22" />
                                        <TextBlock Text="Seamlessly clone and migrate documents, desktop, and media to another PC or phone." Foreground="#888888" FontSize="13" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                                    <Button Content="Scan Selected Items" Click="ScanMigration_Click" Style="{StaticResource KmGlassButton}" Margin="0,0,12,0" />
                                    <Button Content="Start Migration" Click="StartMigration_Click" Style="{StaticResource KmPrimaryButton}" />
                                </StackPanel>

                                <Border Background="#0E0E0E" BorderBrush="#1C1C1C" BorderThickness="1" CornerRadius="16" Padding="20">
                                    <UniformGrid Columns="2">
                                        <CheckBox x:Name="ChkDocs" Content="Personal Documents (My Documents)" Foreground="#FFFFFF" FontSize="13" Margin="0,12" IsChecked="True" />
                                        <CheckBox x:Name="ChkDesktop" Content="Desktop Files &amp; Shortcuts" Foreground="#FFFFFF" FontSize="13" Margin="0,12" IsChecked="True" />
                                        <CheckBox x:Name="ChkPictures" Content="Pictures &amp; Photos Album" Foreground="#FFFFFF" FontSize="13" Margin="0,12" IsChecked="True" />
                                        <CheckBox x:Name="ChkDownloads" Content="Downloads Folder" Foreground="#FFFFFF" FontSize="13" Margin="0,12" IsChecked="False" />
                                        <CheckBox x:Name="ChkMusic" Content="Music &amp; Audio Library" Foreground="#FFFFFF" FontSize="13" Margin="0,12" IsChecked="False" />
                                        <CheckBox x:Name="ChkVideos" Content="Videos &amp; Screen Recordings" Foreground="#FFFFFF" FontSize="13" Margin="0,12" IsChecked="False" />
                                    </UniformGrid>
                                </Border>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- TAB 4: History (20px Radius) -->
                    <Grid x:Name="ViewHistory" Visibility="Collapsed">
                        <Border Background="#080808" BorderBrush="#1C1C1C" BorderThickness="1" CornerRadius="20" Padding="22">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Transfer History &amp; Cryptographic Checkpoints" Foreground="#FFFFFF" FontWeight="Bold" FontSize="16" Margin="0,0,0,16" />
                                <ListBox x:Name="ListHistory" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8" Background="#111111" BorderBrush="#222222" BorderThickness="1" CornerRadius="12" Padding="14,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding CurrentFileName}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" />
                                                        <TextBlock Text="{Binding PeerName}" Foreground="#888888" FontSize="11" />
                                                    </StackPanel>
                                                    <!-- SHA-256 Verified Badge (8px Radius) -->
                                                    <Border Grid.Column="1" Background="#0D2614" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="8" Padding="8,4" VerticalAlignment="Center">
                                                        <TextBlock Text="SHA-256 VERIFIED" Foreground="#22C55E" FontSize="10" FontWeight="Bold" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
