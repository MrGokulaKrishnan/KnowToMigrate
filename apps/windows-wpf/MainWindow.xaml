<Window x:Class="KnowToMigrate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KnowToMigrate — Move Anything. Anywhere. Seamlessly."
        Height="760" Width="1100"
        MinHeight="650" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#000000"
        Icon="Assets/KnowToMigrate.ico">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#060606" BorderBrush="#141414" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,20,16,16">
                <!-- Top Brand -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="8" Width="36" Height="36" Background="#141414" BorderBrush="#FF5A00" BorderThickness="1">
                            <Image Source="Assets/logo.jpg" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="KnowToMigrate" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15" />
                            <TextBlock Text="Standalone v1.0.0" Foreground="#888888" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                    
                    <Border Margin="0,14,0,0" Background="#140A00" BorderBrush="#FF5A00" BorderThickness="1" CornerRadius="6" Padding="8,4">
                        <TextBlock x:Name="TxtCoreStatus" Text="● P2P Engine Active (Port 54124)" Foreground="#FF8A00" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <!-- Footer status -->
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="AES-256-GCM · SHA-256 Verified" Foreground="#555555" FontSize="11" />
                    <TextBlock Text="Local Offline P2P Transfer" Foreground="#555555" FontSize="11" />
                    <TextBlock x:Name="TxtLocalInfo" Text="Device: ktm-win" Foreground="#444444" FontSize="10" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Navigation Buttons -->
                <StackPanel DockPanel.Dock="Top">
                    <Button x:Name="BtnNavHome" Content="⚡ Quick Share" Click="Nav_Click" Tag="Home" Margin="0,0,0,6" Height="42" Background="#1A0D00" Foreground="#FF8A00" BorderBrush="#FF5A00" BorderThickness="1" FontWeight="SemiBold" HorizontalContentAlignment="Left" Padding="14,0" Cursor="Hand" />
                    <Button x:Name="BtnNavReceive" Content="📥 Receive Files" Click="Nav_Click" Tag="Receive" Margin="0,0,0,6" Height="42" Background="Transparent" Foreground="#CCCCCC" BorderThickness="0" HorizontalContentAlignment="Left" Padding="14,0" Cursor="Hand" />
                    <Button x:Name="BtnNavMigration" Content="🔄 PC Migration Wizard" Click="Nav_Click" Tag="Migration" Margin="0,0,0,6" Height="42" Background="Transparent" Foreground="#CCCCCC" BorderThickness="0" HorizontalContentAlignment="Left" Padding="14,0" Cursor="Hand" />
                    <Button x:Name="BtnNavHistory" Content="📋 History &amp; Checkpoints" Click="Nav_Click" Tag="History" Margin="0,0,0,6" Height="42" Background="Transparent" Foreground="#CCCCCC" BorderThickness="0" HorizontalContentAlignment="Left" Padding="14,0" Cursor="Hand" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Margin="28">
            <!-- TAB 1: Quick Share (Send & Devices) -->
            <Grid x:Name="ViewHome" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Move Anything. Anywhere. Seamlessly." FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" />
                    <TextBlock Text="Ultra-fast encrypted local transfer over Wi-Fi without internet or cloud." FontSize="13" Foreground="#888888" Margin="0,2,0,0" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- Drag & Drop Zone -->
                    <Border Grid.Column="0" Margin="0,0,14,0" AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver"
                            Background="#080808" BorderBrush="#222222" BorderThickness="2" CornerRadius="16" Padding="20">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="56" Height="56" CornerRadius="28" Background="#140D00" BorderBrush="#FF5A00" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,14">
                                <TextBlock Text="⚡" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Drag and drop files or folders" Foreground="#FFFFFF" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Streaming 256 KB chunks · SHA-256 verification · Resumable" Foreground="#666666" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,16" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Choose Files" Click="ChooseFiles_Click" Background="#FF5A00" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="16,8" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand" />
                                <Button Content="Choose Folder" Click="ChooseFolder_Click" Background="#181818" Foreground="#CCCCCC" FontWeight="SemiBold" Padding="16,8" BorderThickness="1" BorderBrush="#333333" Cursor="Hand" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Nearby Devices Discovery Panel -->
                    <Border Grid.Column="1" Background="#080808" BorderBrush="#1C1C1C" BorderThickness="1" CornerRadius="16" Padding="16">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="📡 Nearby Discovered Devices" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
                            
                            <!-- Direct Connect Bar -->
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <TextBlock Text="Or Connect directly by IP:" Foreground="#777777" FontSize="11" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtManualIp" Grid.Column="0" Text="192.168.1." Background="#141414" Foreground="#FFFFFF" BorderBrush="#333333" Padding="8,4" FontSize="12" />
                                    <Button Grid.Column="1" Content="Add" Click="AddManualDevice_Click" Background="#262626" Foreground="#FF8A00" FontWeight="SemiBold" Padding="12,4" Margin="6,0,0,0" BorderThickness="0" Cursor="Hand" />
                                </Grid>
                            </StackPanel>

                            <!-- Devices ListBox -->
                            <ListBox x:Name="ListDevices" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Background="#111111" BorderBrush="#222222" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="📱" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DeviceName}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" />
                                                    <TextBlock Text="{Binding IpAddress}" Foreground="#888888" FontSize="11" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Background="#140D00" BorderBrush="#FF5A00" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Platform}" Foreground="#FF8A00" FontSize="10" FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- Active Progress Panel (Visible during transfer) -->
                <Border x:Name="PanelProgress" Grid.Row="2" Margin="0,14,0,0" Background="#0C0C0C" BorderBrush="#FF5A00" BorderThickness="1" CornerRadius="12" Padding="14" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="TxtProgressTitle" Text="Transferring to Android..." Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" />
                                <TextBlock x:Name="TxtProgressDetail" Text="0 MB / 0 MB (0%) · 0.0 MB/s" Foreground="#AAAAAA" FontSize="12" Margin="0,2,0,6" />
                            </StackPanel>
                            <Button x:Name="BtnCancelTransfer" Grid.Column="1" Content="Cancel" Click="CancelTransfer_Click" Background="#331111" Foreground="#FF5555" BorderBrush="#552222" BorderThickness="1" Padding="12,4" FontWeight="SemiBold" Cursor="Hand" />
                        </Grid>
                        <ProgressBar x:Name="ProgressBarTransfer" Grid.Row="1" Height="8" Minimum="0" Maximum="100" Value="0" Background="#1A1A1A" Foreground="#FF5A00" BorderThickness="0" />
                    </Grid>
                </Border>

                <!-- Action Bar -->
                <Border Grid.Row="3" Margin="0,14,0,0" Background="#0A0A0A" BorderBrush="#1C1C1C" BorderThickness="1" CornerRadius="12" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtStatus" Text="Ready to transfer · UDP Discovery Active (Port 54123)" Foreground="#FF8A00" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock x:Name="TxtFileInfo" Text="0 files staged (0 B) · Select a device on the right" Foreground="#777777" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button x:Name="BtnTransfer" Grid.Column="1" Content="Transfer Now →" Click="TransferNow_Click" Background="#FF5A00" Foreground="#FFFFFF" FontWeight="Bold" Padding="20,10" BorderThickness="0" Cursor="Hand" />
                    </Grid>
                </Border>
            </Grid>

            <!-- TAB 2: Receive View -->
            <Grid x:Name="ViewReceive" Visibility="Collapsed">
                <Border Background="#080808" BorderBrush="#1C1C1C" BorderThickness="1" CornerRadius="16" Padding="24">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500">
                        <Border Width="64" Height="64" CornerRadius="32" Background="#140D00" BorderBrush="#FF5A00" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="📥" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Receive Mode Active" Foreground="#FFFFFF" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" />
                        <TextBlock Text="Listening for incoming P2P transfers on TCP port 54124" Foreground="#888888" FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,20" />
                        
                        <Border Background="#111111" BorderBrush="#222222" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Download Directory:" Foreground="#AAAAAA" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock x:Name="TxtDownloadDir" Text="C:\Users\...\Downloads\KnowToMigrate" Foreground="#FF8A00" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10" />
                                <Button Content="Change Folder" Click="ChangeDownloadFolder_Click" Background="#222222" Foreground="#FFFFFF" Padding="12,6" BorderThickness="0" HorizontalAlignment="Left" Cursor="Hand" />
                            </StackPanel>
                        </Border>

                        <Border Background="#140D00" BorderBrush="#FF5A00" BorderThickness="1" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <TextBlock Text="🛡️ Transfer Security Guarantee" Foreground="#FF8A00" FontWeight="Bold" FontSize="12" />
                                <TextBlock Text="• Anti-path traversal sanitization enabled&#x0a;• Pre-allocation and free disk space pre-check&#x0a;• SHA-256 hash verified before finalization&#x0a;• Resumable chunked streaming via .part files" Foreground="#CCCCCC" FontSize="11" Margin="0,4,0,0" LineHeight="16" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- TAB 3: Migration Wizard -->
            <Grid x:Name="ViewMigration" Visibility="Collapsed">
                <Border Background="#080808" BorderBrush="#1C1C1C" BorderThickness="1" CornerRadius="16" Padding="24">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
                            <TextBlock Text="🔄 Complete PC Migration Wizard" Foreground="#FFFFFF" FontWeight="Bold" FontSize="20" />
                            <TextBlock Text="Seamlessly clone and migrate documents, desktop, and media to another PC or phone." Foreground="#888888" FontSize="13" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="Scan Selected Items" Click="ScanMigration_Click" Background="#222222" Foreground="#FFFFFF" Padding="16,8" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" />
                            <Button Content="Start Migration Transfer →" Click="StartMigration_Click" Background="#FF5A00" Foreground="#FFFFFF" FontWeight="Bold" Padding="18,8" BorderThickness="0" Cursor="Hand" />
                        </StackPanel>

                        <UniformGrid Columns="2" Margin="0,10">
                            <CheckBox x:Name="ChkDocs" Content="📄 Personal Documents (My Documents)" Foreground="#FFFFFF" FontSize="13" Margin="0,10" IsChecked="True" />
                            <CheckBox x:Name="ChkDesktop" Content="🖥️ Desktop Files &amp; Shortcuts" Foreground="#FFFFFF" FontSize="13" Margin="0,10" IsChecked="True" />
                            <CheckBox x:Name="ChkPictures" Content="🖼️ Pictures &amp; Photos Album" Foreground="#FFFFFF" FontSize="13" Margin="0,10" IsChecked="True" />
                            <CheckBox x:Name="ChkDownloads" Content="📥 Downloads Folder" Foreground="#FFFFFF" FontSize="13" Margin="0,10" IsChecked="False" />
                            <CheckBox x:Name="ChkMusic" Content="🎵 Music &amp; Audio Library" Foreground="#FFFFFF" FontSize="13" Margin="0,10" IsChecked="False" />
                            <CheckBox x:Name="ChkVideos" Content="🎬 Videos &amp; Screen Recordings" Foreground="#FFFFFF" FontSize="13" Margin="0,10" IsChecked="False" />
                        </UniformGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- TAB 4: History -->
            <Grid x:Name="ViewHistory" Visibility="Collapsed">
                <Border Background="#080808" BorderBrush="#1C1C1C" BorderThickness="1" CornerRadius="16" Padding="20">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="📋 Transfer History &amp; Cryptographic Checkpoints" Foreground="#FFFFFF" FontWeight="Bold" FontSize="16" Margin="0,0,0,14" />
                        <ListBox x:Name="ListHistory" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Background="#111111" BorderBrush="#222222" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding CurrentFileName}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="{Binding PeerName}" Foreground="#888888" FontSize="11" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#0D2614" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="✓ SHA-256 VERIFIED" Foreground="#22C55E" FontSize="10" FontWeight="Bold" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
