                                            <TextBlock Text="Visible to nearby Android and Windows devices during discovery" Foreground="#777777" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <TextBox x:Name="TxtSettingsDeviceName" Grid.Column="1" Width="200" Height="32" Background="#141414" Foreground="#FFFFFF" BorderBrush="#333333" Padding="8,4" FontSize="12" VerticalContentAlignment="Center" LostFocus="TxtSettingsDeviceName_LostFocus" />
                                    </Grid>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Default Receive Folder" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock x:Name="TxtSettingsReceiveFolder" Text="Downloads \ KnowToMigrate" Foreground="#777777" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="400" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Change Folder" Click="BtnSettingsChangeFolder_Click" Style="{StaticResource KmGlassButton}" MinHeight="32" Padding="14,4" FontSize="12" VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Require Security PIN" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Require a 6-digit cryptographic PIN verification for incoming transfers" Foreground="#777777" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox x:Name="ChkRequirePin" Grid.Column="1" IsChecked="True" Checked="ChkRequirePin_Changed" Unchecked="ChkRequirePin_Changed" VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Auto-Accept Trusted Devices" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Automatically accept file transfers from paired and trusted devices" Foreground="#777777" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox x:Name="ChkAutoAcceptTrusted" Grid.Column="1" IsChecked="False" Checked="ChkAutoAcceptTrusted_Changed" Unchecked="ChkAutoAcceptTrusted_Changed" VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Minimize to System Tray" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Keep Pluto Engine running in notification area when the window is minimized" Foreground="#777777" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox x:Name="ChkMinimizeToTray" Grid.Column="1" IsChecked="True" Checked="ChkMinimizeToTray_Changed" Unchecked="ChkMinimizeToTray_Changed" VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Transfer Audio Chimes" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Synthesize gentle harmonic chimes upon transfer start, completion, and failure" Foreground="#777777" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox x:Name="ChkSoundEffects" Grid.Column="1" IsChecked="True" Checked="ChkSoundEffects_Changed" Unchecked="ChkSoundEffects_Changed" VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Windows Explorer Context Menu" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="Right-click any file or folder in File Explorer to 'Send with KnowToMigrate'" Foreground="#777777" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <CheckBox x:Name="ChkShellContextMenu" Grid.Column="1" IsChecked="True" Checked="ChkShellContextMenu_Changed" Unchecked="ChkShellContextMenu_Changed" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- About & Security Card (Prompt 42) -->
                            <Border Background="#0C0C0C" BorderBrush="#1F1F1F" BorderThickness="1" CornerRadius="18" Padding="24">
                                <StackPanel>
                                    <TextBlock Text="About KnowToMigrate" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15" Margin="0,0,0,12" />

                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Product Tagline" Foreground="#777777" FontSize="13" />
                                        <TextBlock Text="Move Anything. Anywhere. Seamlessly." Foreground="#D4D4D4" FontSize="13" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Application Version" Foreground="#777777" FontSize="13" />
                                        <TextBlock Text="v1.0.0 (Production Release)" Foreground="#FF8A00" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Transfer Engine" Foreground="#777777" FontSize="13" />
                                        <TextBlock Text="Pluto Engine (Pluto v2 Multi-Transport)" Foreground="#D4D4D4" FontSize="13" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Cryptography" Foreground="#777777" FontSize="13" />
                                        <TextBlock Text="AES-256-GCM + X25519 + SHA-256" Foreground="#22C55E" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Official Website" Foreground="#777777" FontSize="13" />
                                        <TextBlock Text="https://knowtomigrate.web.app" Foreground="#FF8A00" FontSize="13" Cursor="Hand" HorizontalAlignment="Right" MouseLeftButtonUp="HyperlinkWebsite_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- MODAL OVERLAY: Premium Received-File Completion Card -->
        <Grid x:Name="ModalReceiveCompletion" Grid.RowSpan="2" Background="#DD000000" Visibility="Collapsed" Panel.ZIndex="1000">
            <!-- Centered Card -->
            <Border Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#0D0D0D" BorderBrush="#26FFFFFF" BorderThickness="1.5" CornerRadius="24" Padding="28">
                <Border.Effect>
                    <DropShadowEffect Color="#FF5A00" BlurRadius="36" ShadowDepth="0" Opacity="0.35"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Top Close Button -->
                    <Button Grid.Row="0" HorizontalAlignment="Right" Click="BtnCloseReceiveModal_Click" Style="{StaticResource KmGlassButton}" Width="32" Height="32" Padding="0" ToolTip="Dismiss">
                        <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" Fill="#888888" Width="14" Height="14" Stretch="Uniform" />
                    </Button>

                    <!-- Row 1: Verification Ring & Checkmark -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Border Width="76" Height="76" CornerRadius="38" Background="#0E2818" BorderBrush="#22C55E" BorderThickness="2" HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#22C55E" BlurRadius="24" ShadowDepth="0" Opacity="0.5"/>
                            </Border.Effect>
                            <Path Data="{StaticResource KmCheckIconGeometry}" Stroke="#22C55E" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="File Received" Foreground="#FFFFFF" FontWeight="ExtraBold" FontSize="20" HorizontalAlignment="Center" Margin="0,14,0,2" />
                        <TextBlock Text="Verified · End-to-End Encrypted (AES-256-GCM)" Foreground="#22C55E" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Row 2: File Preview Card -->
                    <Border Grid.Row="2" Background="#141414" BorderBrush="#222222" BorderThickness="1" CornerRadius="14" Padding="16,14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- File Icon Badge -->
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#1A0D00" BorderBrush="#FF5A00" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                <Path x:Name="IconReceivedFile" Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" Fill="#FF8A00" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtReceivedFileName" Text="Screenshot_20260928.jpg" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="TxtReceivedFileSize" Text="8.4 MB" Foreground="#888888" FontSize="12" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 3: Metadata (Sender + Destination) -->
                    <Grid Grid.Row="3" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Sender Chip -->
                        <Border Grid.Column="0" Background="#111111" BorderBrush="#1C1C1C" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Received from:" Foreground="#777777" FontSize="10" FontWeight="SemiBold" />
                                <TextBlock x:Name="TxtReceivedSender" Text="Galaxy S24 Ultra" Foreground="#DDDDDD" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <!-- Destination Chip -->
                        <Border Grid.Column="1" Background="#111111" BorderBrush="#1C1C1C" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Saved to:" Foreground="#777777" FontSize="10" FontWeight="SemiBold" />
                                <TextBlock x:Name="TxtReceivedSavedTo" Text="Downloads / KnowToMigrate" Foreground="#DDDDDD" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 4: Action Buttons (Open, Show in Folder, Copy) -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Open" Click="BtnOpenReceivedFile_Click" Style="{StaticResource KmPrimaryButton}" MinHeight="40" Margin="0,0,6,0" FontSize="12" FontWeight="SemiBold" />
                        <Button Grid.Column="1" Content="Show in Folder" Click="BtnShowInFolder_Click" Style="{StaticResource KmGlassButton}" MinHeight="40" Margin="3,0,3,0" FontSize="11" />
                        <Button Grid.Column="2" Content="Copy" Click="BtnCopyReceivedFile_Click" Style="{StaticResource KmGlassButton}" MinHeight="40" Margin="6,0,0,0" FontSize="11" />
                    </Grid>

                    <!-- Row 5: Feedback label -->
                    <StackPanel x:Name="PanelCopyFeedback" Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed">
                        <Path Data="{StaticResource KmCheckIconGeometry}" Stroke="#22C55E" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock x:Name="TxtCopyFeedback" Text="Copied to clipboard" Foreground="#22C55E" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- MODAL OVERLAY: Premium Incoming Transfer Acceptance Dialog (Section 13 & 14) -->
        <Grid x:Name="ModalIncomingTransfer" Grid.RowSpan="2" Background="#EE000000" Visibility="Collapsed" Panel.ZIndex="1100">
            <!-- Centered Glass Card (15% Corner Radius = 24 on 460px width) -->
            <Border Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#0C0C0C" BorderBrush="#FF5A00" BorderThickness="1.5" CornerRadius="24" Padding="28">
                <Border.Effect>
                    <DropShadowEffect Color="#FF5A00" BlurRadius="42" ShadowDepth="0" Opacity="0.45"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Top Brand Header & Close Button -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border CornerRadius="5" Width="22" Height="22" Background="#000000" BorderBrush="#FF5A00" BorderThickness="1" Margin="0,0,8,0" SnapsToDevicePixels="True" ClipToBounds="True">
                                <Image Source="Assets/logo.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="KnowToMigrate" Foreground="#FF8A00" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Click="BtnDeclineTransfer_Click" Style="{StaticResource KmGlassButton}" Width="30" Height="30" Padding="0" ToolTip="Decline">
                            <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" Fill="#888888" Width="12" Height="12" Stretch="Uniform" />
                        </Button>
                    </Grid>

                    <!-- Row 1: Title -->
                    <TextBlock Grid.Row="1" Text="Incoming Transfer" Foreground="#FFFFFF" FontWeight="ExtraBold" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,18" />

                    <!-- Row 2: Device Icon & Identification -->
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <Border Width="72" Height="72" CornerRadius="36" Background="#1A0D00" BorderBrush="#FF5A00" BorderThickness="2" HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF5A00" BlurRadius="22" ShadowDepth="0" Opacity="0.5"/>
                            </Border.Effect>
                            <!-- Mobile phone SVG icon -->
                            <Path Data="M17 1H7c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-2-2-2zm0 18H7V5h10v14z" Fill="#FF8A00" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="TxtIncomingDeviceName" Text="Galaxy S24 Ultra" Foreground="#FFFFFF" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Margin="0,12,0,4" />
                        <Border Background="#141414" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="6" Padding="8,2" HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtIncomingPlatform" Text="Android" Foreground="#888888" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="Wants to send files to this PC" Foreground="#AAAAAA" FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- Row 3: Connection & Transport Details -->
                    <Border Grid.Row="3" Background="#111111" BorderBrush="#222222" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8" Height="8" Fill="#22C55E" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtIncomingTransport" Grid.Column="1" Text="● Wi-Fi LAN · Verified Connection" Foreground="#DDDDDD" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Row 4: Security Code (Authentication PIN) -->
                    <Border Grid.Row="4" Background="#140A00" BorderBrush="#FF5A00" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,24">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="SECURITY CODE" Foreground="#888888" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4" />
                            <TextBlock x:Name="TxtIncomingPin" Text="354 446" Foreground="#FF8A00" FontSize="24" FontWeight="ExtraBold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Row 5: Action Buttons (Decline / Accept Transfer) -->
                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Decline" Click="BtnDeclineTransfer_Click" Style="{StaticResource KmGlassButton}" MinHeight="44" Padding="16,10" Margin="0,0,8,0" Foreground="#FF5555" BorderBrush="#442222" FontSize="13" />
                        <Button Grid.Column="1" Content="Accept Transfer" Click="BtnAcceptTransfer_Click" Style="{StaticResource KmPrimaryButton}" MinHeight="44" Padding="20,10" Margin="8,0,0,0" FontSize="13" FontWeight="Bold" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Border>
</Window>
