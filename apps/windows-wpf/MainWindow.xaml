<Window x:Class="KnowToMigrate.MainWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="KnowToMigrate"

        Icon="Assets/KnowToMigrate.ico"

        Width="1040" Height="660"

        MinWidth="960" MinHeight="580"

        WindowStartupLocation="Manual"

        WindowStyle="None"

        ResizeMode="CanResize"

        Background="#000000"

        Foreground="#F5F5F5"

        StateChanged="MainWindow_StateChanged">



    <!-- Native Windows 11 Chrome with full hardware acceleration -->

    <WindowChrome.WindowChrome>

        <WindowChrome CaptionHeight="38"

                      ResizeBorderThickness="6"

                      GlassFrameThickness="0"

                      CornerRadius="0"

                      UseAeroCaptionButtons="False" />

    </WindowChrome.WindowChrome>



    <Window.Resources>

        <!-- Storyboard for animated pulsing radar rings on Receive screen -->

        <Storyboard x:Key="RadarPulseAnimation" RepeatBehavior="Forever">

            <DoubleAnimation Storyboard.TargetName="RadarRing1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.25" To="1.0" Duration="0:0:2.6" />

            <DoubleAnimation Storyboard.TargetName="RadarRing1" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.25" To="1.0" Duration="0:0:2.6" />

            <DoubleAnimation Storyboard.TargetName="RadarRing1" Storyboard.TargetProperty="Opacity" From="0.9" To="0.0" Duration="0:0:2.6" />



            <DoubleAnimation Storyboard.TargetName="RadarRing2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.25" To="1.0" Duration="0:0:2.6" BeginTime="0:0:0.87" />

            <DoubleAnimation Storyboard.TargetName="RadarRing2" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.25" To="1.0" Duration="0:0:2.6" BeginTime="0:0:0.87" />

            <DoubleAnimation Storyboard.TargetName="RadarRing2" Storyboard.TargetProperty="Opacity" From="0.9" To="0.0" Duration="0:0:2.6" BeginTime="0:0:0.87" />



            <DoubleAnimation Storyboard.TargetName="RadarRing3" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.25" To="1.0" Duration="0:0:2.6" BeginTime="0:0:1.73" />

            <DoubleAnimation Storyboard.TargetName="RadarRing3" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.25" To="1.0" Duration="0:0:2.6" BeginTime="0:0:1.73" />

            <DoubleAnimation Storyboard.TargetName="RadarRing3" Storyboard.TargetProperty="Opacity" From="0.9" To="0.0" Duration="0:0:2.6" BeginTime="0:0:1.73" />

                </Storyboard>



        <!-- Storyboard for smooth moving data particles during transfer -->

        <Storyboard x:Key="DataParticleAnimation" RepeatBehavior="Forever">

            <DoubleAnimation Storyboard.TargetName="Particle1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="140" Duration="0:0:1.4" />

            <DoubleAnimation Storyboard.TargetName="Particle2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="140" Duration="0:0:1.4" BeginTime="0:0:0.46" />

            <DoubleAnimation Storyboard.TargetName="Particle3" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="140" Duration="0:0:1.4" BeginTime="0:0:0.92" />

        </Storyboard>

    </Window.Resources>



    <Window.Triggers>

        <EventTrigger RoutedEvent="FrameworkElement.Loaded">

            <BeginStoryboard Storyboard="{StaticResource RadarPulseAnimation}" />

            <BeginStoryboard Storyboard="{StaticResource DataParticleAnimation}" />

        </EventTrigger>

    </Window.Triggers>



    <!-- Window Shell with dark AMOLED gradient background and border -->

    <Border x:Name="RootBorder" BorderBrush="#1E1E1E" BorderThickness="1" SnapsToDevicePixels="True" CornerRadius="20">

        <Border.Background>

            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">

                <GradientStop Color="#0D0D0D" Offset="0"/>

                <GradientStop Color="#040404" Offset="1"/>

            </LinearGradientBrush>

        </Border.Background>



        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="38" />

                <RowDefinition Height="*" />

            </Grid.RowDefinitions>



            <!-- ── Top Title Bar ──────────────────────────────────────── -->

            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto" />

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="Auto" />

                    </Grid.ColumnDefinitions>



                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">

                        <Image x:Name="ImgTitleBarLogo" Source="pack://application:,,,/KnowToMigrate;component/Assets/logo.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,8,0" VerticalAlignment="Center" />

                        <TextBlock Text="KnowToMigrate" Foreground="#8C8C8C" FontSize="12" VerticalAlignment="Center" />

                    </StackPanel>



                    <!-- Center Drag Zone -->

                    <Grid Grid.Column="1" Background="Transparent" />



                    <!-- Window Control Buttons (Minimize, Maximize/Restore, Close) -->

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"

                                WindowChrome.IsHitTestVisibleInChrome="True">

                        <Button x:Name="BtnMinimize" Click="BtnMinimize_Click" Style="{StaticResource KmTitleBarButton}" ToolTip="Minimize">

                            <Path Data="M0,0 L10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="10" Height="2" Stretch="None" />

                        </Button>

                        <Button x:Name="BtnMaximize" Click="BtnMaximize_Click" Style="{StaticResource KmTitleBarButton}" ToolTip="Maximize">

                            <Path x:Name="MaximizePath" Data="M0,0 H10 V10 H0 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Fill="Transparent" Width="10" Height="10" Stretch="None" />

                        </Button>

                        <Button x:Name="BtnClose" Click="BtnClose_Click" Style="{StaticResource KmTitleBarCloseButton}" ToolTip="Close">

                            <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Width="9" Height="9" Stretch="None" />

                        </Button>

                    </StackPanel>

                </Grid>

            </Border>



            <!-- ── App Body ──────────────────────────────────────────── -->

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto" />

                    <ColumnDefinition Width="*" />

                </Grid.ColumnDefinitions>



                <!-- Floating Glass Navigation Rail (Expandable on hover or pin) -->

                <Border x:Name="NavRailBorder" Grid.Column="0" Width="72" Margin="12,6,12,14" CornerRadius="24"

                        Background="#09FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"

                        VerticalAlignment="Stretch"

                        MouseEnter="NavRail_MouseEnter" MouseLeave="NavRail_MouseLeave">

                    <Border.Effect>

                        <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="8" Opacity="0.5" />

                    </Border.Effect>

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto" />

                            <RowDefinition Height="*" />

                        </Grid.RowDefinitions>



                        <!-- Top Monogram / Pin Toggle -->

                        <Border Grid.Row="0" Margin="0,14,0,10" HorizontalAlignment="Center">

                            <Button x:Name="BtnToggleRail" Click="BtnToggleRail_Click" Style="{StaticResource KmRailButton}" Width="48" Height="48" Margin="0" ToolTip="Toggle expanded rail">

                                <Border Width="38" Height="38" CornerRadius="11" ClipToBounds="True" Background="#14FFFFFF" BorderBrush="#33FF5A00" BorderThickness="1">

                                    <Image Source="pack://application:,,,/KnowToMigrate;component/Assets/logo.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="UniformToFill"/>

                                </Border>

                            </Button>

                        </Border>



                        <!-- Nav Buttons -->

                        <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center">

                            <Button x:Name="BtnNavHome" Tag="Home" Click="Nav_Click" Style="{StaticResource KmRailButton}" ToolTip="Home"

                                    Background="{StaticResource KmBrandGradient}">

                                <Button.Effect>

                                    <DropShadowEffect Color="#FF5A00" BlurRadius="16" ShadowDepth="0" Opacity="0.45"/>

                                </Button.Effect>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                    <Path x:Name="PathNavHome" Data="{StaticResource KmIconHome}" Stroke="#0A0A0A" StrokeThickness="2" Width="20" Height="20" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <TextBlock x:Name="TxtNavHome" Text="Home" FontSize="13" FontWeight="SemiBold" Foreground="#0A0A0A" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>

                                </StackPanel>

                            </Button>

                            <Button x:Name="BtnNavSend" Tag="Send" Click="Nav_Click" Style="{StaticResource KmRailButton}" ToolTip="Send">

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                    <Path x:Name="PathNavSend" Data="{StaticResource KmIconSend}" Stroke="#8C8C8C" StrokeThickness="2" Width="20" Height="20" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <TextBlock x:Name="TxtNavSend" Text="Send" FontSize="13" FontWeight="SemiBold" Foreground="#8C8C8C" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>

                                </StackPanel>

                            </Button>

                            <Button x:Name="BtnNavReceive" Tag="Receive" Click="Nav_Click" Style="{StaticResource KmRailButton}" ToolTip="Receive">

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                    <Path x:Name="PathNavReceive" Data="{StaticResource KmIconReceive}" Stroke="#8C8C8C" StrokeThickness="2" Width="20" Height="20" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <TextBlock x:Name="TxtNavReceive" Text="Receive" FontSize="13" FontWeight="SemiBold" Foreground="#8C8C8C" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>

                                </StackPanel>

                            </Button>

                            <Button x:Name="BtnNavMigration" Tag="Migration" Click="Nav_Click" Style="{StaticResource KmRailButton}" ToolTip="Move device">

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                    <Path x:Name="PathNavMigration" Data="{StaticResource KmIconMigrate}" Stroke="#8C8C8C" StrokeThickness="2" Width="20" Height="20" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <TextBlock x:Name="TxtNavMigration" Text="Move device" FontSize="13" FontWeight="SemiBold" Foreground="#8C8C8C" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>

                                </StackPanel>

                            </Button>

                            <Button x:Name="BtnNavHistory" Tag="History" Click="Nav_Click" Style="{StaticResource KmRailButton}" ToolTip="History">

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                    <Path x:Name="PathNavHistory" Data="{StaticResource KmIconHistory}" Stroke="#8C8C8C" StrokeThickness="2" Width="20" Height="20" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <TextBlock x:Name="TxtNavHistory" Text="History" FontSize="13" FontWeight="SemiBold" Foreground="#8C8C8C" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>

                                </StackPanel>

                            </Button>

                            <Button x:Name="BtnNavSettings" Tag="Settings" Click="Nav_Click" Style="{StaticResource KmRailButton}" ToolTip="Settings">

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                    <Path x:Name="PathNavSettings" Data="{StaticResource KmIconSettings}" Stroke="#8C8C8C" StrokeThickness="2" Width="20" Height="20" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <TextBlock x:Name="TxtNavSettings" Text="Settings" FontSize="13" FontWeight="SemiBold" Foreground="#8C8C8C" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>

                                </StackPanel>

                            </Button>

                        </StackPanel>

                    </Grid>

                </Border>



                <!-- Hidden elements needed for background services compatibility -->

                <Grid Visibility="Collapsed">

                    <Button x:Name="BtnNavWebShare" Tag="WebShare" Click="Nav_Click" />

                    <Button x:Name="BtnNavSecurity" Tag="Security" Click="Nav_Click" />

                    <TextBlock x:Name="TxtSidebarVersion" />

                    <TextBlock x:Name="TxtSidebarFooterVersion" />

                    <TextBlock x:Name="TxtUpdatedOn" />

                    <TextBlock x:Name="TxtCoreStatus" />

                    <TextBlock x:Name="TxtLocalInfo" />

                    <TextBlock x:Name="TxtCurrentVersionBadge" />

                    <TextBlock x:Name="TxtAboutDateUpdated" />

                    <TextBlock x:Name="TxtAvailableVersionTitle" />

                    <TextBlock x:Name="TxtAvailableVersionSize" />

                    <TextBlock x:Name="TxtReleaseNotes" />

                    <TextBlock x:Name="TxtDownloadProgressTitle" />

                    <TextBlock x:Name="TxtDownloadSpeedEta" />

                    <TextBlock x:Name="TxtDownloadBytesCount" />

                    <TextBlock x:Name="TxtUpdateStatusSummary" />

                    <TextBlock x:Name="TxtBestTransportBadge" />

                    <TextBlock x:Name="TxtDirection" />

                    <TextBlock x:Name="TxtDiagSpeed" />

                    <TextBlock x:Name="TxtDiagLatency" />

                    <TextBlock x:Name="TxtDiagMemory" />

                    <TextBlock x:Name="TxtDiagChunk" />

                    <TextBlock x:Name="TxtDiagTransport" />

                    <TextBlock x:Name="TxtWebShareFilesCount" />

                    <TextBlock x:Name="TxtWebShareStatusBadge" />

                    <TextBlock x:Name="TxtWebShareUrl" />

                    <TextBlock x:Name="TxtCopyFeedback" />

                    <TextBlock x:Name="TxtIncomingDeviceName" />

                    <TextBlock x:Name="TxtIncomingPlatform" />

                    <TextBlock x:Name="TxtIncomingTransport" />

                    <TextBlock x:Name="TxtReceivedFileName" />

                    <TextBlock x:Name="TxtReceivedFileSize" />

                    <TextBlock x:Name="TxtReceivedSender" />

                    <TextBlock x:Name="TxtReceivedSavedTo" />

                    <TextBlock x:Name="TxtMigrationScanCount" />

                    <TextBlock x:Name="TxtMigrationScanTitle" />

                    <Image x:Name="ImgWebShareQr" />

                    <Border Visibility="Collapsed">

                        <Border.Background>

                            <ImageBrush x:Name="LogoHeaderBrush" />

                        </Border.Background>

                    </Border>

                    <Border Visibility="Collapsed">

                        <Border.Background>

                            <ImageBrush x:Name="LogoMigrationBrush" />

                        </Border.Background>

                    </Border>

                    <ProgressBar x:Name="ProgressBarDownload" />

                    <CheckBox x:Name="ChkAutoCheckUpdates" />

                    <CheckBox x:Name="ChkMinimizeToTray" />

                    <CheckBox x:Name="ChkShellContextMenu" />

                    <CheckBox x:Name="ChkSoundEffects" />

                    <CheckBox x:Name="ChkTemporaryReceive" />

                    <CheckBox x:Name="ChkPictures" />

                    <CheckBox x:Name="ChkVideos" />

                    <CheckBox x:Name="ChkDocs" />

                    <CheckBox x:Name="ChkMusic" />

                    <CheckBox x:Name="ChkDownloads" />

                    <CheckBox x:Name="ChkDesktop" />

                    <ComboBox x:Name="CmbMigrationTarget" />

                    <ListBox x:Name="ListWebShareFiles" />

                    <Button x:Name="BtnPauseTransfer" />

                    <Button x:Name="BtnCheckUpdates" />

                    <Button x:Name="BtnSkipUpdate" />

                    <Button x:Name="BtnUpdateNow" />

                    <Button x:Name="BtnUpdateAfterTransfer" />

                    <Button x:Name="BtnCancelDownload" />

                    <Button x:Name="BtnTransportAuto" />

                    <Button x:Name="BtnTransportWifi" />

                    <Button x:Name="BtnTransportDirect" />

                    <Button x:Name="BtnTransportBt" />

                                        <Border x:Name="PanelMigrationScan" />

                    <Border x:Name="PanelCopyFeedback" />

                    <Border x:Name="PanelUpdateAvailable" />

                    <Border x:Name="PanelUpdateProgress" />

                    <Border x:Name="PanelActiveTransferWarning" />

                    <Path x:Name="IconReceivedFile" />

                    <Path x:Name="IconNotificationType" />

                    <Grid x:Name="ViewWebShare" />

                    <Grid x:Name="ViewSecurity" />

                </Grid>



                <!-- ── Main Content Area ──────────────────────────────── -->

                <ScrollViewer Grid.Column="1" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,6,22,20">

                    <Grid>



                        <!-- ══ VIEW 1: HOME ════════════════════════════════════ -->

                        <Grid x:Name="ViewHome" Visibility="Visible">

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto" />

                                <RowDefinition Height="Auto" />

                                <RowDefinition Height="Auto" />

                            </Grid.RowDefinitions>



                            <TextBlock Grid.Row="0" Text="Home" FontSize="22" FontWeight="Bold" Foreground="#F5F5F5" Margin="4,4,0,14" />



                            <!-- Top 2-Column Section (1.3fr : 1fr) -->

                            <Grid Grid.Row="1">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="1.3*" />

                                    <ColumnDefinition Width="14" />

                                    <ColumnDefinition Width="1*" />

                                </Grid.ColumnDefinitions>



                                <!-- Left Column: Dashed Dropzone & Move Device Quick Action -->

                                <StackPanel Grid.Column="0">

                                    <Border Background="#09FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16" Padding="12">

                                        <Border x:Name="HomeDropZone" Cursor="Hand" Height="170" CornerRadius="14" BorderBrush="#72FF8A00" BorderThickness="1.5"

                                                AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop" MouseLeftButtonUp="HomeDropZone_Click">

                                            <Border.Background>

                                                <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.6" RadiusY="0.6">

                                                    <GradientStop Color="#24FF5A00" Offset="0"/>

                                                    <GradientStop Color="Transparent" Offset="1"/>

                                                </RadialGradientBrush>

                                            </Border.Background>

                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                                                <Path Data="{StaticResource KmIconFile}" Stroke="#FF8A00" StrokeThickness="2" Width="30" Height="30" HorizontalAlignment="Center" Margin="0,0,0,10" />

                                                <TextBlock Text="Drop files or folders here" FontSize="15" FontWeight="SemiBold" Foreground="#F5F5F5" HorizontalAlignment="Center" />

                                                <TextBlock Text="or click to choose what to send" FontSize="12" Foreground="#8C8C8C" HorizontalAlignment="Center" Margin="0,4,0,0" />

                                            </StackPanel>

                                        </Border>

                                    </Border>



                                    <!-- Move Device Quick Action Card -->

                                    <Border x:Name="CardMoveDevice" Background="#09FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16" Padding="14,12" Margin="0,10,0,0" Cursor="Hand" MouseLeftButtonUp="CardMoveDevice_Click">

                                        <Grid>

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="Auto" />

                                                <ColumnDefinition Width="*" />

                                                <ColumnDefinition Width="Auto" />

                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Background="#14FF5A00" BorderBrush="#33FF5A00" BorderThickness="1" CornerRadius="10" Width="38" Height="38" Margin="0,0,12,0" VerticalAlignment="Center">

                                                <Path Data="{StaticResource KmIconDevice}" Stroke="#FF8A00" StrokeThickness="1.8" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                                <TextBlock Text="Move device" FontSize="14" FontWeight="SemiBold" Foreground="#F5F5F5" />

                                                <TextBlock Text="Move files, apps, and data to another device" FontSize="11" Foreground="#8C8C8C" Margin="0,2,0,0" />

                                            </StackPanel>

                                            <Border Grid.Column="2" Background="#10FFFFFF" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">

                                                <TextBlock Text="Start &#x2192;" FontSize="11" FontWeight="SemiBold" Foreground="#FF8A00" />

                                            </Border>

                                        </Grid>

                                    </Border>

                                </StackPanel>



                                <!-- Right Column: Nearby Devices -->

                                <Border Grid.Column="2" Background="#09FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16" Padding="16">

                                    <StackPanel>

                                        <Grid Margin="0,0,0,12">

                                            <TextBlock Text="Nearby devices" FontSize="14" FontWeight="SemiBold" Foreground="#F5F5F5" VerticalAlignment="Center" />

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                                                <Ellipse x:Name="DotDiscoveryStatus" Width="8" Height="8" Fill="#8C8C8C" Margin="0,0,6,0" VerticalAlignment="Center" />

                                                <TextBlock x:Name="TxtDiscoveryStatus" Text="Looking for devices…" FontSize="11" Foreground="#8C8C8C" VerticalAlignment="Center" />

                                            </StackPanel>

                                        </Grid>



                                        <!-- Dynamic discovered devices list -->

                                        <ListBox x:Name="ListDevices" Background="Transparent" BorderThickness="0" MaxHeight="210" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ListDevices_SelectionChanged" MouseDoubleClick="ListDevices_MouseDoubleClick">

                                            <ListBox.ItemContainerStyle>

                                                <Style TargetType="ListBoxItem">

                                                    <Setter Property="Template">

                                                        <Setter.Value>

                                                            <ControlTemplate TargetType="ListBoxItem">

                                                                <Border x:Name="ItemBorder" Background="#06FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,8" Cursor="Hand">

                                                                    <ContentPresenter />

                                                                </Border>

                                                                <ControlTemplate.Triggers>

                                                                    <Trigger Property="IsMouseOver" Value="True">

                                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#0EFFFFFF" />

                                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#28FFFFFF" />

                                                                    </Trigger>

                                                                    <Trigger Property="IsSelected" Value="True">

                                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#18FF5A00" />

                                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#66FF5A00" />

                                                                    </Trigger>

                                                                </ControlTemplate.Triggers>

                                                            </ControlTemplate>

                                                        </Setter.Value>

                                                    </Setter>

                                                </Style>

                                            </ListBox.ItemContainerStyle>

                                            <ListBox.ItemTemplate>

                                                <DataTemplate>

                                                    <Grid>

                                                        <Grid.ColumnDefinitions>

                                                            <ColumnDefinition Width="Auto" />

                                                            <ColumnDefinition Width="*" />

                                                            <ColumnDefinition Width="Auto" />

                                                        </Grid.ColumnDefinitions>

                                                        <Path Grid.Column="0" Data="{StaticResource KmIconDevice}" Stroke="#FF8A00" StrokeThickness="1.8" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0" />

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                                            <TextBlock Text="{Binding DeviceName}" FontSize="13" Foreground="#F5F5F5" FontWeight="Medium" />

                                                            <TextBlock Text="Wi-Fi &#x00B7; Ready" FontSize="11" Foreground="#8C8C8C" Margin="0,2,0,0" />

                                                        </StackPanel>

                                                        <Border Grid.Column="2" Background="#264ADE80" CornerRadius="999" Padding="8,2" VerticalAlignment="Center">

                                                            <TextBlock Text="Online" Foreground="#4ADE80" FontSize="11" FontWeight="SemiBold" />

                                                        </Border>

                                                    </Grid>

                                                </DataTemplate>

                                            </ListBox.ItemTemplate>

                                        </ListBox>



                                        <!-- Empty State -->

                                        <Border x:Name="PanelDevicesEmpty" Background="#04FFFFFF" BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="12" Padding="14,24" Margin="0,2,0,0">

                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                                                <Path Data="{StaticResource KmIconDevice}" Stroke="#555555" StrokeThickness="1.5" Width="22" Height="22" HorizontalAlignment="Center" Margin="0,0,0,8" />

                                                <TextBlock Text="Looking for devices…" FontSize="13" FontWeight="Medium" Foreground="#8C8C8C" HorizontalAlignment="Center" />

                                                <TextBlock Text="Ensure KnowToMigrate is open on the other device." FontSize="11" Foreground="#555555" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center" />

                                            </StackPanel>

                                        </Border>

                                    </StackPanel>

                                </Border>

                            </Grid>



                            <!-- Bottom: Recent Transfers Table -->

                            <Border Grid.Row="2" Background="#09FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,14,0,0">

                                <StackPanel>

                                    <Grid Margin="0,0,0,12">

                                        <TextBlock Text="Recent" FontSize="14" FontWeight="SemiBold" Foreground="#F5F5F5" VerticalAlignment="Center" />

                                        <Button Content="View all" Click="BtnViewAllHistory_Click" Style="{StaticResource KmGlassButton}" MinHeight="26" Padding="10,2" FontSize="11" HorizontalAlignment="Right" />

                                    </Grid>



                                    <!-- Table Columns Header -->

                                    <Grid Margin="4,0,4,8" Opacity="0.6">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="2.5*" />

                                            <ColumnDefinition Width="2*" />

                                            <ColumnDefinition Width="1*" />

                                            <ColumnDefinition Width="1.5*" />

                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="File" FontSize="11" Foreground="#8C8C8C" />

                                        <TextBlock Grid.Column="1" Text="Direction" FontSize="11" Foreground="#8C8C8C" />

                                        <TextBlock Grid.Column="2" Text="Size" FontSize="11" Foreground="#8C8C8C" />

                                        <TextBlock Grid.Column="3" Text="Integrity" FontSize="11" Foreground="#8C8C8C" />

                                    </Grid>



                                    <!-- Dynamic Recent Transfers List -->

                                    <ListBox x:Name="ListHomeRecent" Background="Transparent" BorderThickness="0" MaxHeight="220" ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                                        <ListBox.ItemContainerStyle>

                                            <Style TargetType="ListBoxItem">

                                                <Setter Property="Template">

                                                    <Setter.Value>

                                                        <ControlTemplate TargetType="ListBoxItem">

                                                            <Border x:Name="RowBorder" Background="Transparent" BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" Padding="4,8">

                                                                <ContentPresenter />

                                                            </Border>

                                                            <ControlTemplate.Triggers>

                                                                <Trigger Property="IsMouseOver" Value="True">

                                                                    <Setter TargetName="RowBorder" Property="Background" Value="#08FFFFFF" />

                                                                </Trigger>

                                                            </ControlTemplate.Triggers>

                                                        </ControlTemplate>

                                                    </Setter.Value>

                                                </Setter>

                                            </Style>

                                        </ListBox.ItemContainerStyle>

                                        <ListBox.ItemTemplate>

                                            <DataTemplate>

                                                <Grid>

                                                    <Grid.ColumnDefinitions>

                                                        <ColumnDefinition Width="2.5*" />

                                                        <ColumnDefinition Width="2*" />

                                                        <ColumnDefinition Width="1*" />

                                                        <ColumnDefinition Width="1.5*" />

                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding FileName}" FontSize="13" Foreground="#F5F5F5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                                                        <TextBlock Text="{Binding DirectionDisplay}" FontSize="12" Foreground="{Binding DirectionBrush}" FontWeight="Medium" Margin="0,0,6,0" />

                                                        <TextBlock Text="{Binding DeviceName}" FontSize="12" Foreground="#8C8C8C" TextTrimming="CharacterEllipsis" />

                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" FontSize="12" Foreground="#8C8C8C" VerticalAlignment="Center" />

                                                    <Border Grid.Column="3" Background="#264ADE80" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">

                                                        <TextBlock Text="SHA-256 verified" Foreground="#4ADE80" FontSize="11" FontWeight="SemiBold" />

                                                    </Border>

                                                </Grid>

                                            </DataTemplate>

                                        </ListBox.ItemTemplate>

                                    </ListBox>



                                    <!-- Empty State -->

                                    <StackPanel x:Name="PanelHomeRecentEmpty" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,20,0,16">

                                        <TextBlock Text="No recent transfers" FontSize="13" Foreground="#8C8C8C" HorizontalAlignment="Center" />

                                        <TextBlock Text="Files you send or receive will appear here." FontSize="11" Foreground="#555555" HorizontalAlignment="Center" Margin="0,4,0,0" />

                                    </StackPanel>

                                </StackPanel>

                            </Border>

                        </Grid>



                        <!-- ══ VIEW 2: SEND ════════════════════════════════════ -->

                        <Grid x:Name="ViewSend" Visibility="Collapsed">

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto" />

                                <RowDefinition Height="*" />

                            </Grid.RowDefinitions>



                            <TextBlock Grid.Row="0" Text="Send" FontSize="22" FontWeight="Bold" Foreground="#F5F5F5" Margin="4,4,0,14" />



                            <Grid Grid.Row="1">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="1.3*" />

                                    <ColumnDefinition Width="14" />

                                    <ColumnDefinition Width="1*" />

                                </Grid.ColumnDefinitions>



                                <!-- Left: File Selection List -->

                                <Border Grid.Column="0" Background="#09FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16" Padding="14">

                                    <DockPanel>

                                        <!-- Action Buttons at Top -->

                                        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">

                                            <TextBlock Text="Staged items" FontSize="13" FontWeight="SemiBold" Foreground="#8C8C8C" VerticalAlignment="Center" />

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                                                <Button Content="+ Files" Click="ChooseFiles_Click" Style="{StaticResource KmGlassButton}" MinHeight="32" Padding="12,4" Margin="0,0,6,0" FontSize="12" />

                                                <Button Content="+ Folder" Click="ChooseFolder_Click" Style="{StaticResource KmGlassButton}" MinHeight="32" Padding="12,4" Margin="0,0,6,0" FontSize="12" />

                                                <Button Content="Clear" Click="ClearSelectedFiles_Click" Style="{StaticResource KmGlassButton}" MinHeight="32" Padding="12,4" FontSize="12" />

                                            </StackPanel>

                                        </Grid>



                                        <!-- Real Staged Files List -->

                                        <ListBox x:Name="ListStagedFiles" Background="Transparent" BorderThickness="0" MaxHeight="380" ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                                            <ListBox.ItemContainerStyle>

                                                <Style TargetType="ListBoxItem">

                                                    <Setter Property="Template">

                                                        <Setter.Value>

                                                            <ControlTemplate TargetType="ListBoxItem">

                                                                <Border x:Name="ItemBorder" Background="#05FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,8">

                                                                    <ContentPresenter />

                                                                </Border>

                                                                <ControlTemplate.Triggers>

                                                                    <Trigger Property="IsMouseOver" Value="True">

                                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#0DFFFFFF" />

                                                                    </Trigger>

                                                                </ControlTemplate.Triggers>

                                                            </ControlTemplate>

                                                        </Setter.Value>

                                                    </Setter>

                                                </Style>

                                            </ListBox.ItemContainerStyle>

                                            <ListBox.ItemTemplate>

                                                <DataTemplate>

                                                    <Grid>

                                                        <Grid.ColumnDefinitions>

                                                            <ColumnDefinition Width="Auto" />

                                                            <ColumnDefinition Width="*" />

                                                            <ColumnDefinition Width="Auto" />

                                                            <ColumnDefinition Width="Auto" />

                                                        </Grid.ColumnDefinitions>

                                                        <Path Grid.Column="0" Data="{StaticResource KmIconFile}" Stroke="#FF8A00" StrokeThickness="1.8" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0" />

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                                            <TextBlock Text="{Binding FileName}" FontSize="13" Foreground="#F5F5F5" FontWeight="Medium" TextTrimming="CharacterEllipsis" />

                                                            <TextBlock Text="{Binding FormattedSize}" FontSize="11" Foreground="#8C8C8C" Margin="0,1,0,0" />

                                                        </StackPanel>

                                                        <Button Grid.Column="3" Content="&#x2715;" Tag="{Binding FullPath}" Click="RemoveStagedFile_Click" Style="{StaticResource KmGlassButton}" MinHeight="26" Width="26" Padding="0" FontSize="11" Foreground="#8C8C8C" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Remove" />

                                                    </Grid>

                                                </DataTemplate>

                                            </ListBox.ItemTemplate>

                                        </ListBox>



                                        <!-- Empty State for Staged Items -->

                                        <Border x:Name="PanelStagedEmpty" Background="#04FFFFFF" BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="12" Padding="16,36" Margin="0,4,0,0">

                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                                                <Path Data="{StaticResource KmIconFile}" Stroke="#555555" StrokeThickness="1.5" Width="26" Height="26" HorizontalAlignment="Center" Margin="0,0,0,10" />

                                                <TextBlock Text="No items staged for transfer" FontSize="13" FontWeight="Medium" Foreground="#8C8C8C" HorizontalAlignment="Center" />

                                                <TextBlock Text="Use + Files or + Folder, or drag and drop from your computer." FontSize="11" Foreground="#555555" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center" />

                                            </StackPanel>

                                        </Border>

                                    </DockPanel>

                                </Border>



                                <!-- Right: Send To, Advanced & Progress Pane -->

                                <StackPanel Grid.Column="2">

                                    <!-- Send To Target Device Card -->

                                    <Border Background="#09FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16" Padding="16">

                                        <StackPanel>

                                            <TextBlock Text="Send to" FontSize="12" Foreground="#8C8C8C" Margin="0,0,0,8" />



                                            <!-- Selectable Target Device Selector -->

                                            <ComboBox x:Name="ComboSendDevices" SelectionChanged="ComboSendDevices_SelectionChanged"

                                                      Background="#141414" Foreground="#F5F5F5" BorderBrush="#33FFFFFF" BorderThickness="1" MinHeight="40" Padding="10,6">

                                                <ComboBox.ItemTemplate>

                                                    <DataTemplate>

                                                        <StackPanel Orientation="Horizontal">

                                                            <Path Data="{StaticResource KmIconDevice}" Stroke="#FF8A00" StrokeThickness="1.5" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0" />

                                                            <TextBlock Text="{Binding DeviceName}" FontSize="13" Foreground="#F5F5F5" VerticalAlignment="Center" />

                                                            <TextBlock Text=" &#x00B7; " FontSize="12" Foreground="#666666" VerticalAlignment="Center" />

                                                            <TextBlock Text="{Binding IpAddress}" FontSize="11" Foreground="#8C8C8C" VerticalAlignment="Center" />

                                                        </StackPanel>

                                                    </DataTemplate>

                                                </ComboBox.ItemTemplate>

                                            </ComboBox>



                                            <TextBlock x:Name="TxtSendTargetName" Text="No device selected" FontSize="12" FontWeight="SemiBold" Foreground="#F5F5F5" Margin="2,8,0,2" />

                                            <TextBlock x:Name="TxtFileInfo" Text="No files selected" FontSize="11" Foreground="#8C8C8C" Margin="2,0,0,14" />



                                            <!-- Single Primary Button: Start transfer -->

                                            <Button x:Name="BtnTransfer" Click="TransferNow_Click" Style="{StaticResource KmPrimaryButton}" Content="Start transfer" MinHeight="44" />



                                            <!-- Advanced Disclosure: Connect by IP Address -->

                                            <Expander Header="Advanced" Foreground="#8C8C8C" FontSize="12" Margin="0,12,0,0" Background="Transparent" BorderThickness="0">

                                                <Border Background="#06FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,6,0,0">

                                                    <StackPanel>

                                                        <TextBlock Text="Connect by IP address" FontSize="12" FontWeight="SemiBold" Foreground="#F5F5F5" Margin="0,0,0,4" />

                                                        <TextBlock Text="Enter the IP address shown on the other device's Receive screen." FontSize="10" Foreground="#8C8C8C" TextWrapping="Wrap" Margin="0,0,0,8" />

                                                        <Grid>

                                                            <Grid.ColumnDefinitions>

                                                                <ColumnDefinition Width="*" />

                                                                <ColumnDefinition Width="6" />

                                                                <ColumnDefinition Width="Auto" />

                                                            </Grid.ColumnDefinitions>

                                                            <TextBox x:Name="TxtManualIp" Grid.Column="0" Text="192.168.1." Background="#0FFFFFFF" Foreground="#F5F5F5" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="8,4" FontSize="12" VerticalContentAlignment="Center" />

                                                            <Button Grid.Column="2" Content="Connect" Click="AddManualDevice_Click" Style="{StaticResource KmGlassButton}" MinHeight="32" Padding="12,2" FontSize="11" />

                                                        </Grid>

                                                    </StackPanel>

                                                </Border>

                                            </Expander>

                                        </StackPanel>

                                    </Border>



                                    <!-- Real-time Transfer Intelligence & Progress Card -->

                                    <Border x:Name="PanelProgress" Background="#09FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,14,0,0" Visibility="Collapsed">

                                        <StackPanel>

                                            <!-- Intelligence Header Badges -->

                                            <Grid Margin="0,0,0,10">

                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                    <Border Background="#14FF5A00" BorderBrush="#33FF5A00" BorderThickness="1" CornerRadius="8" Padding="8,3" Margin="0,0,6,0">

                                                        <StackPanel Orientation="Horizontal">

                                                            <Ellipse Width="6" Height="6" Fill="#22C55E" Margin="0,0,6,0" VerticalAlignment="Center" />

                                                            <TextBlock x:Name="TxtIntelligenceTransport" Text="Transit Auto · Wi-Fi LAN" FontSize="11" FontWeight="SemiBold" Foreground="#FF8A00" VerticalAlignment="Center" />

                                                        </StackPanel>

                                                    </Border>

                                                    <Border Background="#0FFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8" Padding="8,3">

                                                        <TextBlock x:Name="TxtIntelligenceQuality" Text="●●●●● Excellent · 2.4 ms" FontSize="10" Foreground="#8C8C8C" VerticalAlignment="Center" />

                                                    </Border>

                                                </StackPanel>

                                                <Border HorizontalAlignment="Right" Background="#1422C55E" BorderBrush="#3322C55E" BorderThickness="1" CornerRadius="8" Padding="8,3">

                                                    <StackPanel Orientation="Horizontal">

                                                        <TextBlock Text="✓ " FontSize="10" Foreground="#22C55E" FontWeight="Bold" VerticalAlignment="Center"/>

                                                        <TextBlock x:Name="TxtIntegrityBadge" Text="BLAKE3 Verified" FontSize="10" FontWeight="SemiBold" Foreground="#22C55E" VerticalAlignment="Center" />

                                                    </StackPanel>

                                                </Border>

                                            </Grid>



                                            <!-- Dynamic Data Particle Stream Between Devices -->

                                            <Border Background="#06FFFFFF" BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,12">

                                                <Grid>

                                                    <Grid.ColumnDefinitions>

                                                        <ColumnDefinition Width="Auto" />

                                                        <ColumnDefinition Width="*" />

                                                        <ColumnDefinition Width="Auto" />

                                                    </Grid.ColumnDefinitions>



                                                    <!-- Sender Device -->

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                                                        <Path Data="{StaticResource KmIconDevice}" Stroke="#FF8A00" StrokeThickness="1.5" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />

                                                        <TextBlock x:Name="TxtParticleSender" Text="This PC" FontSize="11" Foreground="#F5F5F5" FontWeight="Medium" VerticalAlignment="Center" />

                                                    </StackPanel>



                                                    <!-- Animated Particle Channel -->

                                                    <Canvas Grid.Column="1" Height="12" Margin="12,0" ClipToBounds="True" HorizontalAlignment="Stretch" VerticalAlignment="Center">

                                                        <!-- Base Track -->

                                                        <Line X1="0" Y1="6" X2="200" Y2="6" Stroke="#1FFFFFFF" StrokeThickness="1" StrokeDashArray="2,4" />

                                                        <!-- Moving Particles -->

                                                        <Ellipse x:Name="Particle1" Width="5" Height="5" Fill="#FF5A00" Canvas.Top="3.5">

                                                            <Ellipse.RenderTransform>

                                                                <TranslateTransform X="0" Y="0" />

                                                            </Ellipse.RenderTransform>

                                                        </Ellipse>

                                                        <Ellipse x:Name="Particle2" Width="4" Height="4" Fill="#FF8A00" Canvas.Top="4">

                                                            <Ellipse.RenderTransform>

                                                                <TranslateTransform X="0" Y="0" />

                                                            </Ellipse.RenderTransform>

                                                        </Ellipse>

                                                        <Ellipse x:Name="Particle3" Width="3" Height="3" Fill="#34D399" Canvas.Top="4.5">

                                                            <Ellipse.RenderTransform>

                                                                <TranslateTransform X="0" Y="0" />

                                                            </Ellipse.RenderTransform>

                                                        </Ellipse>

                                                    </Canvas>



                                                    <!-- Receiver Device -->

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                                                        <TextBlock x:Name="TxtParticleReceiver" Text="Receiver" FontSize="11" Foreground="#F5F5F5" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,6,0" />

                                                        <Path Data="{StaticResource KmIconDevice}" Stroke="#34D399" StrokeThickness="1.5" Width="14" Height="14" VerticalAlignment="Center" />

                                                    </StackPanel>

                                                </Grid>

                                            </Border>



                                            <!-- Progress Title & Percentage -->

                                            <Grid>

                                                <TextBlock x:Name="TxtProgressTitle" Text="Preparing transfer..." FontWeight="Bold" FontSize="13" Foreground="#F5F5F5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                                <TextBlock x:Name="TxtPercentage" Text="0%" FontSize="13" FontWeight="SemiBold" Foreground="#FF8A00" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                            </Grid>

                                            <ProgressBar x:Name="ProgressBarTransfer" Style="{StaticResource KmGradientProgressBar}" Height="8" Margin="0,10,0,10" Value="0" />



                                            <Grid Margin="0,0,0,4">

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="*" />

                                                    <ColumnDefinition Width="*" />

                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">

                                                    <TextBlock x:Name="TxtTransferredSize" Text="0 B / 0 B" FontSize="12" Foreground="#F5F5F5" />

                                                    <TextBlock x:Name="TxtSpeed" Text="0 MB/s" FontSize="11" Foreground="#8C8C8C" Margin="0,2,0,0" />

                                                </StackPanel>

                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">

                                                    <TextBlock x:Name="TxtEta" Text="--:-- remaining" FontSize="12" Foreground="#F5F5F5" HorizontalAlignment="Right" />

                                                    <TextBlock x:Name="TxtElapsed" Text="00:00 elapsed" FontSize="11" Foreground="#8C8C8C" HorizontalAlignment="Right" Margin="0,2,0,0" />

                                                </StackPanel>

                                            </Grid>



                                            <TextBlock x:Name="TxtActiveTransport" Visibility="Collapsed" />

                                            
                                            <TextBlock x:Name="TxtStatus" Text="Adaptive streaming active" FontSize="11" Foreground="#555555" Margin="0,4,0,0" />



                                            <!-- Control Action Bar: Pause / Resume + Cancel -->

                                            <Grid Margin="0,12,0,0">

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="*" />

                                                    <ColumnDefinition Width="8" />

                                                    <ColumnDefinition Width="*" />

                                                </Grid.ColumnDefinitions>

                                                <Button x:Name="BtnPauseResumeTransfer" Grid.Column="0" Click="PauseResumeTransfer_Click" Style="{StaticResource KmGlassButton}" Content="Pause" MinHeight="36" />

                                                <Button x:Name="BtnCancelTransfer" Grid.Column="2" Click="CancelTransfer_Click" Style="{StaticResource KmGlassButton}" Content="Cancel" MinHeight="36" />

                                            </Grid>



                                            <!-- Expandable Transfer Queue -->

                                            <Expander x:Name="ExpanderQueue" Header="Transfer Queue" Foreground="#8C8C8C" FontSize="12" Margin="0,10,0,0" Background="Transparent" BorderThickness="0" IsExpanded="True">

                                                <Border Background="#05FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,6,0,0">

                                                    <ListBox x:Name="ListTransferQueue" Background="Transparent" BorderThickness="0" MaxHeight="160" ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                                                        <ListBox.ItemContainerStyle>

                                                            <Style TargetType="ListBoxItem">

                                                                <Setter Property="Template">

                                                                    <Setter.Value>

                                                                        <ControlTemplate TargetType="ListBoxItem">

                                                                            <Border Background="#04FFFFFF" BorderBrush="#08FFFFFF" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,6">

                                                                                <ContentPresenter />

                                                                            </Border>

                                                                        </ControlTemplate>

                                                                    </Setter.Value>

                                                                </Setter>

                                                            </Style>

                                                        </ListBox.ItemContainerStyle>

                                                        <ListBox.ItemTemplate>

                                                            <DataTemplate>

                                                                <Grid>

                                                                    <Grid.ColumnDefinitions>

                                                                        <ColumnDefinition Width="*" />

                                                                        <ColumnDefinition Width="Auto" />

                                                                    </Grid.ColumnDefinitions>

                                                                    <StackPanel Grid.Column="0">

                                                                        <TextBlock Text="{Binding FileName}" FontSize="12" Foreground="#F5F5F5" FontWeight="Medium" TextTrimming="CharacterEllipsis" />

                                                                        <TextBlock Text="{Binding FormattedSize}" FontSize="10" Foreground="#8C8C8C" Margin="0,1,0,0" />

                                                                    </StackPanel>

                                                                    <Border Grid.Column="1" Background="#0AFFFFFF" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">

                                                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="11" Foreground="#FF8A00" FontWeight="SemiBold" />

                                                                    </Border>

                                                                </Grid>

                                                            </DataTemplate>

                                                        </ListBox.ItemTemplate>

                                                    </ListBox>

                                                </Border>

                                            </Expander>

                                        </StackPanel>

                                    </Border>

                                </StackPanel>

                            </Grid>

                        </Grid>



                        <!-- ══ VIEW 3: RECEIVE ═════════════════════════════════ -->

                        <Grid x:Name="ViewReceive" Visibility="Collapsed">

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto" />

                                <RowDefinition Height="*" />

                            </Grid.RowDefinitions>



                            <!-- Top Status Line & Toggle -->

                            <Grid Grid.Row="0" Margin="4,4,0,16">

                                <TextBlock Text="Receive" FontSize="22" FontWeight="Bold" Foreground="#F5F5F5" VerticalAlignment="Center" />

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                                    <Ellipse x:Name="DotAcceptingStatus" Width="8" Height="8" Fill="#22C55E" Margin="0,0,8,0" VerticalAlignment="Center" />

                                    <TextBlock x:Name="TxtAcceptingFilesStatus" Text="Accepting files" FontSize="13" Foreground="#F5F5F5" FontWeight="Medium" Margin="0,0,12,0" VerticalAlignment="Center" />

                                    <CheckBox x:Name="ToggleAcceptingFiles" Style="{StaticResource KmToggleSwitch}" IsChecked="True" Checked="ToggleAcceptingFiles_Changed" Unchecked="ToggleAcceptingFiles_Changed" VerticalAlignment="Center" />

                                </StackPanel>

                            </Grid>



                            <Grid Grid.Row="1">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="1.2*" />

                                    <ColumnDefinition Width="14" />

                                    <ColumnDefinition Width="1*" />

                                </Grid.ColumnDefinitions>



                                <!-- Left Column: Radar Zone, This PC Row, Security Notice, Details -->

                                <StackPanel Grid.Column="0">

                                    <!-- Radar Listening Zone -->

                                    <Border Background="#09FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16" Padding="24">

                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                                            <!-- Concentric Pulsing Radar -->

                                            <Grid Width="110" Height="110" HorizontalAlignment="Center" Margin="0,0,0,16">

                                                <Ellipse x:Name="RadarRing1" Width="110" Height="110" Stroke="#72FF5A00" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5">

                                                    <Ellipse.RenderTransform>

                                                        <ScaleTransform ScaleX="0.25" ScaleY="0.25"/>

                                                    </Ellipse.RenderTransform>

                                                </Ellipse>

                                                <Ellipse x:Name="RadarRing2" Width="110" Height="110" Stroke="#72FF5A00" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5">

                                                    <Ellipse.RenderTransform>

                                                        <ScaleTransform ScaleX="0.25" ScaleY="0.25"/>

                                                    </Ellipse.RenderTransform>

                                                </Ellipse>

                                                <Ellipse x:Name="RadarRing3" Width="110" Height="110" Stroke="#72FF5A00" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5">

                                                    <Ellipse.RenderTransform>

                                                        <ScaleTransform ScaleX="0.25" ScaleY="0.25"/>

                                                    </Ellipse.RenderTransform>

                                                </Ellipse>

                                                <Ellipse Width="14" Height="14" Fill="#FF5A00" HorizontalAlignment="Center" VerticalAlignment="Center">

                                                    <Ellipse.Effect>

                                                        <DropShadowEffect Color="#FF5A00" BlurRadius="16" ShadowDepth="0" Opacity="0.9"/>

                                                    </Ellipse.Effect>

                                                </Ellipse>

                                            </Grid>



                                            <TextBlock x:Name="TxtListeningStatus" Text="Listening on Wi-Fi" FontSize="15" FontWeight="SemiBold" Foreground="#F5F5F5" HorizontalAlignment="Center" />

                                            <TextBlock Text="Visible to nearby devices on your local network" FontSize="11" Foreground="#8C8C8C" HorizontalAlignment="Center" Margin="0,4,0,0" />

                                        </StackPanel>

                                    </Border>



                                    <!-- This PC Row with Name and Change Download Folder Button -->

                                    <Border Background="#09FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16" Padding="14,12" Margin="0,12,0,0">

                                        <Grid>

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="Auto" />

                                                <ColumnDefinition Width="*" />

                                                <ColumnDefinition Width="Auto" />

                                            </Grid.ColumnDefinitions>

                                            <Path Grid.Column="0" Data="{StaticResource KmIconDevice}" Stroke="#FF8A00" StrokeThickness="1.8" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,12,0" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                                <TextBlock x:Name="TxtReceiveDeviceName" Text="This PC" FontSize="13" FontWeight="SemiBold" Foreground="#F5F5F5" />

                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">

                                                    <TextBlock Text="Save to: " FontSize="11" Foreground="#8C8C8C" />

                                                    <TextBlock x:Name="TxtReceiveFolder" Text="Downloads\KnowToMigrate" FontSize="11" Foreground="#F5F5F5" TextTrimming="CharacterEllipsis" MaxWidth="280" />

                                                </StackPanel>

                                            </StackPanel>

                                            <Button Grid.Column="2" Content="Change" Click="ChangeDownloadFolder_Click" Style="{StaticResource KmGlassButton}" MinHeight="30" Padding="12,2" FontSize="11" VerticalAlignment="Center" />

                                        </Grid>

                                    </Border>



                                    <!-- Honest Security Status Notice -->

                                    <Border Background="#14F59E0B" BorderBrush="#33F59E0B" BorderThickness="1" CornerRadius="14" Padding="14,10" Margin="0,12,0,0">

                                        <Grid>

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="Auto" />

                                                <ColumnDefinition Width="*" />

                                            </Grid.ColumnDefinitions>

                                            <Path Grid.Column="0" Data="M12 2L1 21h22L12 2zm0 3.5L20.3 19H3.7L12 5.5zM11 10v4h2v-4h-2zm0 6v2h2v-2h-2z" Fill="#F59E0B" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,10,0" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                                <TextBlock Text="{StaticResource StringSecurityLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#F59E0B" />

                                                <TextBlock Text="{StaticResource StringSecuritySubtext}" FontSize="11" Foreground="#8C8C8C" Margin="0,1,0,0" />

                                            </StackPanel>

                                        </Grid>

                                    </Border>



                                    <!-- Collapsible Details Disclosure -->

                                    <Expander Header="Details" Foreground="#8C8C8C" FontSize="12" Margin="0,10,0,0" Background="Transparent" BorderThickness="0">

                                        <Border Background="#06FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,6,0,0">

                                            <StackPanel>

                                                <Grid Margin="0,0,0,8">

                                                    <TextBlock Text="Local IP address" FontSize="11" Foreground="#8C8C8C" />

                                                    <TextBlock x:Name="TxtReceiveLocalIp" Text="192.168.1.100" FontSize="11" Foreground="#F5F5F5" HorizontalAlignment="Right" />

                                                </Grid>

                                                <Grid Margin="0,0,0,8">

                                                    <TextBlock Text="Transfer port" FontSize="11" Foreground="#8C8C8C" />

                                                    <TextBlock Text="54124" FontSize="11" Foreground="#F5F5F5" HorizontalAlignment="Right" />

                                                </Grid>

                                                <Grid Margin="0,0,0,8">

                                                    <TextBlock Text="Discovery port" FontSize="11" Foreground="#8C8C8C" />

                                                    <TextBlock Text="54123" FontSize="11" Foreground="#F5F5F5" HorizontalAlignment="Right" />

                                                </Grid>

                                                <Grid>

                                                    <TextBlock Text="Unique ID" FontSize="11" Foreground="#8C8C8C" />

                                                    <TextBlock x:Name="TxtReceiveUniqueId" Text="ktm-win-pc" FontSize="11" Foreground="#8C8C8C" HorizontalAlignment="Right" />

                                                </Grid>

                                            </StackPanel>

                                        </Border>

                                    </Expander>

                                </StackPanel>



                                <!-- Right Column: Pairing PIN Card -->

                                <Border x:Name="CardPairingPin" Grid.Column="2" Background="#09FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16" Padding="24" VerticalAlignment="Top">

                                    <StackPanel VerticalAlignment="Center">

                                        <TextBlock Text="Pairing PIN" FontSize="12" Foreground="#8C8C8C" />

                                        <TextBlock x:Name="TxtIncomingPin" Text="482 915" FontSize="34" FontWeight="Bold" Foreground="#F5F5F5" Margin="0,10,0,10" />

                                        <TextBlock x:Name="TxtPinCaption" Text="Confirm the same PIN on the other device before accepting." FontSize="12" Foreground="#8C8C8C" TextWrapping="Wrap" Margin="0,0,0,24" />

                                        <Grid>

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="*" />

                                                <ColumnDefinition Width="10" />

                                                <ColumnDefinition Width="*" />

                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" Content="Reject" Click="DismissNotification_Click" Style="{StaticResource KmGlassButton}" MinHeight="42" />

                                            <Button Grid.Column="2" Content="Accept" Click="DismissNotification_Click" Style="{StaticResource KmPrimaryButton}" MinHeight="42" />

                                        </Grid>

                                    </StackPanel>

                                </Border>

                            </Grid>

                        </Grid>



                        <!-- ══ VIEW 4: MOVE DEVICE ═════════════════════════════ -->

                        <Grid x:Name="ViewMigration" Visibility="Collapsed">

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto" />

                                <RowDefinition Height="Auto" />

                                <RowDefinition Height="Auto" />

                                <RowDefinition Height="Auto" />

                                <RowDefinition Height="Auto" />

                            </Grid.RowDefinitions>



                            <TextBlock Grid.Row="0" Text="Move device" FontSize="22" FontWeight="Bold" Foreground="#F5F5F5" Margin="4,4,0,4" />

                            <TextBlock Grid.Row="1" x:Name="TxtMigrationStepLabel" Text="Step 2 of 10 · Photos" FontSize="12" Foreground="#8C8C8C" Margin="4,0,0,14" />



                            <!-- 10 Step Indicator Pills -->

                            <WrapPanel Grid.Row="2" x:Name="PanelMigrationSteps" Margin="0,0,0,16">

                                <!-- Populated dynamically by UpdateMigrationStepUI in MainWindow.xaml.cs -->

                            </WrapPanel>



                            <!-- Storage Check Bar Glass Card -->

                            <Border Grid.Row="3" Background="#09FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16" Padding="20">

                                <StackPanel>

                                    <Grid>

                                        <TextBlock Text="Storage check" FontSize="14" FontWeight="Bold" Foreground="#F5F5F5" VerticalAlignment="Center" />

                                        <TextBlock x:Name="TxtMigrationStorage" Text="Needs 18.2 GB &#x00B7; Free 64 GB" FontSize="12" Foreground="#8C8C8C" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                    </Grid>

                                    <ProgressBar x:Name="ProgressBarMigrationScan" Style="{StaticResource KmGradientProgressBar}" Height="10" Value="28" Margin="0,14,0,14" />

                                    <TextBlock Text="Scan first, then choose what to move." FontSize="12" Foreground="#8C8C8C" />

                                </StackPanel>

                            </Border>



                            <!-- Navigation Buttons -->

                            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,16,0,0" Width="380" HorizontalAlignment="Left">

                                <Button x:Name="BtnMigrationBack" Content="Back" Click="BtnMigrationBack_Click" Style="{StaticResource KmGlassButton}" Width="180" Margin="0,0,10,0" />

                                <Button x:Name="BtnMigrationNext" Content="Next" Click="BtnMigrationNext_Click" Style="{StaticResource KmPrimaryButton}" Width="180" />

                            </StackPanel>

                        </Grid>



                        <!-- ══ VIEW 5: HISTORY ═════════════════════════════════ -->

                        <Grid x:Name="ViewHistory" Visibility="Collapsed">

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto" />

                                <RowDefinition Height="*" />

                            </Grid.RowDefinitions>



                            <Grid Grid.Row="0" Margin="4,4,0,14">

                                <StackPanel>

                                    <TextBlock Text="History" FontSize="22" FontWeight="Bold" Foreground="#F5F5F5" />

                                    <TextBlock Text="Grouped by day. Verified with SHA-256 integrity checks." FontSize="12" Foreground="#8C8C8C" Margin="0,2,0,0" />

                                </StackPanel>

                                <Button Content="Clear history" Click="BtnClearLedger_Click" Style="{StaticResource KmGlassButton}" MinHeight="32" Padding="14,4" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />

                            </Grid>



                            <Border Grid.Row="1" Background="#09FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16" Padding="18">

                                <StackPanel>

                                    <!-- Table Columns Header -->

                                    <Grid Margin="4,0,4,10" Opacity="0.6">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="2.5*" />

                                            <ColumnDefinition Width="2*" />

                                            <ColumnDefinition Width="1*" />

                                            <ColumnDefinition Width="1.5*" />

                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="File" FontSize="11" Foreground="#8C8C8C" />

                                        <TextBlock Grid.Column="1" Text="Direction" FontSize="11" Foreground="#8C8C8C" />

                                        <TextBlock Grid.Column="2" Text="Size" FontSize="11" Foreground="#8C8C8C" />

                                        <TextBlock Grid.Column="3" Text="Integrity" FontSize="11" Foreground="#8C8C8C" />

                                    </Grid>



                                    <!-- Dynamic History Items with Day Grouping -->

                                    <ListBox x:Name="ListHistory" Background="Transparent" BorderThickness="0" MaxHeight="450" ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                                        <ListBox.GroupStyle>

                                            <GroupStyle>

                                                <GroupStyle.HeaderTemplate>

                                                    <DataTemplate>

                                                        <Border Background="#06FFFFFF" BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" Padding="4,8,4,4" Margin="0,8,0,4">

                                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#FF8A00" />

                                                        </Border>

                                                    </DataTemplate>

                                                </GroupStyle.HeaderTemplate>

                                            </GroupStyle>

                                        </ListBox.GroupStyle>

                                        <ListBox.ItemContainerStyle>

                                            <Style TargetType="ListBoxItem">

                                                <Setter Property="Template">

                                                    <Setter.Value>

                                                        <ControlTemplate TargetType="ListBoxItem">

                                                            <Border x:Name="RowBorder" Background="Transparent" BorderBrush="#0DFFFFFF" BorderThickness="0,0,0,1" Padding="4,8">

                                                                <ContentPresenter />

                                                            </Border>

                                                            <ControlTemplate.Triggers>

                                                                <Trigger Property="IsMouseOver" Value="True">

                                                                    <Setter TargetName="RowBorder" Property="Background" Value="#08FFFFFF" />

                                                                </Trigger>

                                                            </ControlTemplate.Triggers>

                                                        </ControlTemplate>

                                                    </Setter.Value>

                                                </Setter>

                                            </Style>

                                        </ListBox.ItemContainerStyle>

                                        <ListBox.ItemTemplate>

                                            <DataTemplate>

                                                <Grid>

                                                    <Grid.ColumnDefinitions>

                                                        <ColumnDefinition Width="2.5*" />

                                                        <ColumnDefinition Width="2*" />

                                                        <ColumnDefinition Width="1*" />

                                                        <ColumnDefinition Width="1.5*" />

                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding FileName}" FontSize="13" Foreground="#F5F5F5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                                                        <TextBlock Text="{Binding DirectionDisplay}" FontSize="12" Foreground="{Binding DirectionBrush}" FontWeight="Medium" Margin="0,0,6,0" />

                                                        <TextBlock Text="{Binding DeviceName}" FontSize="12" Foreground="#8C8C8C" TextTrimming="CharacterEllipsis" />

                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" FontSize="12" Foreground="#8C8C8C" VerticalAlignment="Center" />

                                                    <Border Grid.Column="3" Background="{Binding StatusBadgeBgBrush}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">

                                                        <TextBlock Text="{Binding StatusBadge}" Foreground="{Binding StatusBadgeBrush}" FontSize="11" FontWeight="SemiBold" />

                                                    </Border>

                                                </Grid>

                                            </DataTemplate>

                                        </ListBox.ItemTemplate>

                                    </ListBox>



                                    <!-- Empty State -->

                                    <Border x:Name="PanelLedgerEmpty" Background="#04FFFFFF" BorderBrush="#0DFFFFFF" BorderThickness="1" CornerRadius="12" Padding="20,40" Margin="0,10,0,0" Visibility="Collapsed">

                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                                            <Path Data="{StaticResource KmIconFile}" Stroke="#555555" StrokeThickness="1.5" Width="30" Height="30" HorizontalAlignment="Center" Margin="0,0,0,12" />

                                            <TextBlock Text="No past transfers" FontSize="14" FontWeight="Medium" Foreground="#8C8C8C" HorizontalAlignment="Center" />

                                            <TextBlock Text="Transfers you send and receive will appear here grouped by day." FontSize="11" Foreground="#555555" HorizontalAlignment="Center" Margin="0,4,0,0" />

                                        </StackPanel>

                                    </Border>

                                </StackPanel>

                            </Border>

                        </Grid>



                        <!-- ══ VIEW 6: SETTINGS ════════════════════════════════ -->

                        <Grid x:Name="ViewSettings" Visibility="Collapsed">

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto" />

                                <RowDefinition Height="*" />

                            </Grid.RowDefinitions>



                            <TextBlock Grid.Row="0" Text="Settings" FontSize="22" FontWeight="Bold" Foreground="#F5F5F5" Margin="4,4,0,14" />



                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                                <StackPanel Margin="0,0,8,0">

                                    <!-- SECTION 1: DEVICE -->

                                    <Border Background="#09FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,14">

                                        <StackPanel>

                                            <TextBlock Text="Device" FontSize="14" FontWeight="SemiBold" Foreground="#F5F5F5" Margin="0,0,0,14" />



                                            <!-- Device Name -->

                                            <Grid Margin="0,0,0,14">

                                                <StackPanel VerticalAlignment="Center">

                                                    <TextBlock Text="Device name" FontSize="13" Foreground="#F5F5F5" FontWeight="Medium" />

                                                    <TextBlock Text="Visible to nearby devices on your local network" FontSize="11" Foreground="#8C8C8C" Margin="0,2,0,0" />

                                                </StackPanel>

                                                <TextBox x:Name="TxtSettingsDeviceName" Width="200" Background="#14FFFFFF" Foreground="#F5F5F5" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="10,6" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" LostFocus="TxtSettingsDeviceName_LostFocus" />

                                            </Grid>

                                            <Border Height="1" Background="#0FFFFFFF" Margin="0,0,0,14" />



                                            <!-- Default Download Folder (Save to) -->

                                            <Grid Margin="0,0,0,4">

                                                <StackPanel VerticalAlignment="Center">

                                                    <TextBlock Text="Save to" FontSize="13" Foreground="#F5F5F5" FontWeight="Medium" />

                                                    <TextBlock x:Name="TxtSettingsReceiveFolder" Text="Downloads\KnowToMigrate" FontSize="11" Foreground="#8C8C8C" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="360" />

                                                    <TextBlock x:Name="TxtDownloadDir" Visibility="Collapsed" />

                                                </StackPanel>

                                                <Button Content="Change" Click="ChangeDownloadFolder_Click" Style="{StaticResource KmGlassButton}" MinHeight="32" Padding="14,2" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                            </Grid>

                                        </StackPanel>

                                    </Border>



                                    <!-- SECTION 2: RECEIVING -->

                                    <Border Background="#09FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,14">

                                        <StackPanel>

                                            <TextBlock Text="Receiving" FontSize="14" FontWeight="SemiBold" Foreground="#F5F5F5" Margin="0,0,0,14" />



                                            <!-- Auto-accept Trusted -->

                                            <Grid Margin="0,0,0,14">

                                                <StackPanel VerticalAlignment="Center">

                                                    <TextBlock Text="Auto-accept trusted devices" FontSize="13" Foreground="#F5F5F5" FontWeight="Medium" />

                                                    <TextBlock Text="Still asks for PIN confirmation" FontSize="11" Foreground="#8C8C8C" Margin="0,2,0,0" />

                                                </StackPanel>

                                                <CheckBox x:Name="ChkAutoAcceptTrusted" Style="{StaticResource KmToggleSwitch}" Checked="ChkAutoAcceptTrusted_Changed" Unchecked="ChkAutoAcceptTrusted_Changed" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                            </Grid>

                                            <Border Height="1" Background="#0FFFFFFF" Margin="0,0,0,14" />



                                            <!-- Keep Both Files on Duplicate -->

                                            <Grid Margin="0,0,0,14">

                                                <StackPanel VerticalAlignment="Center">

                                                    <TextBlock Text="Keep both files on duplicate" FontSize="13" Foreground="#F5F5F5" FontWeight="Medium" />

                                                    <TextBlock Text="Otherwise replace the existing file" FontSize="11" Foreground="#8C8C8C" Margin="0,2,0,0" />

                                                </StackPanel>

                                                <CheckBox x:Name="ChkSmartDuplicates" Style="{StaticResource KmToggleSwitch}" Checked="ChkSmartDuplicates_Changed" Unchecked="ChkSmartDuplicates_Changed" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                            </Grid>

                                            <Border Height="1" Background="#0FFFFFFF" Margin="0,0,0,14" />



                                            <!-- Require PIN -->

                                            <Grid Margin="0,0,0,4">

                                                <StackPanel VerticalAlignment="Center">

                                                    <TextBlock Text="Require PIN" FontSize="13" Foreground="#F5F5F5" FontWeight="Medium" />

                                                    <TextBlock Text="Ask for pairing PIN on every transfer" FontSize="11" Foreground="#8C8C8C" Margin="0,2,0,0" />

                                                </StackPanel>

                                                <CheckBox x:Name="ChkRequirePin" Style="{StaticResource KmToggleSwitch}" Checked="ChkRequirePin_Changed" Unchecked="ChkRequirePin_Changed" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                            </Grid>

                                        </StackPanel>

                                    </Border>



                                    <!-- SECTION 3: NETWORK -->

                                    <Border Background="#09FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,14">

                                        <StackPanel>

                                            <TextBlock Text="Network" FontSize="14" FontWeight="SemiBold" Foreground="#F5F5F5" Margin="0,0,0,10" />



                                            <Expander Header="Advanced network settings" Foreground="#8C8C8C" FontSize="12" Background="Transparent" BorderThickness="0">

                                                <Border Background="#06FFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,8,0,0">

                                                    <StackPanel>

                                                        <Grid Margin="0,0,0,8">

                                                            <TextBlock Text="Local IP address" FontSize="12" Foreground="#8C8C8C" />

                                                            <TextBlock x:Name="TxtSettingsLocalIp" Text="192.168.1.100" FontSize="12" Foreground="#F5F5F5" HorizontalAlignment="Right" />

                                                        </Grid>

                                                        <Grid Margin="0,0,0,8">

                                                            <TextBlock Text="Transfer port" FontSize="12" Foreground="#8C8C8C" />

                                                            <TextBlock Text="54124" FontSize="12" Foreground="#F5F5F5" HorizontalAlignment="Right" />

                                                        </Grid>

                                                        <Grid>

                                                            <TextBlock Text="Discovery port" FontSize="12" Foreground="#8C8C8C" />

                                                            <TextBlock Text="54123" FontSize="12" Foreground="#F5F5F5" HorizontalAlignment="Right" />

                                                        </Grid>

                                                    </StackPanel>

                                                </Border>

                                            </Expander>

                                        </StackPanel>

                                    </Border>



                                    <!-- SECTION 4: ABOUT -->

                                    <Border Background="#09FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,14">

                                        <StackPanel>

                                            <TextBlock Text="About" FontSize="14" FontWeight="SemiBold" Foreground="#F5F5F5" Margin="0,0,0,14" />



                                            <!-- App Version & Release Date -->

                                            <Grid Margin="0,0,0,14">

                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                                    <Image Source="pack://application:,,,/KnowToMigrate;component/Assets/logo.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0" VerticalAlignment="Center" />

                                                    <StackPanel VerticalAlignment="Center">

                                                        <TextBlock Text="KnowToMigrate" FontSize="14" FontWeight="Bold" Foreground="#F5F5F5" />

                                                        <TextBlock x:Name="TxtAboutVersion" Text="v1.0.0 (Production Release)" FontSize="11" Foreground="#8C8C8C" Margin="0,2,0,0" />

                                                    </StackPanel>

                                                </StackPanel>

                                                <Border Background="#14FF5A00" BorderBrush="#33FF5A00" BorderThickness="1" CornerRadius="8" Padding="10,4" HorizontalAlignment="Right" VerticalAlignment="Center">

                                                    <TextBlock Text="{StaticResource StringReleaseDate}" FontSize="11" FontWeight="SemiBold" Foreground="#FF8A00" />

                                                </Border>

                                            </Grid>

                                            <Border Height="1" Background="#0FFFFFFF" Margin="0,0,0,14" />



                                            <!-- Honest Security Status -->

                                            <Border Background="#14F59E0B" BorderBrush="#33F59E0B" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,14">

                                                <Grid>

                                                    <Grid.ColumnDefinitions>

                                                        <ColumnDefinition Width="Auto" />

                                                        <ColumnDefinition Width="*" />

                                                    </Grid.ColumnDefinitions>

                                                    <Path Grid.Column="0" Data="M12 2L1 21h22L12 2zm0 3.5L20.3 19H3.7L12 5.5zM11 10v4h2v-4h-2zm0 6v2h2v-2h-2z" Fill="#F59E0B" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,10,0" />

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                                        <TextBlock Text="{StaticResource StringSecurityLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#F5F5F5" />

                                                        <TextBlock Text="{StaticResource StringSecuritySubtext}" FontSize="11" Foreground="#8C8C8C" Margin="0,1,0,0" />

                                                    </StackPanel>

                                                </Grid>

                                            </Border>



                                            <!-- Website -->

                                            <Grid Margin="0,0,0,4">

                                                <StackPanel VerticalAlignment="Center">

                                                    <TextBlock Text="Official website" FontSize="13" Foreground="#F5F5F5" FontWeight="Medium" />

                                                    <TextBlock Text="Documentation, guides, and downloads" FontSize="11" Foreground="#8C8C8C" Margin="0,2,0,0" />

                                                </StackPanel>

                                                <Button Content="knowtomigrate.com" Click="BtnOpenWebsite_Click" Style="{StaticResource KmGlassButton}" MinHeight="32" Padding="14,2" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                            </Grid>

                                        </StackPanel>

                                    </Border>

                                </StackPanel>

                            </ScrollViewer>

                        </Grid>



                        <!-- Notification Banner --><!-- Notification Banner -->

                        <Border x:Name="PanelNotificationBanner" Background="#140900" BorderBrush="#FF5A00" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,14" Visibility="Collapsed" VerticalAlignment="Top">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="Auto" />

                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">

                                    <TextBlock x:Name="TxtNotificationTitle" FontWeight="Bold" FontSize="13" Foreground="#FF8A00" />

                                    <TextBlock x:Name="TxtNotificationBody" FontSize="12" Foreground="#8C8C8C" Margin="0,2,0,0" />

                                </StackPanel>

                                <Button Grid.Column="1" Content="✕" Click="DismissNotification_Click" Style="{StaticResource KmGlassButton}" MinHeight="26" Width="26" Padding="0" VerticalAlignment="Center" />

                            </Grid>

                        </Border>



                        <!-- Modals Container (Kept for compatibility) -->

                        <Grid x:Name="ModalIncomingTransfer" Visibility="Collapsed" />

                        <Grid x:Name="ModalReceiveCompletion" Visibility="Collapsed" />



                    </Grid>

                </ScrollViewer>

            </Grid>

        </Grid>

    </Border>

</Window>

