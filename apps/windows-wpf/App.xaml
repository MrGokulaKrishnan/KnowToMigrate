<Application x:Class="KnowToMigrate.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- ── Standardized Strings & Honest Security Constants ──────────── -->
        <sys:String x:Key="StringAppName">KnowToMigrate</sys:String>
        <sys:String x:Key="StringAppTagline">Move Anything. Anywhere. Seamlessly.</sys:String>
        <sys:String x:Key="StringReleaseDate">25 October 2026</sys:String>
        <sys:String x:Key="StringSecurityLabel">Not encrypted yet</sys:String>
        <sys:String x:Key="StringSecurityCaption">Use on trusted networks only.</sys:String>
        <sys:String x:Key="StringSecuritySubtext">Use on trusted networks only.</sys:String>
        <sys:Boolean x:Key="BoolIsEncrypted">False</sys:Boolean>

        <!-- Navigation String Resources -->
        <sys:String x:Key="StringNavHome">Home</sys:String>
        <sys:String x:Key="StringNavSend">Send</sys:String>
        <sys:String x:Key="StringNavReceive">Receive</sys:String>
        <sys:String x:Key="StringNavMoveDevice">Move device</sys:String>
        <sys:String x:Key="StringNavHistory">History</sys:String>
        <sys:String x:Key="StringNavSettings">Settings</sys:String>
        <sys:String x:Key="StringSectionNearby">Nearby</sys:String>
        <sys:String x:Key="StringNearbyDevices">Nearby devices</sys:String>
        <sys:String x:Key="StringSectionRecent">Recent</sys:String>

        <!-- ── Dark AMOLED Liquid Glass Palette ───────────────────────────── -->
        <SolidColorBrush x:Key="DarkBg" Color="#000000" />
        <SolidColorBrush x:Key="CardBg" Color="#0C0C0C" />
        <SolidColorBrush x:Key="ElevatedBg" Color="#121212" />
        <SolidColorBrush x:Key="BorderBrush" Color="#1C1C1C" />
        <SolidColorBrush x:Key="KmOrange" Color="#FF5A00" />
        <SolidColorBrush x:Key="KmOrangeDark" Color="#FF4D00" />
        <SolidColorBrush x:Key="KmOrangeLight" Color="#FF8A00" />
        <SolidColorBrush x:Key="KmOrangeGlow" Color="#FF8A00" />

        <!-- High-Contrast Text Tokens (WCAG AA Compliant) -->
        <SolidColorBrush x:Key="TextPrimary" Color="#F5F5F5" />
        <SolidColorBrush x:Key="TextSecondary" Color="#8C8C8C" />
        <SolidColorBrush x:Key="TextMuted" Color="#555555" />
        <!-- Near-black text on brand orange gradient: 6.7:1 contrast ratio -->
        <SolidColorBrush x:Key="TextOnBrand" Color="#0A0A0A" />
        <SolidColorBrush x:Key="BrushTextOnBrand" Color="#0A0A0A" />

        <!-- Status & Accent Colors -->
        <SolidColorBrush x:Key="BrushSuccess" Color="#22C55E" />
        <SolidColorBrush x:Key="BrushOnline" Color="#22C55E" />
        <SolidColorBrush x:Key="BrushWarning" Color="#F59E0B" />
        <SolidColorBrush x:Key="BrushError" Color="#EF4444" />
        <SolidColorBrush x:Key="BrushTagGreen" Color="#4ADE80" />
        <SolidColorBrush x:Key="BrushTagGreenBg" Color="#264ADE80" />

        <!-- Glass Tokens -->
        <SolidColorBrush x:Key="BrushGlass" Color="#09FFFFFF" />
        <SolidColorBrush x:Key="BrushGlassPane" Color="#0AFFFFFF" />
        <SolidColorBrush x:Key="BrushEdge" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="BrushTextPrimary" Color="#F5F5F5" />
        <SolidColorBrush x:Key="BrushTextMuted" Color="#8C8C8C" />

        <!-- ── Brand Gradients ────────────────────────────────────────────── -->
        <LinearGradientBrush x:Key="KmBrandGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF4D00" Offset="0"/>
            <GradientStop Color="#FF5A00" Offset="0.5"/>
            <GradientStop Color="#FF8A00" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="KmBrandGradientHover" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF6014" Offset="0"/>
            <GradientStop Color="#FF7A1A" Offset="0.5"/>
            <GradientStop Color="#FFA040" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="KmBrandGradientPressed" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#CC3700" Offset="0"/>
            <GradientStop Color="#E04D00" Offset="0.5"/>
            <GradientStop Color="#FF6A00" Offset="1"/>
        </LinearGradientBrush>

        <!-- Glossy Sheen Overlay Brush -->
        <LinearGradientBrush x:Key="GlossySheenBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#30FFFFFF" Offset="0"/>
            <GradientStop Color="#00FFFFFF" Offset="0.6"/>
        </LinearGradientBrush>

        <!-- ── Geometries (Clean Vector Icons) ────────────────────────────── -->
        <Geometry x:Key="KmIconHome">M 3,9 L 12,2 L 21,9 V 20 A 2,2 0 0 1 19,22 H 5 A 2,2 0 0 1 3,20 Z M 9,22 V 12 H 15 V 22</Geometry>
        <Geometry x:Key="KmIconSend">M 22,2 L 11,13 M 22,2 L 15,22 L 11,13 L 2,9 Z</Geometry>
        <Geometry x:Key="KmIconReceive">M 21,15 V 19 A 2,2 0 0 1 19,21 H 5 A 2,2 0 0 1 3,19 V 15 M 7,10 L 12,15 L 17,10 M 12,15 V 3</Geometry>
        <Geometry x:Key="KmIconMigrate">M 8,3 L 4,7 L 8,11 M 4,7 H 20 M 16,21 L 20,17 L 16,13 M 20,17 H 4</Geometry>
        <Geometry x:Key="KmIconHistory">M 3,12 A 9,9 0 1 0 6,5.3 M 3,4 L 3,9 L 8,9 M 12,7 L 12,12 L 15,14</Geometry>
        <Geometry x:Key="KmIconSettings">M 12.22,2 h -0.44 a 2,2 0 0 0 -2,2 v 0.18 a 2,2 0 0 1 -1,1.73 l -0.43,0.25 a 2,2 0 0 1 -2,0 l -0.15,-0.08 a 2,2 0 0 0 -2.73,0.73 l -0.22,0.38 a 2,2 0 0 0 0.73,2.73 l 0.15,0.1 a 2,2 0 0 1 1,1.72 v 0.51 a 2,2 0 0 1 -1,1.74 l -0.15,0.09 a 2,2 0 0 0 -0.73,2.73 l 0.22,0.38 a 2,2 0 0 0 2.73,0.73 l 0.15,-0.08 a 2,2 0 0 1 2,0 l 0.43,0.25 a 2,2 0 0 1 1,1.73 V 20 a 2,2 0 0 0 2,2 h 0.44 a 2,2 0 0 0 2,-2 v -0.18 a 2,2 0 0 1 1,-1.73 l 0.43,-0.25 a 2,2 0 0 1 2,0 l 0.15,0.08 a 2,2 0 0 0 2.73,-0.73 l 0.22,-0.39 a 2,2 0 0 0 -0.73,-2.73 l -0.15,-0.08 a 2,2 0 0 1 -1,-1.74 v -0.5 a 2,2 0 0 1 1,-1.74 l 0.15,-0.09 a 2,2 0 0 0 0.73,-2.73 l -0.22,-0.38 a 2,2 0 0 0 -2.73,-0.73 l -0.15,0.08 a 2,2 0 0 1 -2,0 l -0.43,-0.25 a 2,2 0 0 1 -1,-1.73 V 4 a 2,2 0 0 0 -2,-2 Z M 12,15 a 3,3 0 1 1 0,-6 3,3 0 0 1 0,6 Z</Geometry>
        <Geometry x:Key="KmIconFile">M 14,2 L 6,2 A 2,2 0 0 0 4,4 L 4,20 A 2,2 0 0 0 6,22 L 18,22 A 2,2 0 0 0 20,20 L 20,8 Z M 14,2 L 14,8 L 20,8</Geometry>
        <Geometry x:Key="KmIconDevice">M 3,6 A 2,2 0 0 1 5,4 L 19,4 A 2,2 0 0 1 21,6 L 21,14 A 2,2 0 0 1 19,16 L 5,16 A 2,2 0 0 1 3,14 Z M 9,20 L 15,20 M 12,16 L 12,20</Geometry>
        <Geometry x:Key="KmIconCheck">M 5,12 L 10,17 L 19,7</Geometry>
        <Geometry x:Key="KmCheckIconGeometry">M 4.5,12 L 9.5,17 L 19.5,7</Geometry>
        <Geometry x:Key="KmIconWarning">M 12,2 L 1,21 L 23,21 Z M 12,9 L 12,14 M 12,17 L 12,18.5</Geometry>

        <!-- ── Reusable Component Styles ──────────────────────────────────── -->

        <!-- Primary Glossy Gradient Button Style (#0A0A0A Text for 6.7:1 WCAG AA Contrast) -->
        <Style x:Key="KmPrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#0A0A0A" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="TextBlock.TextAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="OuterBorder"
                                    Background="{StaticResource KmBrandGradient}"
                                    BorderBrush="#FFA366"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FF5A00" BlurRadius="14" ShadowDepth="0" Opacity="0.35"/>
                                </Border.Effect>
                                <Grid>
                                    <!-- Glossy Sheen Overlay -->
                                    <Border CornerRadius="11,11,0,0"
                                            VerticalAlignment="Top"
                                            Height="18"
                                            Background="{StaticResource GlossySheenBrush}" />
                                    <!-- Button Content -->
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterBorder" Property="Background" Value="{StaticResource KmBrandGradientHover}" />
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#FFCC99" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="OuterBorder" Property="Background" Value="{StaticResource KmBrandGradientPressed}" />
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#E05500" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="OuterBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Glass Outlined Button Style (12px Radius, DPI-Safe MinHeight) -->
        <Style x:Key="KmGlassButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F5F5F5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="TextBlock.TextAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="GlassBorder"
                                Background="#121212"
                                BorderBrush="#262626"
                                BorderThickness="1"
                                CornerRadius="12">
                            <Grid>
                                <Border CornerRadius="11,11,0,0"
                                        VerticalAlignment="Top"
                                        Height="18"
                                        Background="{StaticResource GlossySheenBrush}"
                                        Opacity="0.4" />
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GlassBorder" Property="Background" Value="#1C1C1C" />
                                <Setter TargetName="GlassBorder" Property="BorderBrush" Value="#FF5A00" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="GlassBorder" Property="Background" Value="#0A0A0A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="GlassBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rail Navigation Button Style (14px Radius) -->
        <Style x:Key="KmRailButton" TargetType="Button">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#8C8C8C" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RailBorder" CornerRadius="14" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RailBorder" Property="Background" Value="#14FFFFFF" />
                                <Setter Property="Foreground" Value="#F5F5F5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows 11 TitleBar Window Control Buttons -->
        <Style x:Key="KmTitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#AAAAAA" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#1F1F1F" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#2B2B2B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KmTitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource KmTitleBarButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#C40F1D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Liquid Glass CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DDDDDD" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="CheckBorder"
                                    Grid.Column="0"
                                    Width="20"
                                    Height="20"
                                    CornerRadius="5.5"
                                    Background="#0A0A0A"
                                    BorderBrush="#2A2A2A"
                                    BorderThickness="1.5"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Border x:Name="CheckGloss"
                                            CornerRadius="4,4,0,0"
                                            Height="9"
                                            VerticalAlignment="Top"
                                            Background="{StaticResource GlossySheenBrush}"
                                            Opacity="0" />

                                    <Path x:Name="CheckMark"
                                          Data="M 3.8,10.2 L 7.8,14.2 L 15.6,5.6"
                                          Stroke="#0A0A0A"
                                          StrokeThickness="2.2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Opacity="0"
                                          SnapsToDevicePixels="True" />
                                </Grid>
                            </Border>

                            <ContentPresenter Grid.Column="1"
                                              Margin="10,0,0,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#FF5A00" />
                                <Setter TargetName="CheckBorder" Property="Background" Value="#141414" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource KmBrandGradient}" />
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#FFA366" />
                                <Setter TargetName="CheckMark" Property="Opacity" Value="1" />
                                <Setter TargetName="CheckGloss" Property="Opacity" Value="0.45" />
                                <Setter TargetName="CheckBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FF5A00" BlurRadius="10" ShadowDepth="0" Opacity="0.45" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Prototype Toggle Switch Style (44x24 smooth pill with white knob) -->
        <Style x:Key="KmToggleSwitch" TargetType="CheckBox">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="TogTrack" Width="44" Height="24" CornerRadius="12" Background="#1FFFFFFF" SnapsToDevicePixels="True">
                            <Grid>
                                <Ellipse x:Name="TogKnob" Width="18" Height="18" Fill="#EEEEEE" HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Opacity="0.3" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TogTrack" Property="Background" Value="{StaticResource KmBrandGradient}" />
                                <Setter TargetName="TogKnob" Property="Margin" Value="23,0,0,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Liquid Glass Glowing Gradient ProgressBar Style -->
        <Style x:Key="KmGradientProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="10" />
            <Setter Property="Background" Value="#141414" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid SnapsToDevicePixels="True">
                            <Border CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="#242424" BorderThickness="1" />
                            <Border x:Name="PART_Track" CornerRadius="5" ClipToBounds="True">
                                <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left">
                                    <Grid>
                                        <Border CornerRadius="5" Background="{StaticResource KmBrandGradient}">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#FF5A00" BlurRadius="12" ShadowDepth="0" Opacity="0.5"/>
                                            </Border.Effect>
                                        </Border>
                                        <Border CornerRadius="4,4,0,0" Height="5" VerticalAlignment="Top" Background="{StaticResource GlossySheenBrush}" Opacity="0.45"/>
                                    </Grid>
                                </Decorator>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Toggle Button Template (Dark Glass Pill with Subtle Chevron) -->
        <ControlTemplate x:Key="KmComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="BtnBorder"
                    Background="#121212"
                    BorderBrush="#262626"
                    BorderThickness="1"
                    CornerRadius="12"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="38" />
                    </Grid.ColumnDefinitions>
                    <!-- Glossy sheen on upper half -->
                    <Border Grid.ColumnSpan="2"
                            CornerRadius="11,11,0,0"
                            VerticalAlignment="Top"
                            Height="18"
                            Background="{StaticResource GlossySheenBrush}"
                            Opacity="0.3"
                            IsHitTestVisible="False" />
                    <!-- Chevron Arrow -->
                    <Path x:Name="Arrow"
                          Grid.Column="1"
                          Data="M 0,0 L 4.5,4.5 L 9,0"
                          Stroke="#8C8C8C"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform Angle="0" />
                        </Path.RenderTransform>
                    </Path>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BtnBorder" Property="Background" Value="#181818" />
                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#40FFFFFF" />
                    <Setter TargetName="Arrow" Property="Stroke" Value="#F5F5F5" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#FF5A00" />
                    <Setter TargetName="Arrow" Property="Stroke" Value="#FF5A00" />
                    <Setter TargetName="Arrow" Property="RenderTransform">
                        <Setter.Value>
                            <RotateTransform Angle="180" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="BtnBorder" Property="Opacity" Value="0.4" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ComboBox Item Style (Website Dark Card Item with Selection Highlight) -->
        <Style x:Key="KmComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                Margin="4,2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1AFFFFFF" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#22FF5A00" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#55FF5A00" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="#33FF5A00" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FF5A00" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Liquid Glass ComboBox Style matching Website Theme -->
        <Style x:Key="KmComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F5F5F5" />
            <Setter Property="Background" Value="#121212" />
            <Setter Property="BorderBrush" Value="#262626" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource KmComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource KmComboBoxToggleButtonTemplate}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" />

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,0,38,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch" />

                            <TextBlock x:Name="Placeholder"
                                       Text="Select target device..."
                                       Foreground="#8C8C8C"
                                       FontSize="13"
                                       FontWeight="Normal"
                                       IsHitTestVisible="False"
                                       Margin="14,0,38,0"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Visibility="Collapsed" />

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide"
                                   VerticalOffset="4">
                                <Grid x:Name="DropDown"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                      SnapsToDevicePixels="True">
                                    <Border x:Name="DropDownBorder"
                                            Background="#111111"
                                            BorderBrush="#2C2C2C"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="6" Opacity="0.75" />
                                        </Border.Effect>
                                        <Grid>
                                            <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                            </ScrollViewer>
                                            <TextBlock x:Name="NoDevicesHint"
                                                       Text="Looking for nearby devices..."
                                                       Foreground="#8C8C8C"
                                                       FontSize="12"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Margin="12"
                                                       Visibility="Collapsed" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="NoDevicesHint" Property="Visibility" Value="Visible" />
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="56" />
                            </Trigger>
                            <Trigger Property="SelectedIndex" Value="-1">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="SelectedItem" Value="{x:Null}">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
