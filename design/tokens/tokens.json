{
  "brand": {
    "name": "KnowToMigrate",
    "tagline": "Move Anything. Anywhere. Seamlessly.",
    "version": "1.0.0"
  },
  "colors": {
    "background": {
      "primary": "#000000",
      "secondary": "#050505",
      "tertiary": "#080808",
      "card": "#0C0C0C",
      "elevated": "#111111"
    },
    "brand": {
      "primary": "#FF5A00",
      "gradient": ["#FF4D00", "#FF5A00", "#FF6A00", "#FF8A00", "#FFB066"]
    },
    "text": {
      "primary": "#FFFFFF",
      "secondary": "#D4D4D4",
      "muted": "#8A8A8A",
      "disabled": "#555555"
    },
    "status": {
      "success": "#22C55E",
      "warning": "#F59E0B",
      "error": "#EF4444",
      "info": "#38BDF8"
    },
    "glass": {
      "background": "rgba(255,255,255,0.04)",
      "border": "rgba(255,255,255,0.08)",
      "highlight": "rgba(255,255,255,0.12)",
      "orangeGlow": "rgba(255,90,0,0.15)",
      "orangeGlowStrong": "rgba(255,90,0,0.25)"
    }
  },
  "typography": {
    "fontFamily": {
      "primary": "'Inter', 'SF Pro Display', 'Segoe UI Variable', system-ui, sans-serif",
      "mono": "'JetBrains Mono', 'Cascadia Code', monospace"
    },
    "scale": {
      "xs": "11px",
      "sm": "13px",
      "base": "15px",
      "md": "17px",
      "lg": "20px",
      "xl": "24px",
      "2xl": "30px",
      "3xl": "36px",
      "4xl": "48px",
      "hero": "64px"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800
    },
    "lineHeight": {
      "tight": 1.2,
      "snug": 1.35,
      "normal": 1.5,
      "relaxed": 1.65
    }
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px"
  },
  "radius": {
    "sm": "8px",
    "md": "12px",
    "lg": "18px",
    "xl": "24px",
    "2xl": "32px",
    "full": "9999px"
  },
  "shadows": {
    "sm": "0 2px 8px rgba(0,0,0,0.4)",
    "md": "0 4px 16px rgba(0,0,0,0.5)",
    "lg": "0 8px 32px rgba(0,0,0,0.6)",
    "xl": "0 16px 48px rgba(0,0,0,0.7)",
    "orangeGlow": "0 0 24px rgba(255,90,0,0.3), 0 0 48px rgba(255,90,0,0.15)",
    "orangeGlowLg": "0 0 48px rgba(255,90,0,0.4), 0 0 96px rgba(255,90,0,0.2)",
    "gloss": "inset 0 1px 0 rgba(255,255,255,0.12)"
  },
  "gradients": {
    "brand": "linear-gradient(135deg, #FF4D00 0%, #FF5A00 30%, #FF6A00 60%, #FF8A00 100%)",
    "brandSubtle": "linear-gradient(135deg, #FF4D0022 0%, #FF8A0022 100%)",
    "surface": "linear-gradient(180deg, #111111 0%, #080808 100%)",
    "card": "linear-gradient(145deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0.02) 100%)",
    "gloss": "linear-gradient(180deg, rgba(255,255,255,0.12) 0%, rgba(255,255,255,0.0) 50%)",
    "successGlow": "linear-gradient(135deg, #22C55E22 0%, #22C55E11 100%)"
  },
  "glass": {
    "blur": "16px",
    "blurHeavy": "32px",
    "saturation": "1.2",
    "surface": {
      "background": "rgba(255,255,255,0.04)",
      "border": "1px solid rgba(255,255,255,0.08)",
      "shadow": "0 8px 32px rgba(0,0,0,0.5)"
    },
    "card": {
      "background": "rgba(255,255,255,0.05)",
      "border": "1px solid rgba(255,255,255,0.10)",
      "shadow": "0 4px 16px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.08)"
    }
  },
  "animation": {
    "duration": {
      "instant": "80ms",
      "fast": "150ms",
      "normal": "250ms",
      "slow": "400ms",
      "slower": "600ms",
      "discovery": "2000ms",
      "pulse": "1500ms"
    },
    "easing": {
      "default": "cubic-bezier(0.4, 0, 0.2, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "smooth": "cubic-bezier(0.25, 0.46, 0.45, 0.94)",
      "decelerate": "cubic-bezier(0.0, 0.0, 0.2, 1)"
    }
  },
  "icons": {
    "family": "Lucide",
    "strokeWidth": 1.75,
    "sizes": {
      "xs": 14,
      "sm": 16,
      "md": 20,
      "lg": 24,
      "xl": 32,
      "2xl": 48
    }
  },
  "components": {
    "button": {
      "primary": {
        "background": "linear-gradient(135deg, #FF4D00, #FF8A00)",
        "borderRadius": "12px",
        "height": "48px",
        "paddingX": "24px",
        "fontWeight": 600,
        "fontSize": "15px",
        "gloss": "inset 0 1px 0 rgba(255,255,255,0.25), inset 0 -1px 0 rgba(0,0,0,0.2)",
        "shadow": "0 4px 16px rgba(255,90,0,0.35)"
      },
      "secondary": {
        "background": "rgba(255,255,255,0.06)",
        "border": "1px solid rgba(255,255,255,0.12)",
        "borderRadius": "12px",
        "height": "48px"
      },
      "danger": {
        "background": "rgba(239,68,68,0.15)",
        "border": "1px solid rgba(239,68,68,0.3)"
      }
    },
    "card": {
      "background": "rgba(255,255,255,0.04)",
      "border": "1px solid rgba(255,255,255,0.08)",
      "borderRadius": "18px",
      "padding": "20px",
      "backdropFilter": "blur(16px)",
      "shadow": "0 4px 16px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.06)"
    },
    "deviceCard": {
      "borderRadius": "18px",
      "activeBorder": "1px solid rgba(255,90,0,0.4)",
      "activeGlow": "0 0 24px rgba(255,90,0,0.25)"
    },
    "progressBar": {
      "height": "6px",
      "borderRadius": "9999px",
      "background": "rgba(255,255,255,0.08)",
      "fill": "linear-gradient(90deg, #FF4D00, #FF8A00)",
      "glow": "0 0 12px rgba(255,90,0,0.5)"
    },
    "input": {
      "background": "rgba(255,255,255,0.05)",
      "border": "1px solid rgba(255,255,255,0.10)",
      "borderRadius": "12px",
      "height": "48px",
      "focusBorder": "1px solid rgba(255,90,0,0.5)",
      "focusGlow": "0 0 0 3px rgba(255,90,0,0.15)"
    },
    "badge": {
      "borderRadius": "9999px",
      "paddingX": "10px",
      "paddingY": "3px",
      "fontSize": "12px",
      "fontWeight": 600
    }
  },
  "accessibility": {
    "minContrastRatio": 4.5,
    "focusRingWidth": "3px",
    "focusRingColor": "rgba(255,90,0,0.6)",
    "minTapTarget": "44px",
    "reduceMotion": "@media (prefers-reduced-motion: reduce)"
  }
}
